{% extends 'base.html.twig' %}

{% block body %}

<section class="section">
    <h2 class="section-title">{{ 'security_reset_password.html.nouveau_mot_de_passe'|trans }}</h2>

    <div class="cards cards-single">
        <div class="card card-form">

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">
                <label class="visually-hidden" for="reset_password_new">{{ 'security_reset_password.html.nouveau_mot_de_passe'|trans }}</label>
                <input id="reset_password_new" type="password" name="password" placeholder="{{ 'security_reset_password.html.nouveau_mot_de_passe'|trans }}" autocomplete="new-password" required>
                <label class="visually-hidden" for="reset_password_confirm">{{ 'security_reset_password.html.confirm_new_password'|trans }}</label>
                <input id="reset_password_confirm" type="password" name="confirm_password" placeholder="{{ 'security_reset_password.html.confirm_new_password'|trans }}" autocomplete="new-password" required>

                <button class="btn-ul">{{ 'security_reset_password.html.submit'|trans }}</button>
            </form>

        </div>
    </div>
</section>

{% endblock %}
