{% extends 'base.html.twig' %}

{% block body %}

<section class="auth-hero">
    <h1 class="hero-title">{{ 'components_navbar.html.connexion'|trans }}</h1>
</section>
<section class="section">
    <div class="container content-shell-sm">
        <div class="cards cards-single">
            <div class="card card-form">
                <h2 class="section-title">{{ 'components_navbar.html.connexion'|trans }}</h2>

                {% if error %}
                    <div class="alert-error">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="auth-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <label for="login-email">{{ 'security_login.html.email'|trans }}</label>
                    <input id="login-email" type="email" name="_username" value="{{ last_username }}" autocomplete="email" required>

                    <label for="login-password">{{ 'security_login.html.mot_de_passe'|trans }}</label>
                    <input id="login-password" type="password" name="_password" autocomplete="current-password" required>

                    <button class="btn-ul" type="submit">{{ 'components_navbar.html.connexion'|trans }}</button>
                </form>

                <a href="{{ path('forgot_password') }}" class="link-small">{{ 'security_login.html.mot_de_passe_oublie'|trans }}</a>
            </div>
        </div>
    </div>
</section>

{% endblock %}
