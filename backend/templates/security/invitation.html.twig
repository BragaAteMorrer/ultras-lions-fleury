{% extends 'base.html.twig' %}

{% block body %}

<section class="hero hero-small">
    <div class="hero-inner">
        <h1 class="hero-title">{{ 'security_invitation.html.rejoindre_les_ultras_lions'|trans }}</h1>
        <p class="hero-subtitle">{{ 'security_invitation.html.lors_de_votre_cartage_a_la_table_de_vente_un_code_vous_a_ete_remis_pou'|trans }}</p>
    </div>
</section>

<section class="section">

    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger">{{ msg }}</div>
    {% endfor %}

    <div class="cards cards-single">
        <div class="card card-form">

            <form method="POST">

                <div class="form-group">
                    <label class="hero-subtitle" for="inviteCode">{{ 'security_invitation.html.code_dinvitation'|trans }}</label>
                    <input type="text" id="inviteCode" name="inviteCode" class="form-control" required>
                </div>

                <button class="btn-ul mt-2">{{ 'security_invitation.html.valider'|trans }}</button>

            </form>

        </div>
    </div>
</section>

{% endblock %}
