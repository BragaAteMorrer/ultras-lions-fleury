{% extends 'base.html.twig' %}

{% block body %}

<section class="auth-hero">
    <h1 class="hero-title">{{ 'security_forgot_password.html.mot_de_passe_oublie'|trans }}</h1>
</section>

<section class="section">
    <div class="cards cards-single">
        <div class="card card-form">

            <p class="mb-3">{{ 'security_forgot_password.html.entrez_votre_adresse_email_et_nous_vous_enverrons_un_lien_pour_reiniti'|trans }}</p>

            <form method="post">
                <input type="email" name="email" placeholder="{{ 'security_forgot_password.html.votre_email'|trans }}" required>
                <button class="btn-ul mt-2">{{ 'security_forgot_password.html.envoyer_le_lien'|trans }}</button>
            </form>

            <a href="{{ path('app_login') }}" class="link-small mt-3">{{ 'security_forgot_password.html.retour_a_la_connexion'|trans }}</a>

        </div>
    </div>
</section>

{% endblock %}
