{% extends 'base.html.twig' %}

{% block title %}{{ 'posts_show.html.title'|trans({'%title%': post.title}) }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ post.title }}</h1>
        <p class="hero-subtitle">{{ 'posts_show.html.published_on'|trans({'%date%': post.createdAt|date('d/m/Y')}) }}</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <article class="post-show">

            {% if post.image %}
                <div class="post-main-image">
                    {% if post.image.video %}
                        {% include 'components/media.html.twig' with { media: post.image, alt: post.title, controls: true } %}
                    {% else %}
                        <a href="{{ asset('uploads/media/' ~ post.image.path) }}" data-lightbox="post-main">
                            {% include 'components/media.html.twig' with { media: post.image, alt: post.title } %}
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            {% if post.media is not empty %}
                <div class="cards mt-4">
                    {% for media in post.media %}
                        {% if media.video %}
                            <div class="card">
                                {% include 'components/media.html.twig' with { media: media, alt: media.alt ?: post.title, controls: true } %}
                            </div>
                        {% else %}
                            <a href="{{ asset('uploads/media/' ~ media.path) }}" class="card" data-lightbox="post-gallery">
                                {% include 'components/media.html.twig' with { media: media, alt: media.alt ?: post.title } %}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            <div class="post-body rich-content">
                {{ post.content|raw }}
            </div>

        </article>
    </div>
</div>
{% endblock %}
