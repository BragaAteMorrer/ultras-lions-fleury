{% set lead = lead|default(false) %}
{% set showExcerpt = showExcerpt|default(true) %}
{% set showCategory = showCategory|default(true) %}
{% set showDate = showDate|default(true) %}
{% set actionLabel = actionLabel|default('Lire l\'article') %}
{% set link = link|default(path('post_show', { slug: post.slug })) %}
{% set cover = cover|default(post.image ?: (post.media|first)) %}
{% set excerptSource = excerpt|default(post.content|default('')) %}
{% set excerptText = excerptSource ? excerptSource|striptags|replace({"\n": ' '})|trim : '' %}
{% set excerptLength = lead ? 180 : 110 %}

<article class="event-card-v2 news-front-card{% if lead %} news-front-card--lead{% endif %}">
    <a href="{{ link }}" class="event-card-link news-front-card-link">
        <div class="event-card-media news-front-card-media{% if cover and cover.isVideo %} news-front-card-media--video{% endif %}">
            {% if cover %}
                {% include 'components/media.html.twig' with {
                    media: cover,
                    class: 'event-card-image-v2 news-front-card-media-item',
                    alt: post.title,
                    loading: 'lazy',
                    controls: false,
                    preload: 'metadata'
                } %}
            {% else %}
                <div class="event-card-placeholder news-front-card-placeholder">
                    <span>Ultras Lions</span>
                </div>
            {% endif %}

            <div class="event-card-overlay news-front-card-overlay">
                {% if post.category %}
                    <span class="event-card-badge">{{ post.category.name }}</span>
                {% else %}
                    <span class="event-card-badge">Actualités</span>
                {% endif %}

                {% if showDate and post.createdAt %}
                    <span class="event-card-date-badge">
                        <strong>{{ post.createdAt|date('d') }}</strong>
                        <em>{{ post.createdAt|date('M')|upper }}</em>
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="event-card-body-v2 news-front-card-body">
            <div class="event-card-meta">
                {% if showCategory and post.category %}
                    <span class="event-card-meta-item">
                        <i class="bi bi-tag" aria-hidden="true"></i>
                        {{ post.category.name }}
                    </span>
                {% endif %}

                {% if showDate and post.createdAt %}
                    <span class="event-card-meta-item">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        {{ post.createdAt|date('d/m/Y') }}
                    </span>
                {% endif %}
            </div>

            <h3 class="event-card-title-v2 news-front-card-title">{{ post.title }}</h3>

            {% if showExcerpt and excerptText %}
                <p class="news-front-card-excerpt">
                    {{ excerptText|slice(0, excerptLength) }}{% if excerptText|length > excerptLength %}…{% endif %}
                </p>
            {% endif %}

            <span class="news-front-card-cta">{{ actionLabel }}</span>
        </div>
    </a>
</article>
