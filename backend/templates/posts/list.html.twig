{% extends 'base.html.twig' %}

{% block title %}{{ 'posts_list.html.actualites_ultras_lions'|trans }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ 'components_navbar.html.actualites'|trans }}</h1>
        <p class="hero-subtitle">{{ 'posts_list.html.infos_communiques_actions_en_tribune'|trans }}</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <h2 class="section-title">{{ 'posts_list.html.derniers_articles'|trans }}</h2>

        <div class="cards">
            {% for post in posts %}
                <a href="{{ path('post_show', { slug: post.slug }) }}" class="card">

                    {% if post.image %}
                        <img src="{{ asset('uploads/media/' ~ post.image.path) }}" alt="{{ post.title }}">
                    {% endif %}

                    <div class="card-content">
                        <h3>{{ post.title }}</h3>

                        <p class="card-meta">
                            {{ post.createdAt|date('d/m/Y') }}
                        </p>

                        <p>{{ post.content|striptags|slice(0, 140) ~ '…' }}</p>
                    </div>
                </a>
            {% else %}
                <p>{{ 'posts_list.html.aucune_actu_pour_linstant'|trans }}</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
