{% extends 'base.html.twig' %}

{% block body %}

<section class="section">
    <h2 class="section-title">{{ 'staff_index.html.staff_ultras_lions'|trans }}</h2>

    <div class="cards">
        {% for user in staff %}
            <a href="{{ path('profile_show', {id: user.id}) }}" class="card staff-card">

                {% if user.photoProfil %}
                    <img src="/uploads/profils/{{ user.photoProfil }}" alt="">
                {% else %}
                    <img src="{{ asset('img/logo/Logo CIrculaire - Final - Football Furies.png') }}" alt="">
                {% endif %}

                <div class="member-info">
                    <div class="member-name">{{ user.prenom }} {{ user.nom }}</div>
                    <div class="ul-badge">{{ 'staff_index.html.staff'|trans }}</div>
                </div>

            </a>
        {% endfor %}
    </div>
</section>

{% endblock %}
