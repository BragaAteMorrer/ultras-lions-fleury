{% extends 'base.html.twig' %}

{% block body %}

<section class="section">
    <h2 class="section-title">Staff Ultras Lions</h2>

    <div class="cards">
        {% for user in staff %}
            <a href="{{ path('profile_show', {id: user.id}) }}" class="card staff-card">

                {% if user.photoProfil %}
                    <img src="/uploads/profils/{{ user.photoProfil }}" alt="">
                {% else %}
                    <img src="/img/default-profile.png" alt="">
                {% endif %}

                <div class="member-info">
                    <div class="member-name">{{ user.pseudo }}</div>
                    <div class="ul-badge">STAFF</div>
                </div>

            </a>
        {% endfor %}
    </div>
</section>

{% endblock %}
