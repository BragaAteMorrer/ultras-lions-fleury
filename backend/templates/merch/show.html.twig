{% extends 'base.html.twig' %}

{% block title %}{{ 'merch_show.html.title'|trans({'%title%': item.title}) }}{% endblock %}

{% block body %}
{% set cover = item.image ?: (item.media|first) %}
{% set productHeroImage = cover and not cover.video ? asset('uploads/media/' ~ cover.path) : asset('img/fond/fond1a.jpg') %}

<section class="ticket-show-hero" style="background-image: linear-gradient(90deg, rgba(0,0,0,0.9), rgba(0,0,0,0.58), rgba(0,0,0,0.86)), url('{{ productHeroImage }}');">
    <div class="ticket-show-hero-inner">
        <p class="ticket-show-kicker">{{ 'components_navbar.html.table_de_vente'|trans }}</p>
        <h1 class="ticket-show-title">{{ item.title }}</h1>
        <div class="ticket-show-hero-meta">
            {% if item.category %}
                <span>{{ item.category.name }}</span>
            {% endif %}
            <span>{{ item.price|number_format(2, ',', ' ') }} €</span>
            <span>{% if item.stocks is empty %}Stock non defini{% else %}{{ 'merch_show.html.stock_total'|trans({'%stock%': item.totalStock}) }}{% endif %}</span>
        </div>
    </div>
</section>

<div class="section ticket-show-section">
    <div class="container" style="max-width: 76rem;">
        <div class="ticket-show-summary">
            <div class="ticket-show-poster">
                {% if cover %}
                    {% include 'components/media.html.twig' with { media: cover, alt: item.title, controls: cover.video } %}
                {% else %}
                    <img src="/placeholder.jpg" alt="{{ item.title }}">
                {% endif %}
            </div>

            <div class="ticket-show-panel">
                {% if item.category %}
                    <p class="ticket-show-eyebrow">{{ item.category.name }}</p>
                {% endif %}
                <h2>{{ item.title }}</h2>

                <div class="ticket-show-facts">
                    <div>
                        <span>{{ 'merch_buy.html.prix_unitaire'|trans }}</span>
                        <strong>{{ item.price|number_format(2, ',', ' ') }} €</strong>
                    </div>
                    {% if item.category %}
                        <div>
                            <span>{{ 'merch_list.html.categorie'|trans }}</span>
                            <strong>{{ item.category.name }}</strong>
                        </div>
                    {% endif %}
                    <div>
                        <span>Stock</span>
                        <strong>{% if item.stocks is empty %}Non defini{% else %}{{ item.totalStock }}{% endif %}</strong>
                    </div>
                </div>

                {% if item.stocks is not empty %}
                    <div class="ticket-show-stock-list">
                        {% for stock in item.stocks %}
                            <span>{{ stock.size }} : {{ stock.quantity }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="ticket-show-description">
                    {{ item.description|raw }}
                </div>

                <div class="ticket-show-actions">
                    <form action="{{ path('merch_cart_add', { id: item.id }) }}" method="post" class="ticket-show-inline-form">
                        {% if sizeChoices is not empty %}
                            <label class="form-label text-light" for="size">Taille</label>
                            <select id="size" name="size" class="form-select">
                                {% for label, value in sizeChoices %}
                                    <option value="{{ value }}" {% if preferredSize and preferredSize == value %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        {% else %}
                            <input type="hidden" name="size" value="TU">
                        {% endif %}

                        <label class="form-label text-light" for="quantity">Quantite</label>
                        <input id="quantity" name="quantity" type="number" min="1" value="1" class="form-control">

                        <button class="btn btn-danger ticket-show-main-cta" type="submit">Ajouter au panier</button>
                    </form>

                    <a href="{{ path('merch_cart') }}" class="btn btn-outline-light w-100">Voir mon panier</a>
                    <a href="{{ path('merch_index') }}" class="btn btn-outline-light w-100">{{ 'merch_buy.html.retour'|trans }}</a>
                </div>
            </div>

        </div>
    </div>
</div>

{% endblock %}
