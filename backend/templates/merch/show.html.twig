{% extends 'base.html.twig' %}

{% block title %}{{ 'merch_show.html.title'|trans({'%title%': item.title}) }}{% endblock %}

{% block body %}

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ item.title }}</h1>
        <p class="hero-subtitle">{{ 'merch_show.html.table_de_vente_officielle_ultras_lions'|trans }}</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <div class="row g-4">

            <div class="col-md-6">
                {% set cover = item.image ?: (item.media|first) %}
                {% if cover %}
                    <img src="{{ asset('uploads/media/' ~ cover.path) }}" class="img-fluid rounded shadow" alt="{{ item.title }}">
                {% endif %}
            </div>

            <div class="col-md-6">
                <h2>{{ item.title }}</h2>
                {% if item.category %}
                    <p class="text-muted mb-2">{{ item.category.name }}</p>
                {% endif %}
                {% if item.stocks is not empty %}
                    <p class="text-muted mb-2">{{ 'merch_show.html.stock_total'|trans({'%stock%': item.totalStock}) }}</p>
                    <div class="text-muted" style="font-size: 0.95rem;">
                        {% for stock in item.stocks %}
                            <div>{{ stock.size }} : {{ stock.quantity }}</div>
                        {% endfor %}
                    </div>
                {% endif %}
                <p class="product-price display-6">{{ item.price|number_format(2, ',', ' ') }} €</p>

                <div class="product-description">
                    {{ item.description|raw }}
                </div>

                <form action="{{ path('merch_cart_add', { id: item.id }) }}" method="post" class="mt-4">
                    {% if sizeChoices is not empty %}
                        <label class="form-label text-light" for="size">Taille</label>
                        <select id="size" name="size" class="form-select mb-3">
                            {% for label, value in sizeChoices %}
                                <option value="{{ value }}" {% if preferredSize and preferredSize == value %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    {% else %}
                        <input type="hidden" name="size" value="TU">
                    {% endif %}

                    <label class="form-label text-light" for="quantity">Quantite</label>
                    <input id="quantity" name="quantity" type="number" min="1" value="1" class="form-control mb-3">

                    <button class="btn btn-danger w-100" type="submit">Ajouter au panier</button>
                </form>

                <a href="{{ path('merch_cart') }}" class="btn btn-outline-light mt-3 w-100">Voir mon panier</a>
                <a href="{{ path('merch_index') }}" class="btn btn-outline-light mt-3">{{ 'merch_buy.html.retour'|trans }}</a>
            </div>

        </div>
    </div>
</div>

{% endblock %}
