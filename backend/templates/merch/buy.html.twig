{% extends 'base.html.twig' %}

{% block title %}Achat – {{ item.title }}{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">{{ 'merch_buy.html.achat'|trans }}</h1>
            <p class="hero-subtitle">{{ item.title }}</p>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 42rem;">
            <div class="card p-4 bg-dark text-light border-0 shadow">
                <p class="mb-3">{{ 'merch_buy.html.prix_unitaire'|trans }}<strong>{{ item.price|number_format(2, ',', ' ') }} €</strong>
                </p>

                {% if not stockConfigured %}
                    <div class="alert alert-warning mb-3">{{ 'merch_buy.html.stock_non_configure_pour_cet_article_contacte_un_admin'|trans }}</div>
                {% endif %}

                {{ form_start(form) }}
                    {% if form.email is defined %}
                        {{ form_row(form.email) }}
                    {% endif %}
                    {% if form.size is defined %}
                        {{ form_row(form.size) }}
                    {% endif %}
                    {{ form_row(form.quantity) }}
                    {{ form_row(form.note) }}

                    <button class="btn btn-danger w-100 mt-3" type="submit">{{ 'merch_buy.html.valider_et_recevoir_mon_recapitulatif'|trans }}</button>
                {{ form_end(form) }}

                <p class="mt-3 text-muted" style="font-size: 0.9rem;">{{ 'merch_buy.html.paiement_et_remise_a_la_table_de_vente_ou_selon_consignes_du_groupe'|trans }}</p>
            </div>

            <a href="{{ path('merch_show', { id: item.id }) }}" class="btn btn-outline-light mt-4">{{ 'merch_buy.html.retour'|trans }}</a>
        </div>
    </div>
{% endblock %}
