{% extends 'base.html.twig' %}

{% block title %}Achat â€“ {{ item.title }}{% endblock %}

{% block body %}
    {% set cover = item.image ?: (item.media|first) %}
    {% set merchHeroImage = cover and not cover.video ? asset('uploads/media/' ~ cover.path) : asset('img/fond/fond1a.jpg') %}
    <section class="ticket-show-hero" style="background-image: linear-gradient(90deg, rgba(0,0,0,0.9), rgba(0,0,0,0.58), rgba(0,0,0,0.86)), url('{{ merchHeroImage }}');">
        <div class="ticket-show-hero-inner">
            <p class="ticket-show-kicker">{{ 'components_navbar.html.table_de_vente'|trans }}</p>
            <h1 class="ticket-show-title">{{ 'merch_buy.html.achat'|trans }}</h1>
            <div class="ticket-show-hero-meta">
                <span>{{ item.title }}</span>
                <span>{{ item.price|number_format(2, ',', ' ') }} €</span>
                <span>Stock {{ item.totalStock }}</span>
            </div>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 46rem;">
            <div class="card merch-buy-card">
                <div class="merch-buy-header">
                    <p class="merch-buy-kicker">{{ 'components_navbar.html.table_de_vente'|trans }}</p>
                    <h2 class="merch-buy-title">{{ item.title }}</h2>
                </div>

                <div class="merch-buy-meta">
                    <div>
                        <span class="merch-buy-label">{{ 'merch_buy.html.prix_unitaire'|trans }}</span>
                        <div class="merch-buy-value">{{ item.price|number_format(2, ',', ' ') }} &euro;</div>
                    </div>
                    {% if item.category %}
                        <div>
                            <span class="merch-buy-label">{{ 'merch_list.html.categorie'|trans }}</span>
                            <div class="merch-buy-value">{{ item.category.name }}</div>
                        </div>
                    {% endif %}
                    <div>
                        <span class="merch-buy-label">Stock total</span>
                        <div class="merch-buy-value">{{ item.totalStock }}</div>
                    </div>
                </div>

                {% if not stockConfigured %}
                    <div class="alert alert-warning mb-3">{{ 'merch_buy.html.stock_non_configure_pour_cet_article_contacte_un_admin'|trans }}</div>
                {% endif %}

                {{ form_start(form, { attr: { class: 'merch-buy-form' } }) }}
                    <div class="merch-buy-grid">
                        {% if form.email is defined %}
                            <div class="merch-buy-field full">
                                {{ form_label(form.email) }}
                                {{ form_widget(form.email) }}
                            </div>
                        {% endif %}
                        {% if form.size is defined %}
                            <div class="merch-buy-field">
                                {{ form_label(form.size) }}
                                {{ form_widget(form.size) }}
                            </div>
                        {% endif %}
                        <div class="merch-buy-field">
                            {{ form_label(form.quantity) }}
                            {{ form_widget(form.quantity) }}
                        </div>
                        <div class="merch-buy-field full">
                            {{ form_label(form.note) }}
                            {{ form_widget(form.note) }}
                        </div>
                    </div>

                    <button class="btn btn-danger w-100 mt-2" type="submit">{{ item.price <= 0 ? 'Reserver' : ('merch_buy.html.valider_et_recevoir_mon_recapitulatif'|trans) }}</button>
                {{ form_end(form) }}

                {% if item.price > 0 %}
                    <p class="merch-buy-footnote">{{ 'merch_buy.html.paiement_et_remise_a_la_table_de_vente_ou_selon_consignes_du_groupe'|trans }}</p>
                {% endif %}
            </div>

            <a href="{{ path('merch_show', { id: item.id }) }}" class="btn btn-outline-light mt-4">{{ 'merch_buy.html.retour'|trans }}</a>
        </div>
    </div>
{% endblock %}
