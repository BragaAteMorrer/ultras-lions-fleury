{% extends 'base.html.twig' %}

{% block title %}Table de Vente – Ultras Lions{% endblock %}

{% block body %}

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Table de Vente</h1>
        <p class="hero-subtitle">Textiles, accessoires, stickers, supports du groupe</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <form method="get" class="mb-4" style="max-width: 24rem;">
            <label class="form-label text-light" for="category">Catégorie</label>
            <div class="d-flex gap-2">
                <select id="category" name="category" class="form-select">
                    <option value="" {% if selectedCategory is null %}selected{% endif %}>Toutes</option>
                    {% for cat in categories %}
                        <option value="{{ cat.slug }}" {% if selectedCategory and selectedCategory.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                    {% endfor %}
                </select>
                <button class="btn btn-outline-light" type="submit">Trier</button>
            </div>
        </form>

        <h2 class="section-title">Nos produits</h2>

        <div class="row g-4">
            {% for product in items %}
                <div class="col-md-4">
                    <a href="{{ path('merch_show', { id: product.id }) }}" class="card h-100">

                        {% set cover = product.image ?: (product.media|first) %}
                        {% if cover %}
                            <img src="{{ asset('uploads/media/' ~ cover.path) }}" class="event-card-img-top" alt="{{ product.title }}">
                        {% else %}
                            <img src="/placeholder.jpg" class="event-card-img-top" alt="{{ product.title }}">
                        {% endif %}

                        <div class="card-body">
                            <h3 class="card-title">{{ product.title }}</h3>
                            {% if product.category %}
                                <p class="text-muted mb-1">{{ product.category.name }}</p>
                            {% endif %}
                            <p class="card-price">{{ product.price|number_format(2, ',', ' ') }} €</p>

                            {% if product.description %}
                                <p>{{ product.description|striptags|slice(0, 90) ~ '…' }}</p>
                            {% endif %}
                        </div>

                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% endblock %}
