{% extends 'base.html.twig' %}

{% block title %}{{ 'merch_list.html.table_de_vente_ultras_lions'|trans }}{% endblock %}

{% block body %}

<section class="ticket-show-hero" style="background-image: linear-gradient(90deg, rgba(0,0,0,0.9), rgba(0,0,0,0.58), rgba(0,0,0,0.86)), url('{{ asset('img/fond/fond1a.jpg') }}');">
    <div class="ticket-show-hero-inner">
        <p class="ticket-show-kicker">{{ 'merch_list.html.textiles_accessoires_stickers_supports_du_groupe'|trans }}</p>
        <h1 class="ticket-show-title">{{ 'components_navbar.html.table_de_vente'|trans }}</h1>
        <div class="ticket-show-hero-meta">
            <span>{{ items|length }} produit{% if items|length > 1 %}s{% endif %}</span>
        </div>
    </div>
</section>

<div class="section">
    <div class="container">
        <form method="get" class="mb-4" style="max-width: 24rem;">
            <label class="form-label text-light" for="category">{{ 'merch_list.html.categorie'|trans }}</label>
            <div class="d-flex gap-2">
                <select id="category" name="category" class="form-select">
                    <option value="" {% if selectedCategory is null %}selected{% endif %}>{{ 'merch_list.html.toutes'|trans }}</option>
                    {% for cat in categories %}
                        <option value="{{ cat.slug }}" {% if selectedCategory and selectedCategory.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                    {% endfor %}
                </select>
                <button class="btn btn-outline-light" type="submit">{{ 'merch_list.html.trier'|trans }}</button>
            </div>
        </form>

        <h2 class="section-title">{{ 'merch_list.html.nos_produits'|trans }}</h2>

        <div class="row g-4">
            {% for product in items %}
                <div class="col-md-4">
                    <a href="{{ path('merch_show', { id: product.id }) }}" class="card h-100">

                        {% set cover = product.image ?: (product.media|first) %}
                        {% if cover %}
                            {% include 'components/media.html.twig' with { media: cover, class: 'event-card-img-top', alt: product.title } %}
                        {% else %}
                            <img src="/placeholder.jpg" class="event-card-img-top" alt="{{ product.title }}">
                        {% endif %}

                        <div class="card-body">
                            <h3 class="card-title">{{ product.title }}</h3>
                            {% if product.category %}
                                <p class="text-muted mb-1">{{ product.category.name }}</p>
                            {% endif %}
                            {% if product.description %}
                                <p class="mb-1">{{ product.description|striptags|slice(0, 90) ~ '...' }}</p>
                            {% endif %}
                            <p class="card-price">{{ product.price|number_format(2, ',', ' ') }} €</p>
                            <p class="text-muted mb-0">{% if product.stocks is empty %}Stock non defini{% else %}{{ 'merch_show.html.stock_total'|trans({'%stock%': product.totalStock}) }}{% endif %}</p>
                        </div>

                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% endblock %}
