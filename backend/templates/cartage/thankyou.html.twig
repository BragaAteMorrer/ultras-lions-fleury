{% extends 'base.html.twig' %}

{% block title %}Cartage{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Cartage</h1>
        {% if accountCreated|default(false) %}
            <p class="hero-subtitle">Paiement valide. Ton compte membre a ete cree.</p>
        {% else %}
            <p class="hero-subtitle">Merci, ton paiement est en cours de confirmation.</p>
        {% endif %}
    </div>
</section>
{% endblock %}
