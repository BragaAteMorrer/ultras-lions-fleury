{% extends 'base.html.twig' %}

{% block title %}Cartage{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Cartage</h1>
        <p class="hero-subtitle">Inscription reservee au QR code</p>
    </div>
</section>

<div class="section">
    <div class="container" style="max-width: 48rem;">
        <div class="card card-form">
            <h2 class="section-title">Infos cartage</h2>

            {% for message in app.flashes('danger') %}
                <div class="alert-error">{{ message }}</div>
            {% endfor %}

            {% if errors is not empty %}
                <div class="alert-error">
                    {% for error in errors %}
                        <p class="mb-1">{{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <p class="form-section-hint">
                Saison {{ currentSeason|default('') }} - Montant : {{ qrToken.amount|number_format(2, ',', ' ') }} EUR
            </p>

            {% if data.email|default('') %}
                {% if accountExists|default(false) %}
                    <div class="alert alert-secondary">
                        Compte deja existant pour cette adresse email. Le cartage servira de renouvellement et mettra le profil a jour apres validation.
                    </div>
                {% endif %}

                {% if seasonRegistration|default(null) %}
                    <div class="alert {{ seasonRegistration.completed  'alert-success' : 'alert-warning' }}">
                        {{ seasonRegistration.statusLabel }} pour la saison {{ seasonRegistration.season }}.
                    </div>
                {% endif %}
            {% endif %}

            <form method="post" action="{{ path('cartage_form') }}" id="cartageForm">
                <input type="hidden" name="_token" value="{{ csrf_token('cartage_register') }}">

                <h3 class="form-section-title">Formulaire de contact</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="prenom">Prenom</label>
                        <input id="prenom" name="prenom" class="form-control" required value="{{ data.prenom|default('') }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="nom">Nom</label>
                        <input id="nom" name="nom" class="form-control" required value="{{ data.nom|default('') }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="email">Email</label>
                        <input id="email" name="email" type="email" class="form-control" required value="{{ data.email|default('') }}" data-cartage-email-status-url="/cartage/email-status">
                        <div id="cartageEmailStatus" class="form-section-hint mb-0"></div>
                    </div>
                    <div id="cartagePasswordFields" class="col-12 {{ accountExists|default(false)  'd-none' : '' }}">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="plainPassword">Mot de passe</label>
                                <input id="plainPassword" name="plainPassword" type="password" class="form-control" autocomplete="new-password">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="confirmPassword">Confirmer le mot de passe</label>
                                <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password">
                            </div>
                            <div class="col-12">
                                <p class="form-section-hint mb-0">Mot de passe requis uniquement si aucun compte n'existe deja avec cet email.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="telephone">Telephone</label>
                        <input id="telephone" name="telephone" class="form-control" required value="{{ data.telephone|default('') }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="birth_date">Date de naissance</label>
                        <input id="birth_date" name="birth_date" type="date" class="form-control" required max="{{ 'now'|date('Y-m-d') }}" value="{{ data.birth_date|default('') }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="tailleTshirt">T-shirt</label>
                        <select id="tailleTshirt" name="tailleTshirt" class="form-select">
                            <option value="">Choisir...</option>
                            {% for size in ['XS', 'S', 'M', 'L', 'XL', 'XXL'] %}
                                <option value="{{ size }}" {{ data.tailleTshirt|default('') == size  'selected' : '' }}>{{ size }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="taillePolo">Polo</label>
                        <select id="taillePolo" name="taillePolo" class="form-select">
                            <option value="">Choisir...</option>
                            {% for size in ['XS', 'S', 'M', 'L', 'XL', 'XXL'] %}
                                <option value="{{ size }}" {{ data.taillePolo|default('') == size  'selected' : '' }}>{{ size }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="adresse">Adresse</label>
                        <input id="adresse" name="adresse" class="form-control" value="{{ data.adresse|default('') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="codePostal">Code postal</label>
                        <input id="codePostal" name="codePostal" class="form-control" value="{{ data.codePostal|default('') }}">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="ville">Ville</label>
                        <input id="ville" name="ville" class="form-control" value="{{ data.ville|default('') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="taillePull">Pull</label>
                        <select id="taillePull" name="taillePull" class="form-select">
                            <option value="">Choisir...</option>
                            {% for size in ['XS', 'S', 'M', 'L', 'XL', 'XXL'] %}
                                <option value="{{ size }}" {{ data.taillePull|default('') == size  'selected' : '' }}>{{ size }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="tailleSweat">Sweat</label>
                        <select id="tailleSweat" name="tailleSweat" class="form-select">
                            <option value="">Choisir...</option>
                            {% for size in ['XS', 'S', 'M', 'L', 'XL', 'XXL'] %}
                                <option value="{{ size }}" {{ data.tailleSweat|default('') == size  'selected' : '' }}>{{ size }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="tailleVeste">Veste</label>
                        <select id="tailleVeste" name="tailleVeste" class="form-select">
                            <option value="">Choisir...</option>
                            {% for size in ['XS', 'S', 'M', 'L', 'XL', 'XXL'] %}
                                <option value="{{ size }}" {{ data.tailleVeste|default('') == size  'selected' : '' }}>{{ size }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="tailleShort">Short</label>
                        <select id="tailleShort" name="tailleShort" class="form-select">
                            <option value="">Choisir...</option>
                            {% for size in ['XS', 'S', 'M', 'L', 'XL', 'XXL'] %}
                                <option value="{{ size }}" {{ data.tailleShort|default('') == size  'selected' : '' }}>{{ size }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <p class="form-section-hint mt-3">
                    Apres ce formulaire, tu devras lire et accepter le reglement interieur avant d'acceder au paiement.
                    Tu peux aussi verifier un cartage par email sur <a href="/cartage/statut">la page de statut</a>.
                </p>

                <button class="btn btn-danger w-100 mt-4" type="submit">Continuer vers le reglement</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var emailInput = document.getElementById('email');
            var statusBox = document.getElementById('cartageEmailStatus');
            var passwordFields = document.getElementById('cartagePasswordFields');
            var passwordInputs = [
                document.getElementById('plainPassword'),
                document.getElementById('confirmPassword')
            ].filter(Boolean);

            if (!emailInput || !statusBox || !passwordFields) {
                return;
            }

            var setPasswordVisible = function (visible) {
                passwordFields.classList.toggle('d-none', !visible);
                passwordInputs.forEach(function (input) {
                    input.required = visible;
                    if (!visible) {
                        input.value = '';
                    }
                });
            };

            var setStatus = function (message, type) {
                statusBox.textContent = message || '';
                statusBox.classList.remove('text-success', 'text-warning', 'text-danger');
                if (type) {
                    statusBox.classList.add(type);
                }
            };

            var checkEmail = function () {
                var email = emailInput.value.trim();
                var url = emailInput.dataset.cartageEmailStatusUrl;
                if (!email || !url) {
                    setStatus('', null);
                    setPasswordVisible(true);
                    return;
                }

                fetch(url + 'email=' + encodeURIComponent(email), {
                    headers: { 'Accept': 'application/json' }
                })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('Email status unavailable');
                        }

                        return response.json();
                    })
                    .then(function (payload) {
                        if (!payload.validEmail) {
                            setStatus('', null);
                            setPasswordVisible(true);
                            return;
                        }

                        setPasswordVisible(!payload.accountExists);

                        if (payload.registration && payload.registration.completed) {
                            setStatus('Cartage deja valide pour la saison ' + payload.season.replace('-', '/') + '.', 'text-success');
                            return;
                        }

                        if (payload.registration && payload.registration.pending) {
                            setStatus('Cartage deja en attente pour la saison ' + payload.season.replace('-', '/') + '.', 'text-warning');
                            return;
                        }

                        if (payload.accountExists) {
                            setStatus('Compte trouve : ce cartage sera traite comme un renouvellement.', 'text-success');
                            return;
                        }

                        setStatus('Aucun compte trouve : un compte sera cree apres validation du cartage.', 'text-warning');
                    })
                    .catch(function () {
                        setStatus('', null);
                    });
            };

            emailInput.addEventListener('blur', checkEmail);
            emailInput.addEventListener('change', checkEmail);
            checkEmail();
        })();
    </script>
{% endblock %}
