{% extends 'email/base.html.twig' %}

{% block title %}{{ 'email_ticket_order_recap.html.recapitulatif_de_reservation'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'email_ticket_order_recap.html.recapitulatif_de_reservation'|trans }}</h1>

    <p style="text-align: center;">
        {{ 'email_ticket_order_recap.html.thanks_for_booking'|trans }}{% if user and (user.prenom or user.nom) %}, {{ user.prenom }} {{ user.nom }}{% endif %}.
        {{ 'email_ticket_order_recap.html.here_is_summary'|trans }}
    </p>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin: 1.5rem 0; border-collapse: separate; border-spacing: 0;">
        <tr>
            <td style="background: #171717; border: 1px solid #2b2b2b; border-left: 4px solid #D40000; border-radius: 8px; padding: 1rem;">
                <div style="color: #888; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">{{ 'email_ticket_order_recap.html.n_reservation'|trans }}</div>
                <div style="color: #fff; font-size: 1.25rem; font-weight: bold; margin: 0.25rem 0 0.75rem;">{{ order.number }}</div>
                <div style="color: #888; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">{{ 'email_merch_order_recap.html.date'|trans }}</div>
                <div style="color: #ddd; font-size: 0.95rem; margin-top: 0.25rem;">{{ order.orderedAt|date('d/m/Y H:i') }}</div>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; margin: 1.5rem 0; background: #151515; border: 1px solid #2b2b2b; border-radius: 8px; overflow: hidden;">
        <thead>
        <tr style="background: #D40000;">
            <th align="left" style="padding: 0.75rem; color: #fff; font-size: 0.8rem; text-transform: uppercase;">{{ 'email_ticket_order_recap.html.match'|trans }}</th>
            <th align="center" style="padding: 0.75rem; color: #fff; font-size: 0.8rem; text-transform: uppercase;">{{ 'email_merch_order_recap.html.qte'|trans }}</th>
            <th align="right" style="padding: 0.75rem; color: #fff; font-size: 0.8rem; text-transform: uppercase;">{{ 'email_merch_order_recap.html.prix'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for line in order.lines %}
            <tr>
                <td style="padding: 0.875rem 0.75rem; border-bottom: 1px solid #262626; color: #fff;">
                    <strong>{{ line.title }}</strong><br>
                    <span style="display: inline-block; margin-top: 0.35rem; color: #bbb; font-size: 0.8rem;">{{ 'email_ticket_order_recap.html.match_line'|trans({'%date%': line.matchDate|date('d/m/Y H:i'), '%opponent%': line.opponent}) }}</span>
                </td>
                <td align="center" style="padding: 0.875rem 0.75rem; border-bottom: 1px solid #262626; color: #ddd; font-weight: bold;">{{ line.quantity }}</td>
                <td align="right" style="padding: 0.875rem 0.75rem; border-bottom: 1px solid #262626; color: #fff; font-weight: bold;">
                    {{ line.totalPrice|number_format(2, ',', ' ') }} EUR
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        <tr style="background: #0b0b0b;">
            <td colspan="2" align="right" style="padding: 1rem 0.75rem; color: #ddd; font-weight: bold; text-transform: uppercase;">{{ 'email_merch_order_recap.html.total'|trans }}</td>
            <td align="right" style="padding: 1rem 0.75rem; font-weight: bold; color: #D40000; font-size: 1.25rem;">
                {{ order.total|number_format(2, ',', ' ') }} EUR
            </td>
        </tr>
        </tfoot>
    </table>

    {% if order.note %}
        <p style="background: #171717; border: 1px solid #2b2b2b; border-radius: 8px; padding: 1rem;"><strong style="color: #fff;">{{ 'email_merch_order_recap.html.note'|trans }}</strong> {{ order.note }}</p>
    {% endif %}

    <p style="text-align: center;">{{ 'email_ticket_order_recap.html.le_paiement_et_les_infos_de_remise_retrait_se_font_selon_les_consignes'|trans }}</p>

    <a href="{{ url('ticket_index') }}" class="btn">{{ 'email_ticket_order_recap.html.voir_la_billetterie'|trans }}</a>
{% endblock %}
