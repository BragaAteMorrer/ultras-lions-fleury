{% extends 'email/base.html.twig' %}

{% block title %}Recapitulatif de commande{% endblock %}
{% block header_subtitle %}Confirmation de commande{% endblock %}
{% block header_title %}Recapitulatif de commande{% endblock %}

{% block content %}
    <p>Bonjour,</p>

    <p>
        Voici le recapitulatif de ta commande {{ checkout.checkoutReference }}.
    </p>

    <div class="card">
        <ul>
            <li>Reference : {{ checkout.checkoutReference }}</li>
            <li>Date : {{ checkout.createdAt|date('d/m/Y H:i') }}</li>
            <li>Total : {{ checkout.amount|number_format(2, ',', ' ') }} {{ checkout.currency }}</li>
        </ul>
    </div>

    {% if cashNotice %}
        <p class="note"><strong>Paiement a regler en liquide :</strong> tu recevras les instructions de remise ou de retrait selon le contexte de la commande.</p>
    {% endif %}

    {% if ticketLines is not empty %}
        <h2>Billets</h2>
        <div class="card">
            <ul>
                {% for line in ticketLines %}
                    <li>
                        {{ line.opponent ?? line.title }} - Quantite {{ line.quantity }} - {{ line.totalPrice|number_format(2, ',', ' ') }} EUR
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if merchLines is not empty %}
        <h2>Matos</h2>
        <div class="card">
            <ul>
                {% for line in merchLines %}
                    <li>
                        {{ line.title }}{% if line.size %} ({{ line.size }}){% endif %} - Quantite {{ line.quantity }} - {{ line.totalPrice|number_format(2, ',', ' ') }} EUR
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <p class="note">Merci pour ta commande. Si tu as une question, reponds a cet email.</p>
{% endblock %}
