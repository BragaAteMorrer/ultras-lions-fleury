<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Ultras Lions Fleury{% endblock %}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f4f4f4;
            font-family: Arial, Helvetica, sans-serif;
            color: #1c1c1c;
        }

        table {
            border-collapse: collapse;
        }

        img {
            border: 0;
            display: block;
            max-width: 100%;
            height: auto;
        }

        .wrapper {
            width: 100%;
            background: #f4f4f4;
            padding: 24px 12px;
        }

        .container {
            width: 100%;
            max-width: 640px;
            background: #ffffff;
            border: 1px solid #e6e6e6;
            border-radius: 16px;
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #111111 0%, #1f1f1f 55%, #7f0000 100%);
            padding: 28px 24px;
            text-align: center;
        }

        .logo {
            width: 160px;
            margin: 0 auto 14px;
        }

        .eyebrow {
            margin: 0;
            font-size: 12px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #f3d9d9;
        }

        .title {
            margin: 10px 0 6px;
            color: #ffffff;
            font-size: 26px;
            line-height: 1.2;
            font-weight: bold;
        }

        .content {
            padding: 32px 24px;
            color: #1c1c1c;
            font-size: 15px;
            line-height: 1.7;
        }

        .content h1,
        .content h2,
        .content h3 {
            margin: 0 0 16px;
            line-height: 1.25;
            color: #111111;
        }

        .content p {
            margin: 0 0 16px;
        }

        .content ul {
            margin: 16px 0;
            padding-left: 20px;
        }

        .content li {
            margin-bottom: 8px;
        }

        .content a {
            color: #c40018;
        }

        .button {
            display: inline-block;
            background: #c40018;
            color: #ffffff !important;
            text-decoration: none;
            font-weight: bold;
            padding: 14px 22px;
            border-radius: 999px;
        }

        .note {
            padding: 16px 18px;
            background: #f8f8f8;
            border: 1px solid #e8e8e8;
            border-radius: 12px;
            color: #555555;
        }

        .card {
            padding: 18px;
            border: 1px solid #ececec;
            border-radius: 12px;
            background: #ffffff;
            margin: 16px 0;
        }

        .footer {
            padding: 18px 24px 28px;
            text-align: center;
            font-size: 12px;
            line-height: 1.6;
            color: #6b6b6b;
            background: #fafafa;
            border-top: 1px solid #ececec;
        }

        .muted {
            color: #6b6b6b;
        }

        @media only screen and (max-width: 640px) {
            .wrapper {
                padding: 12px 6px;
            }

            .content,
            .header,
            .footer {
                padding-left: 16px;
                padding-right: 16px;
            }
        }
    </style>
</head>
<body>
<table class="wrapper" role="presentation" width="100%">
    <tr>
        <td align="center">
            <table class="container" role="presentation" width="100%">
                <tr>
                    <td class="header">
                        {% block header %}
                            <img src="{{ email.image('@images/Logo Final - Ultras Lions - Autre Présentation.png', 'image/png', 'logo-ultras-lions.png') }}" alt="Ultras Lions Fleury" class="logo" width="160">
                            <p class="eyebrow">{% block header_subtitle %}Ultras Lions Fleury{% endblock %}</p>
                            <h1 class="title">{% block header_title %}{% endblock %}</h1>
                        {% endblock %}
                    </td>
                </tr>
                <tr>
                    <td class="content">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td class="footer">
                        {% block footer %}
                            Tu recois cet email car ton compte est lie aux services Ultras Lions Fleury.<br>
                            Merci de ne pas repondre directement a ce message.
                        {% endblock %}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>