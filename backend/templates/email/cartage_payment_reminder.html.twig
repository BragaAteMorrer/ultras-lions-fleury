{% extends 'email/base.html.twig' %}

{% block title %}Cartage en attente{% endblock %}
{% block header_subtitle %}Paiement a finaliser{% endblock %}
{% block header_title %}Cartage en attente{% endblock %}

{% block content %}
    <p>Bonjour {{ registration.firstName }},</p>

    <p>
        Ta demande de cartage a bien ete enregistree, mais elle n'est pas encore marquee comme payee ou validee.
    </p>

    <div class="card">
        <ul>
            <li>Nom : {{ registration.firstName }} {{ registration.lastName }}</li>
            <li>Montant : {{ registration.amount|number_format(2, ',', ' ') }} EUR</li>
            <li>Paiement choisi : {{ registration.paymentMethod == 'cash' ? 'Liquide' : 'En ligne' }}</li>
            {% if registration.checkoutReference %}
                <li>Reference : {{ registration.checkoutReference }}</li>
            {% endif %}
        </ul>
    </div>

    {% if registration.paymentMethod == 'cash' %}
        <p>Tu peux finaliser le paiement en liquide aupres du groupe. Une fois le paiement recu, ton cartage sera valide par le bureau.</p>
    {% else %}
        <p>Si le paiement en ligne n'a pas abouti, repasse par le QR code de cartage ou contacte le groupe pour debloquer ta situation.</p>
    {% endif %}

    <p>
        <a class="button" href="{{ absolute_url(statusUrl|default(path('cartage_status'))) }}">Verifier mon statut</a>
    </p>

    <p class="note">Merci,<br>Ultras Lions Fleury</p>
{% endblock %}
