{% extends 'email/base.html.twig' %}

{% block title %}Reinitialisation du mot de passe{% endblock %}

{% block content %}
    <h1>Reinitialisation du mot de passe</h1>

    <p>Salut{% if user.prenom %} {{ user.prenom }}{% endif %},</p>

    <p>Tu as demande a changer ton mot de passe. Le lien ci-dessous est valable pendant 1 heure.</p>

    <p>
        <a href="{{ absolute_url(resetUrl) }}" class="btn">Choisir un nouveau mot de passe</a>
    </p>

    <p>Si tu n'es pas a l'origine de cette demande, tu peux ignorer cet email.</p>
{% endblock %}
