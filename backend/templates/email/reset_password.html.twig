{% extends 'email/base.html.twig' %}

{% block title %}Reinitialisation du mot de passe{% endblock %}
{% block header_subtitle %}Acces securise{% endblock %}

{% block content %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
        <tr>
            <td class="email-card email-card--accent">
                <div class="email-badge">Mot de passe</div>
                <h1 class="email-title">Reinitialisation du mot de passe</h1>
                <p class="email-subtitle">Salut{% if user.prenom %} {{ user.prenom }}{% endif %}, ton lien de reinitialisation est valable pendant 1 heure.</p>
                <a href="{{ absolute_url(resetUrl) }}" class="email-button">Choisir un nouveau mot de passe</a>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
        <tr>
            <td class="email-note email-note--soft">
                Si tu n'es pas a l'origine de cette demande, tu peux ignorer ce mail.
            </td>
        </tr>
    </table>
{% endblock %}
