{% extends 'email/base.html.twig' %}

{% block title %}Bienvenue chez les Ultras Lions{% endblock %}
{% block header_subtitle %}Nouveau compte cree{% endblock %}
{% block header_title %}Bienvenue{% endblock %}

{% block content %}
    {% set displayName = (user.prenom|default('') ~ ' ' ~ user.nom|default(''))|trim %}

    <p>Salut{% if displayName %} {{ displayName }}{% endif %},</p>

    <p>
        Ton compte a bien ete cree. Tu peux maintenant te connecter et acceder aux services reserves aux membres.
    </p>

    <div class="card">
        <p class="muted" style="margin-bottom: 8px;">Nous sommes heureux de t'accueillir parmi nous.</p>
        <p style="margin-bottom: 0;">Si tu as une question, reponds a cet email ou contacte le groupe.</p>
    </div>

    <p>
        <a href="{{ url('home') }}" class="button">Acceder au site</a>
    </p>
{% endblock %}
