{% extends 'base.html.twig' %}

{% block title %}{{ 'checkout_cash_thankyou.html.paiement_en_liquide'|trans }}{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">{{ 'checkout_cash_thankyou.html.paiement_en_liquide'|trans }}</h1>
            <p class="hero-subtitle">{{ 'checkout_cash_thankyou.html.a_regler_au_prochain_match_a_domicile'|trans }}</p>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 56rem;">
            <div class="card p-4 bg-dark text-light border-0 shadow">
                <p>{{ 'checkout_cash_thankyou.html.merci_ta_commande_est_enregistree'|trans }}</p>
                <p><strong>{{ 'checkout_receipt.html.numero_de_commande'|trans }}</strong> {{ checkout.checkoutReference }}</p>
                <p><strong>{{ 'checkout_receipt.html.date'|trans }}</strong> {{ checkout.createdAt|date('d/m/Y H:i') }}</p>
                {% if checkout.customerFirstName or checkout.customerLastName %}
                    <p><strong>{{ 'checkout_receipt.html.nom'|trans }}</strong> {{ (checkout.customerFirstName ?? '') ~ ' ' ~ (checkout.customerLastName ?? '') }}</p>
                {% endif %}
                <p><strong>{{ 'checkout_receipt.html.total'|trans }}</strong> {{ checkout.amount|number_format(2, ',', ' ') }} {{ checkout.currency }}</p>

                <div class="alert alert-warning mt-3">
                    {{ 'checkout_cash_thankyou.html.paiement_a_regler_en_liquide_au_prochain_match_a_domicile'|trans }}
                </div>

                {% if ticketItems is not empty %}
                    <h3 class="form-section-title mt-3">{{ 'checkout_receipt.html.billets'|trans }}</h3>
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>{{ 'checkout_receipt.html.match'|trans }}</th>
                                    <th>{{ 'cart_index.html.quantite'|trans }}</th>
                                    <th>{{ 'checkout_receipt.html.total'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in ticketItems %}
                                    <tr>
                                        <td>{{ item.opponent ?: item.title }}</td>
                                        <td>{{ item.quantity }}</td>
                                        <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if merchItems is not empty %}
                    <h3 class="form-section-title mt-3">{{ 'checkout_receipt.html.matos'|trans }}</h3>
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>{{ 'checkout_receipt.html.produit'|trans }}</th>
                                    <th>{{ 'checkout_receipt.html.taille'|trans }}</th>
                                    <th>{{ 'cart_index.html.quantite'|trans }}</th>
                                    <th>{{ 'checkout_receipt.html.total'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in merchItems %}
                                    <tr>
                                        <td>{{ item.title }}</td>
                                        <td>{{ item.size }}</td>
                                        <td>{{ item.quantity }}</td>
                                        <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                <a href="{{ path('checkout_receipt_pdf', { ref: checkout.checkoutReference }) }}" class="btn btn-outline-light mt-3" target="_blank" rel="noopener">{{ 'checkout_receipt.html.telecharger_le_pdf'|trans }}</a>
                <a href="{{ path('home') }}" class="btn btn-danger mt-3">{{ 'checkout_receipt.html.retour_a_l_accueil'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
