{% extends 'base.html.twig' %}

{% block title %}Merci{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">Paiement confirme</h1>
            <p class="hero-subtitle">Merci pour ton achat</p>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 56rem;">
            <div class="card p-4 bg-dark text-light border-0 shadow">
                <p>Ton paiement a bien ete pris en compte.</p>

                {% if checkout %}
                    <div class="mt-3">
                        <p><strong>Numero de commande</strong> {{ checkout.checkoutReference }}</p>
                        <p><strong>Date</strong> {{ checkout.createdAt|date('d/m/Y H:i') }}</p>
                        {% if checkout.customerFirstName or checkout.customerLastName %}
                            <p><strong>Nom</strong> {{ (checkout.customerFirstName ?? '') ~ ' ' ~ (checkout.customerLastName ?? '') }}</p>
                        {% endif %}
                        <p><strong>Total</strong> {{ checkout.amount|number_format(2, ',', ' ') }} {{ checkout.currency }}</p>
                    </div>

                    {% if ticketItems is not empty %}
                        <h3 class="form-section-title mt-3">Billets</h3>
                        <div class="table-responsive">
                            <table class="table table-dark table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>Match</th>
                                        <th>Quantite</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in ticketItems %}
                                        <tr>
                                            <td>{{ item.opponent ?: item.title }}</td>
                                            <td>{{ item.quantity }}</td>
                                            <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    {% if merchItems is not empty %}
                        <h3 class="form-section-title mt-3">Matos</h3>
                        <div class="table-responsive">
                            <table class="table table-dark table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>Produit</th>
                                        <th>Taille</th>
                                        <th>Quantite</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in merchItems %}
                                        <tr>
                                            <td>{{ item.title }}</td>
                                            <td>{{ item.size }}</td>
                                            <td>{{ item.quantity }}</td>
                                            <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <a href="{{ path('checkout_receipt_pdf', { ref: checkout.checkoutReference }) }}" class="btn btn-outline-light mt-3" target="_blank" rel="noopener">Telecharger le PDF</a>
                {% endif %}

                <a href="{{ path('home') }}" class="btn btn-danger mt-3">Retour a l'accueil</a>
            </div>
        </div>
    </div>
{% endblock %}
