<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Commande {{ checkout.checkoutReference }}</title>
    <style>
        @page { margin: 0; }
        body { font-family: Arial, sans-serif; color: #111; margin: 0; }
        .page { padding: 1.2rem 1.6rem 1.6rem; }
        .band { height: 1.2rem; background: #e30613; }
        .band.black { background: #0a0a0a; }
        .header { text-align: center; padding: 0.6rem 0 0.45rem; border-bottom: 0.15rem solid #0a0a0a; position: relative; }
        .logo { height: 8.5rem; display: block; margin: 0 auto; }
        .subtitle { font-size: 1.5rem; color: #222; text-transform: uppercase; letter-spacing: 0.05rem; margin-top: 0.3rem; }
        .watermark {
            position: absolute;
            top: 9rem; left: 50%;
            transform: translateX(-50%);
            width: 22rem;
            opacity: 0.12;
        }
        .card { background: #fff; border: 0.06rem solid #e6e6e6; padding: 0.9rem 1.1rem; margin-top: 1.1rem; }
        .row { display: flex; gap: 0.8rem; flex-wrap: wrap; }
        .col { flex: 1 1 12rem; }
        .label { font-size: 0.7rem; text-transform: uppercase; color: #666; }
        .value { font-size: 0.9rem; font-weight: 700; }
        table { width: 100%; border-collapse: collapse; margin-top: 0.6rem; }
        th, td { border-bottom: 0.06rem solid #ddd; padding: 0.45rem; text-align: left; font-size: 0.75rem; }
        th { background: #f5f5f5; text-transform: uppercase; letter-spacing: 0.03rem; font-size: 0.65rem; }
        .section-title { font-size: 0.9rem; margin: 0.9rem 0 0.4rem; color: #111; }
        .total { text-align: right; font-size: 1rem; font-weight: 800; color: #e30613; margin-top: 0.5rem; }
        .footer { margin-top: 1rem; font-size: 0.7rem; color: #666; text-align: center; }
        .actions { display: flex; justify-content: center; margin-top: 0.6rem; }
        .btn-print {
            border: 0.1rem solid #111;
            background: #fff;
            color: #111;
            padding: 0.45rem 1rem;
            font-weight: 700;
            letter-spacing: 0.04rem;
            text-transform: uppercase;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="band"></div>
    <div class="band black"></div>
    <div class="header">
        {% if logoPath %}
            <img class="logo" src="{{ logoPath }}" alt="Ultras Lions">
        {% endif %}
        <div class="subtitle">Recapitulatif de commande</div>
    </div>

    <div class="page">
        {% if watermarkPath %}
            <img class="watermark" src="{{ watermarkPath }}" alt="">
        {% endif %}

        <div class="card">
            <div class="row">
                <div class="col">
                    <div class="label">Numero</div>
                    <div class="value">{{ checkout.checkoutReference }}</div>
                </div>
                <div class="col">
                    <div class="label">Date</div>
                    <div class="value">{{ checkout.createdAt|date('d/m/Y H:i') }}</div>
                </div>
                <div class="col">
                    <div class="label">Nom</div>
                    <div class="value">{{ (checkout.customerFirstName ?? '') ~ ' ' ~ (checkout.customerLastName ?? '') }}</div>
                </div>
                <div class="col">
                    <div class="label">Total</div>
                    <div class="value">{{ checkout.amount|number_format(2, ',', ' ') }} {{ checkout.currency }}</div>
                </div>
                <div class="col">
                    <div class="label">Paiement</div>
                    <div class="value">
                        {% if checkout.type == 'cash' %}
                            Liquide
                        {% elseif checkout.type == 'ticket' or checkout.type == 'merch' or checkout.type == 'mixed' %}
                            SumUp
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if ticketItems is not empty %}
            <div class="section-title">Billets</div>
            <table>
                <thead>
                    <tr>
                        <th>Match</th>
                        <th>Quantite</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in ticketItems %}
                        <tr>
                            <td>{{ item.opponent ?: item.title }}</td>
                            <td>{{ item.quantity }}</td>
                            <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if merchItems is not empty %}
            <div class="section-title">Matos</div>
            <table>
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Taille</th>
                        <th>Quantite</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in merchItems %}
                        <tr>
                            <td>{{ item.title }}</td>
                            <td>{{ item.size }}</td>
                            <td>{{ item.quantity }}</td>
                            <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <div class="total">Total: {{ checkout.amount|number_format(2, ',', ' ') }} {{ checkout.currency }}</div>
        <div class="footer">A conserver comme preuve d'achat.</div>
    </div>
</body>
</html>
