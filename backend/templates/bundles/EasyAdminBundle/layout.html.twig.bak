{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}
    🔥 Dashboard Ultras Lions
{% endblock %}

{% block main %}
    <div class="content-panel">
        <h1>🔥 Dashboard Ultras Lions</h1>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>Articles</h3>
                <p class="stat-number">{{ stats.posts|default(0) }}</p>
            </div>

            <div class="stat-card">
                <h3>Événements</h3>
                <p class="stat-number">{{ stats.events|default(0) }}</p>
            </div>

            <div class="stat-card">
                <h3>Galeries</h3>
                <p class="stat-number">{{ stats.galleries|default(0) }}</p>
            </div>

            <div class="stat-card">
                <h3>Médias</h3>
                <p class="stat-number">{{ stats.media|default(0) }}</p>
            </div>

            <div class="stat-card">
                <h3>Visites</h3>
                <p class="stat-number">{{ stats.visits|default(0) }}</p>
            </div>
        </div>
    </div>
{% endblock %}