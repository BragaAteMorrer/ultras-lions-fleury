{% extends 'base.html.twig' %}

{% block title %}{{ 'profile_change_password.html.title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <h1 class="section-title">{{ 'profile_change_password.html.heading'|trans }}</h1>

            <div class="cards cards-single">
                <div class="card card-form">
                    {{ form_start(form) }}
                        {{ form_row(form.currentPassword) }}
                        {{ form_row(form.plainPassword) }}
                        {{ form_row(form.confirmPassword) }}

                        <button class="btn-ul">{{ 'profile_change_password.html.submit'|trans }}</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
