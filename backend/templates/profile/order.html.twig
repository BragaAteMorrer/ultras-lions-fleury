{% extends 'base.html.twig' %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="profile-info-card">
            <h2 class="section-title">Commande</h2>

            <p><strong>Type</strong>
                {% if checkout.type == 'ticket' %}
                    Billetterie
                {% elseif checkout.type == 'merch' %}
                    Table de vente
                {% elseif checkout.type == 'cash' %}
                    Paiement liquide
                {% elseif checkout.type == 'free' %}
                    Reservation gratuite
                {% else %}
                    Panier
                {% endif %}
            </p>
            <p><strong>Statut</strong> {{ checkout.statusLabel }}</p>
            <p><strong>Total</strong> {{ checkout.amount|number_format(2, ',', ' ') }} {{ checkout.currency }}</p>
            <p><strong>Date</strong> {{ checkout.createdAt|date('d/m/Y H:i') }}</p>
            <p><strong>Paiement</strong>
                {% if checkout.type == 'free' %}
                    Gratuit
                {% elseif checkout.type == 'cash' %}
                    Liquide
                {% else %}
                    SumUp
                {% endif %}
            </p>
            {% if checkout.type == 'free' %}
                <div class="alert alert-success mt-2">
                    Aucun paiement requis.
                </div>
            {% elseif checkout.type == 'cash' %}
                <div class="alert alert-warning mt-2">
                    Paiement a regler en liquide au prochain match a domicile.
                </div>
            {% endif %}
            <a href="{{ path('checkout_receipt_pdf', { ref: checkout.checkoutReference }) }}" class="btn btn-outline-light mt-2">Telecharger le PDF</a>

            <hr>

            {% if checkout.type == 'ticket' %}
                <h3 class="form-section-title">Billets</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Match</th>
                                <th>Date</th>
                                <th>Quantite</th>
                                <th>Prix</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                                <tr>
                                    <td>{{ item.opponent ?: item.title }}</td>
                                    <td>
                                        {% if item.match_date %}
                                            {{ item.match_date|date('d/m/Y H:i') }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>{{ item.quantity }}</td>
                                    <td>{{ item.unit_price|number_format(2, ',', ' ') }} EUR</td>
                                    <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% elseif checkout.type == 'merch' %}
                <h3 class="form-section-title">Matos</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Taille</th>
                                <th>Quantite</th>
                                <th>Prix</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                                <tr>
                                    <td>{{ item.title }}</td>
                                    <td>{{ item.size }}</td>
                                    <td>{{ item.quantity }}</td>
                                    <td>{{ item.unit_price|number_format(2, ',', ' ') }} EUR</td>
                                    <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                {% if ticketItems is not empty %}
                    <h3 class="form-section-title">Billets</h3>
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Match</th>
                                    <th>Date</th>
                                    <th>Quantite</th>
                                    <th>Prix</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in ticketItems %}
                                    <tr>
                                        <td>{{ item.opponent ?: item.title }}</td>
                                        <td>
                                            {% if item.match_date %}
                                                {{ item.match_date|date('d/m/Y H:i') }}
                                            {% else %}
                                                N/A
                                            {% endif %}
                                        </td>
                                        <td>{{ item.quantity }}</td>
                                        <td>{{ item.unit_price|number_format(2, ',', ' ') }} EUR</td>
                                        <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if merchItems is not empty %}
                    <h3 class="form-section-title mt-4">Matos</h3>
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Taille</th>
                                    <th>Quantite</th>
                                    <th>Prix</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in merchItems %}
                                    <tr>
                                        <td>{{ item.title }}</td>
                                        <td>{{ item.size }}</td>
                                        <td>{{ item.quantity }}</td>
                                        <td>{{ item.unit_price|number_format(2, ',', ' ') }} EUR</td>
                                        <td>{{ item.total|number_format(2, ',', ' ') }} EUR</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
