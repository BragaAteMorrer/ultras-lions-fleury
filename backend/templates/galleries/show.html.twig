{% extends 'base.html.twig' %}

{% block title %}{{ 'galleries_show.html.title'|trans({'%title%': gallery.title}) }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ gallery.title }}</h1>
    </div>
</section>

<div class="section">
    <div class="container">

        {% if gallery.description %}
            <div class="rich-content" style="margin-bottom: 1.5rem;">
                {{ gallery.description|raw }}
            </div>
        {% endif %}

        {% if gallery.media|length > 0 %}
            <div class="cards gallery-grid">
                {% for media in gallery.media %}
                    {% if media.video %}
                        <div class="card">
                            {% include 'components/media.html.twig' with { media: media, controls: true } %}
                        </div>
                    {% else %}
                        <a href="{{ asset('uploads/media/' ~ media.path) }}" class="card" data-lightbox="gallery">
                            {% include 'components/media.html.twig' with { media: media } %}
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
        {% else %}
            <p>{{ 'galleries_show.html.aucune_photo_disponible_pour_cette_galerie'|trans }}</p>
        {% endif %}

    </div>
</div>
{% endblock %}
