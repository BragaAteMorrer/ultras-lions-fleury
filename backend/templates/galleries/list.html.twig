{% extends 'base.html.twig' %}

{% block title %}{{ 'galleries_list.html.galeries_ultras_lions'|trans }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ 'admin_dashboard.html.galeries'|trans }}</h1>
        <p class="hero-subtitle">{{ 'galleries_list.html.tribunes_deplacements_tifos_vie_du_groupe'|trans }}</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <h2 class="section-title">{{ 'galleries_list.html.dernieres_galeries'|trans }}</h2>

        <div class="cards">
            {% for gallery in galleries %}
                <a href="{{ path('gallery_show', { id: gallery.id }) }}" class="card">

                    {% set cover = gallery.media|first %}
                    {% if cover %}
                        <img src="{{ asset('uploads/media/' ~ cover.path) }}"
                             alt="{{ gallery.title }}">
                    {% endif %}

                    <div class="card-content">
                        <h3>{{ gallery.title }}</h3>
                        {% if gallery.description %}
                            <p>{{ gallery.description|striptags|slice(0,120) ~ '...' }}</p>
                        {% endif %}
                    </div>
                </a>

            {% else %}
                <p>{{ 'galleries_list.html.aucune_galerie_pour_linstant'|trans }}</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
