<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    {% set siteTitle = site_name ?: ('base.html.ultras_lions_fc_fleury_91_title'|trans) %}
    {% set pageTitle %}{% block title %}{{ 'base.html.ultras_lions_fc_fleury_91_title'|trans }}{% endblock %}{% endset %}
    {% set pageTitle = pageTitle|trim %}
    {% set siteTitleNorm = siteTitle|lower %}
    {% set pageTitleNorm = pageTitle|lower %}
    <title>
        {% if pageTitle and pageTitle != siteTitle and (siteTitleNorm not in pageTitleNorm) %}
            {{ siteTitle }} - {{ pageTitle }}
        {% else %}
            {{ siteTitle }}
        {% endif %}
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MDCC90XZCY"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-MDCC90XZCY');
    </script>

    <link rel="icon" href="{{ asset('img/logo/Logo Final - Ultras Lions - Autre Présentation.png') }}">

    {% set siteBackground = site_background_url ?: asset('img/fond/fond1a.jpg') %}
    <link rel="preload" as="image" href="{{ siteBackground }}">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/navbar.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/footer.css') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>

<body class="{% block body_class %}{% endblock %}" style="--site-bg-image: url('{{ siteBackground }}');">

    <div class="site-loader" aria-hidden="true">
        <div class="site-loader-mark">
            <img src="{{ asset('img/logo/Logo Texte.png') }}" alt="">
            <span></span>
        </div>
    </div>

    {% include 'components/navbar.html.twig' %}

    <main>
        {% for label, messages in app.flashes %}
            {% set alertClass = label in ['success','warning','danger','info'] ? label : 'secondary' %}
            <div class="container mt-3">
                {% for message in messages %}
                    <div class="alert alert-{{ alertClass }} mb-2">{{ message }}</div>
                {% endfor %}
            </div>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    {% include 'components/footer.html.twig' %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="{{ asset('js/app.js') }}" defer></script>
    <script src="{{ asset('js/dashboard.js') }}" defer></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
