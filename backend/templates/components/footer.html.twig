<footer class="ultra-footer">

    <div class="footer-band"></div>

    <div class="container footer-content">

        <div class="footer-left">
            <img 
                src="{{ asset('img/logo/Logo Texte.png') }}" 
                alt="{{ 'components_footer.html.ultras_lions'|trans }}" 
                class="footer-logo-ultra"
            >
            <p class="footer-text">{{ 'components_footer.html.ten_as_vu_le_debut'|trans }}</p>
        </div>

        <div class="footer-right">
            <span class="footer-follow">{{ 'components_footer.html.suivez_nous'|trans }}</span>
            <div class="footer-socials">
                <a href="https://www.instagram.com/ultraslionsfleury91/" aria-label="{{ 'components_footer.html.instagram'|trans }}">
                    <i class="bi bi-instagram" aria-hidden="true"></i>
                </a>
                <a href="https://x.com/UltrasLioness91" aria-label="{{ 'components_footer.html.twitter'|trans }}">
                    <i class="bi bi-twitter-x" aria-hidden="true"></i>
                </a>
            </div>
            <a href="{{ path('donation_index') }}" class="footer-admin-link">Faire un don</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_dashboard_index') }}" class="footer-admin-link">{{ 'components_footer.html.espace_admin'|trans }}</a>
            {% endif %}
        </div>

    </div>

    <div class="footer-bottom">
        {{ 'components_footer.html.copyright'|trans({'%year%': "now"|date("Y")}) }}
    </div>

</footer>
