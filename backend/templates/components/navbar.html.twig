{% set merchCart = app.session ? app.session.get('cart_merch') : [] %}
{% set ticketCart = app.session ? app.session.get('cart_ticket') : [] %}
{% set merchCount = 0 %}
{% for row in merchCart %}
    {% set merchCount = merchCount + (row.quantity ?? 0) %}
{% endfor %}
{% set ticketCount = 0 %}
{% for row in ticketCart %}
    {% set ticketCount = ticketCount + (row.quantity ?? 0) %}
{% endfor %}
{% set cartCount = merchCount + ticketCount %}
{% set cartUrl = path('cart_index') %}
{% set navbarDisplayName = null %}
{% set profileUrl = null %}
{% set adminDashboardUrl = null %}
{% if app.user %}
    {% set navbarDisplayName = app.user.prenom ?: (app.user.email ? app.user.email|split('@')|first : 'Compte') %}
    {% set adminDashboardUrl = is_granted('ROLE_ADMIN') ? path('app_admin_dashboard_index') : null %}
    {% set profileUrl = adminDashboardUrl ?: path('profile_show', { id: app.user.id }) %}
{% endif %}
{% set currentRoute = app.request.get('_route') %}
{% set currentLocale = app.request.locale|default('fr') %}
{% set boutiqueActive = currentRoute starts with 'merch_' or currentRoute starts with 'ticket_' %}
{% set groupActive = currentRoute starts with 'group_' %}
{% set mediaActive = (currentRoute starts with 'event_') or (currentRoute starts with 'gallery_') or (currentRoute starts with 'media_') or (currentRoute starts with 'gamephoto_') %}
{% set languageNames = {
    fr: 'Français',
    en: 'English',
    es: 'Español',
    de: 'Deutsch',
    pt: 'Português',
    ar: 'العربية'
} %}

<header class="ultra-header">
    <div class="ultra-topband">
        <div class="container ultra-nav-row">
            <a href="{{ path('home') }}" class="ultra-brand" aria-label="{{ 'components_footer.html.ultras_lions'|trans }}">
                <img src="{{ asset('img/logo/Logo Texte.png') }}" class="ultra-logo" alt="{{ 'components_footer.html.ultras_lions'|trans }}">
            </a>

            <button class="ultra-burger d-lg-none" id="ultraNavToggle" type="button" aria-controls="ultraNavMobile" aria-expanded="false" aria-label="{{ 'components_navbar.html.ouvrir_le_menu'|trans }}">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="ultra-nav d-none d-lg-flex" aria-label="{{ 'components_navbar.html.navigation_principale'|trans }}">
                <a href="{{ path('home') }}" class="ultra-link {{ currentRoute == 'home' ? 'active' : '' }}">{{ 'components_navbar.html.accueil'|trans }}</a>
                <a href="{{ path('post_index') }}" class="ultra-link {{ currentRoute starts with 'post_' ? 'active' : '' }}">{{ 'components_navbar.html.actualites'|trans }}</a>

                <div class="dropdown">
                    <a href="{{ path('media_index') }}"
                       class="ultra-link dropdown-toggle {{ (currentRoute starts with 'event_') or (currentRoute starts with 'gallery_') or (currentRoute starts with 'media_') or (currentRoute starts with 'gamephoto_') ? 'active' : '' }}"
                       id="eventDropdown"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">{{ 'components_navbar.html.medias'|trans }}</a>
                    <ul class="dropdown-menu ultra-dropdown" aria-labelledby="eventDropdown">
                        <li><a class="dropdown-item" href="{{ path('media_index') }}">{{ 'components_navbar.html.tout_les_medias'|trans }}</a></li>
                        <li class="dropdown-submenu">
                            <a class="dropdown-item dropdown-toggle" href="{{ path('gamephoto_index') }}">{{ 'components_navbar.html.photos_de_match'|trans }}</a>
                            <ul class="dropdown-menu ultra-dropdown">
                                {% for seasonValue in event_seasons %}
                                    {% set parts = seasonValue|split('-') %}
                                    {% set yearStart = parts|first %}
                                    {% set yearEnd = parts|last %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('gamephoto_index', { season: seasonValue }) }}">
                                            {{ 'components_navbar.html.saison'|trans({'%year_start%': yearStart, '%year_end%': yearEnd}) }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    </ul>
                </div>

                <a href="{{ path('chant_index') }}" class="ultra-link {{ currentRoute starts with 'chant_' ? 'active' : '' }}">{{ 'components_navbar.html.chants'|trans }}</a>

                <div class="dropdown">
                    <a href="{{ path('merch_index') }}"
                       class="ultra-link dropdown-toggle {{ boutiqueActive ? 'active' : '' }}"
                       id="boutiqueDropdown"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">Boutique</a>
                    <ul class="dropdown-menu ultra-dropdown" aria-labelledby="boutiqueDropdown">
                        <li><a class="dropdown-item {{ currentRoute starts with 'merch_' ? 'active' : '' }}" href="{{ path('merch_index') }}">{{ 'components_navbar.html.table_de_vente'|trans }}</a></li>
                        <li><a class="dropdown-item {{ currentRoute starts with 'ticket_' ? 'active' : '' }}" href="{{ path('ticket_index') }}">{{ 'components_navbar.html.billetterie'|trans }}</a></li>
                        <li>
                            <a class="dropdown-item {{ currentRoute starts with 'cartage_' ? 'active' : '' }}"
                               href="{{ path('cartage_qr_scan', {
                                   token: 'b817cb0f36ccf57d512e0387182734c3163e6c5ecbce7a16'
                               }) }}">
                                {{ 'group_show.html.section_se_carter_title'|trans }}
                            </a>
                        </li>
                    </ul>
                </div>
                
                <a href="{{ path('gadget_index') }}" class="ultra-link {{ currentRoute starts with 'gadget_' ? 'active' : '' }}">Gadgets</a>

                <div class="dropdown">
                    <a href="{{ path('group_index') }}"
                       class="ultra-link dropdown-toggle {{ groupActive ? 'active' : '' }}"
                       id="groupDropdown"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">{{ 'components_navbar.html.le_groupe'|trans }}</a>
                    <ul class="dropdown-menu ultra-dropdown" aria-labelledby="groupDropdown">
                        <li><a class="dropdown-item" href="{{ path('group_index') }}">{{ 'components_navbar.html.le_groupe'|trans }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('group_index') }}#notre-histoire">{{ 'components_navbar.html.notre_histoire'|trans }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('group_index') }}#notre-mentalite">{{ 'components_navbar.html.notre_mentalite'|trans }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('group_index') }}#notre-fonctionnement">{{ 'components_navbar.html.notre_fonctionnement'|trans }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('group_index') }}#pourquoi-nous-rejoindre">{{ 'components_navbar.html.pourquoi_nous_rejoindre'|trans }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('group_index') }}#se-carter">{{ 'components_navbar.html.se_carter'|trans }}</a></li>
                    </ul>
                </div>

                <a href="{{ path('linktree_index') }}" class="ultra-link {{ currentRoute starts with 'linktree_' ? 'active' : '' }}">{{ 'components_navbar.html.liens'|trans }}</a>

                {% if app.user %}
                    <div class="dropdown user-nav">
                        <a class="ultra-link dropdown-toggle d-flex align-items-center user-nav-trigger"
                           href="{{ profileUrl }}"
                           id="userDropdown"
                           data-bs-toggle="dropdown"
                           aria-expanded="false"
                           aria-label="{{ is_granted('ROLE_ADMIN') ? 'components_navbar.html.acceder_a_l_espace_admin'|trans : 'components_navbar.html.acceder_a_mon_profil'|trans }}">
                            {% if app.user.photoProfil %}
                                <img src="/uploads/profils/{{ app.user.photoProfil }}" class="user-avatar-menu me-2" alt="">
                            {% else %}
                                <img src="{{ asset('img/logo/Logo CIrculaire - Final - Football Furies.png') }}" class="user-avatar-menu me-2" alt="">
                            {% endif %}
                            <span class="user-nav-label">{{ navbarDisplayName }}</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end ultra-dropdown" aria-labelledby="userDropdown">
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><a class="dropdown-item" href="{{ path('app_admin_dashboard_index') }}">{{ 'components_navbar.html.espace_admin'|trans }}</a></li>
                                <li><hr class="dropdown-divider"></li>
                            {% endif %}
                            <li><a class="dropdown-item" href="{{ path('profile_show', { id: app.user.id }) }}">{{ 'components_navbar.html.mon_profil'|trans }}</a></li>
                            <li><a class="dropdown-item" href="{{ path('profile_edit', { id: app.user.id }) }}">{{ 'components_navbar.html.modifier_mon_compte'|trans }}</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">{{ 'components_navbar.html.deconnexion'|trans }}</a></li>
                        </ul>
                    </div>
                {% else %}
                    <div class="dropdown ultra-user-menu">
                        <a class="ultra-link dropdown-toggle" href="#" id="loginDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ 'components_navbar.html.connexion'|trans }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end ultra-dropdown" aria-labelledby="loginDropdown">
                            <li><a class="dropdown-item" href="{{ path('app_login') }}">{{ 'components_navbar.html.se_connecter'|trans }}</a></li>
                            <li><a class="dropdown-item" href="{{ path('invitation_check') }}">{{ 'components_navbar.html.sinscrire'|trans }}</a></li>
                        </ul>
                    </div>
                {% endif %}

                <div class="dropdown">
                    <a class="ultra-link dropdown-toggle language-trigger" href="#" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'components_navbar.html.changer_de_langue'|trans }}">
                        {% include 'components/flag.html.twig' with { locale: currentLocale } %}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end ultra-dropdown" aria-labelledby="languageDropdown">
                        {% for locale, name in languageNames %}
                            <li>
                                <a class="dropdown-item language-item {{ currentLocale == locale ? 'active' : '' }}" href="{{ path('locale_switch', { locale: locale }) }}" aria-label="{{ name }}">
                                    {% include 'components/flag.html.twig' with { locale: locale } %}
                                    <span>{{ name }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                {% if cartCount > 0 %}
                    <a href="{{ cartUrl }}" class="ultra-link cart-desktop-link {{ currentRoute starts with 'cart_' ? 'active' : '' }}" aria-label="{{ 'components_navbar.html.panier'|trans }}">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7 6H21L19.5 14H8L7 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                            <path d="M5 6H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M9 18.5C9.82843 18.5 10.5 17.8284 10.5 17C10.5 16.1716 9.82843 15.5 9 15.5C8.17157 15.5 7.5 16.1716 7.5 17C7.5 17.8284 8.17157 18.5 9 18.5Z" fill="currentColor"/>
                            <path d="M18 18.5C18.8284 18.5 19.5 17.8284 19.5 17C19.5 16.1716 18.8284 15.5 18 15.5C17.1716 15.5 16.5 16.1716 16.5 17C16.5 17.8284 17.1716 18.5 18 18.5Z" fill="currentColor"/>
                        </svg>
                        <span class="cart-count">{{ cartCount }}</span>
                    </a>
                {% endif %}
            </nav>
        </div>
    </div>

    <nav class="ultra-nav-mobile d-lg-none" id="ultraNavMobile" aria-label="{{ 'components_navbar.html.navigation_principale'|trans }}">
        <div class="container mobile-nav-inner">
            <div class="mobile-nav-tools">
                {% if cartCount > 0 %}
                    <a href="{{ cartUrl }}" class="mobile-cart-link {{ currentRoute starts with 'cart_' ? 'active' : '' }}" aria-label="{{ 'components_navbar.html.panier'|trans }}">
                        <span>{{ 'components_navbar.html.panier'|trans }}</span>
                        <strong>{{ cartCount }}</strong>
                    </a>
                {% endif %}

                <div class="mobile-language-flags" aria-label="{{ 'components_navbar.html.changer_de_langue'|trans }}">
                    {% for locale, name in languageNames %}
                        <a href="{{ path('locale_switch', { locale: locale }) }}" class="mobile-language-flag {{ currentLocale == locale ? 'active' : '' }}" aria-label="{{ name }}">
                            {% include 'components/flag.html.twig' with { locale: locale } %}
                        </a>
                    {% endfor %}
                </div>
            </div>

            <a href="{{ path('home') }}" class="ultra-link {{ currentRoute == 'home' ? 'active' : '' }}">{{ 'components_navbar.html.accueil'|trans }}</a>
            <a href="{{ path('post_index') }}" class="ultra-link {{ currentRoute starts with 'post_' ? 'active' : '' }}">{{ 'components_navbar.html.actualites'|trans }}</a>

            <div class="mobile-submenu">
                <button type="button" class="ultra-link submenu-toggle {{ mediaActive ? 'active' : '' }}" aria-expanded="false">{{ 'components_navbar.html.medias'|trans }}</button>
                <a href="{{ path('media_index') }}" class="ultra-link sub {{ currentRoute starts with 'media_' ? 'active' : '' }}">{{ 'components_navbar.html.tout_les_medias'|trans }}</a>
                <a href="{{ path('gamephoto_index') }}" class="ultra-link sub {{ currentRoute starts with 'gamephoto_' ? 'active' : '' }}">{{ 'components_navbar.html.photos_de_match'|trans }}</a>
                {% for mediaCategory in event_media_categories %}
                    <a href="{{ path('media_category', { slug: mediaCategory.slug }) }}" class="ultra-link sub">{{ mediaCategory.name }}</a>
                {% endfor %}
                {% for seasonValue in event_seasons %}
                    {% set parts = seasonValue|split('-') %}
                    {% set yearStart = parts|first %}
                    {% set yearEnd = parts|last %}
                    <a href="{{ path('gamephoto_index', { season: seasonValue }) }}" class="ultra-link sub">
                        {{ 'components_navbar.html.saison'|trans({'%year_start%': yearStart, '%year_end%': yearEnd}) }}
                    </a>
                {% endfor %}
            </div>

            <a href="{{ path('chant_index') }}" class="ultra-link {{ currentRoute starts with 'chant_' ? 'active' : '' }}">{{ 'components_navbar.html.chants'|trans }}</a>
            <div class="mobile-submenu">
                <button type="button" class="ultra-link submenu-toggle {{ boutiqueActive ? 'active' : '' }}" aria-expanded="false">Boutique</button>
                <a href="{{ path('merch_index') }}" class="ultra-link sub {{ currentRoute starts with 'merch_' ? 'active' : '' }}">{{ 'components_navbar.html.table_de_vente'|trans }}</a>
                <a href="{{ path('ticket_index') }}" class="ultra-link sub {{ currentRoute starts with 'ticket_' ? 'active' : '' }}">{{ 'components_navbar.html.billetterie'|trans }}</a>
                <a href="{{ path('cartage_qr_scan', {
                    token: 'b817cb0f36ccf57d512e0387182734c3163e6c5ecbce7a16'
                }) }}" class="ultra-link sub {{ currentRoute starts with 'cartage_' ? 'active' : '' }}">
                    {{ 'group_show.html.section_se_carter_title'|trans }}
                </a>
            </div>
            <a href="{{ path('gadget_index') }}" class="ultra-link {{ currentRoute starts with 'gadget_' ? 'active' : '' }}">Gadgets</a>

            <div class="mobile-submenu">
                <button type="button" class="ultra-link submenu-toggle {{ groupActive ? 'active' : '' }}" aria-expanded="false">
                    {{ 'components_navbar.html.le_groupe'|trans }}
                </button>
                <a href="{{ path('group_index') }}" class="ultra-link sub {{ currentRoute starts with 'group_' ? 'active' : '' }}">{{ 'components_navbar.html.le_groupe'|trans }}</a>
                <a href="{{ path('group_index') ~ '#notre-histoire' }}" class="ultra-link sub">{{ 'components_navbar.html.notre_histoire'|trans }}</a>
                <a href="{{ path('group_index') ~ '#notre-mentalite' }}" class="ultra-link sub">{{ 'components_navbar.html.notre_mentalite'|trans }}</a>
                <a href="{{ path('group_index') ~ '#notre-fonctionnement' }}" class="ultra-link sub">{{ 'components_navbar.html.notre_fonctionnement'|trans }}</a>
                <a href="{{ path('group_index') ~ '#pourquoi-nous-rejoindre' }}" class="ultra-link sub">{{ 'components_navbar.html.pourquoi_nous_rejoindre'|trans }}</a>
            </div>

            <a href="{{ path('linktree_index') }}" class="ultra-link {{ currentRoute starts with 'linktree_' ? 'active' : '' }}">{{ 'components_navbar.html.liens'|trans }}</a>

            <hr>

            {% if app.user %}
                <a href="{{ profileUrl }}" class="mobile-user-block mobile-user-link">
                    {% if app.user.photoProfil %}
                        <img src="/uploads/profils/{{ app.user.photoProfil }}" class="mobile-avatar" alt="">
                    {% else %}
                        <img src="{{ asset('img/logo/Logo CIrculaire - Final - Football Furies.png') }}" class="mobile-avatar" alt="">
                    {% endif %}
                    <p class="mobile-user-name">{{ navbarDisplayName }}</p>
                </a>

                <a href="{{ path('profile_show', { id: app.user.id }) }}" class="ultra-link">{{ 'components_navbar.html.mon_profil'|trans }}</a>
                <a href="{{ path('profile_edit', { id: app.user.id }) }}" class="ultra-link">{{ 'components_navbar.html.modifier_mon_compte'|trans }}</a>
                <a href="{{ path('app_logout') }}" class="ultra-link text-danger">{{ 'components_navbar.html.deconnexion'|trans }}</a>
            {% else %}
                <div class="mobile-submenu">
                    <button type="button" class="ultra-link submenu-toggle" aria-expanded="false">
                        {{ 'components_navbar.html.connexion'|trans }}
                    </button>
                    <a href="{{ path('app_login') }}" class="ultra-link sub">{{ 'components_navbar.html.se_connecter'|trans }}</a>
                    <a href="{{ path('invitation_check') }}" class="ultra-link sub">{{ 'components_navbar.html.sinscrire'|trans }}</a>
                </div>
            {% endif %}

        </div>
    </nav>
</header>
