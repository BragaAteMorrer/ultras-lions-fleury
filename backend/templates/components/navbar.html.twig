<header class="ultra-header">

    <div class="ultra-topband">
        <div class="container d-flex align-items-center justify-content-between">

            {# LOGO #}
            <a href="{{ path('home') }}" class="ultra-brand d-flex align-items-center">
                <img src="{{ asset('assets/img/logo/Logo Texte.png') }}" class="ultra-logo" alt="Ultras Lions">
            </a>

            {# BURGER MOBILE #}
            <button class="ultra-burger d-lg-none" id="ultraNavToggle">
                <span></span><span></span><span></span>
            </button>

            {# --- MENU DESKTOP --- #}
            <nav class="ultra-nav d-none d-lg-flex align-items-center">

                <a href="{{ path('home') }}"
                   class="ultra-link {{ app.request.get('_route') == 'home' ? 'active' }}">
                    Accueil
                </a>

                <a href="{{ path('post_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'post_' ? 'active' }}">
                    Actualités
                </a>

                <div class="dropdown">
                    <a href="#"
                       class="ultra-link dropdown-toggle {{ app.request.get('_route') starts with 'event_' ? 'active' }}"
                       id="eventDropdown"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        Photos de match
                    </a>
                    <ul class="dropdown-menu ultra-dropdown" aria-labelledby="eventDropdown">
                        <li>
                            <a class="dropdown-item" href="{{ path('event_index') }}">
                                Toutes les saisons
                            </a>
                        </li>
                        {% set currentYear = "now"|date("Y") %}
                        {% for year in (currentYear - 2)..(currentYear + 2) %}
                            {% set seasonValue = year ~ '-' ~ (year + 1) %}
                            <li>
                                <a class="dropdown-item" href="{{ path('event_index', { season: seasonValue }) }}">
                                    Saison {{ year }}/{{ year + 1 }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <a href="{{ path('gallery_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'gallery_' ? 'active' }}">
                    Galeries
                </a>

                <a href="{{ path('merch_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'merch_' ? 'active' }}">
                    Table de Vente
                </a>

                <a href="{{ path('ticket_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'ticket_' ? 'active' }}">
                    Billetterie
                </a>

                <a href="{{ path('group_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'group_' ? 'active' }}">
                    Le Groupe
                </a>

                {# ----- DROPDOWN USER ----- #}
                {% if app.user %}
                    <div class="dropdown user-nav">
                        <a class="ultra-link dropdown-toggle d-flex align-items-center"
                           href="#" id="userDropdown"
                           data-bs-toggle="dropdown" aria-expanded="false">

                            {% if app.user.photoProfil %}
                                <img src="/uploads/profils/{{ app.user.photoProfil }}"
                                     class="user-avatar-menu me-2">
                            {% else %}
                                <img src="/assets/img/default-profile.png"
                                     class="user-avatar-menu me-2">
                            {% endif %}

                            {{ app.user.pseudo }}
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end ultra-dropdown" aria-labelledby="userDropdown">
                            <li>
                                <a class="dropdown-item" href="{{ path('profile_show', { id: app.user.id }) }}">
                                    👤 Mon profil
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('profile_edit', { id: app.user.id }) }}">
                                    ✏️ Modifier mon compte
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    🚪 Déconnexion
                                </a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <div class="ultra-user-menu dropdown">
                        <a class="ultra-link dropdown-toggle" href="#" id="loginDropdown"
                        role="button" data-bs-toggle="dropdown">
                            🔐 Connexion
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end ultra-dropdown">

                            <li>
                                <a class="dropdown-item" href="{{ path('app_login') }}">
                                    🔑 Se connecter
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="{{ path('invitation_check') }}">
                                    🎟 S'Inscrire
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}

            </nav>
        </div>

        {# --- MENU MOBILE --- #}
        <nav class="ultra-nav-mobile d-lg-none" id="ultraNavMobile">

            <a href="{{ path('home') }}" class="ultra-link">Accueil</a>
            <a href="{{ path('post_index') }}" class="ultra-link">Actualités</a>
            <div class="mobile-submenu">
                <a href="{{ path('event_index') }}" class="ultra-link">Photos de match</a>
                {% set currentYear = "now"|date("Y") %}
                {% for year in (currentYear - 2)..(currentYear + 2) %}
                    {% set seasonValue = year ~ '-' ~ (year + 1) %}
                    <a href="{{ path('event_index', { season: seasonValue }) }}" class="ultra-link sub">
                        Saison {{ year }}/{{ year + 1 }}
                    </a>
                {% endfor %}
            </div>
            <a href="{{ path('gallery_index') }}" class="ultra-link">Galeries</a>
            <a href="{{ path('merch_index') }}" class="ultra-link">Table de Vente</a>
            <a href="{{ path('ticket_index') }}" class="ultra-link">Billetterie</a>
            <a href="{{ path('group_index') }}" class="ultra-link">Le Groupe</a>

            <hr>

            {% if app.user %}
                <div class="mobile-user-block">
                    {% if app.user.photoProfil %}
                        <img src="/uploads/profils/{{ app.user.photoProfil }}" class="mobile-avatar">
                    {% endif %}
                    <p class="mobile-user-name">{{ app.user.pseudo }}</p>
                </div>

                <a href="{{ path('profile_show', { id: app.user.id }) }}" class="ultra-link">
                    👤 Mon profil
                </a>
                <a href="{{ path('profile_edit', { id: app.user.id }) }}" class="ultra-link">
                    ✏️ Modifier mon compte
                </a>
                <a href="{{ path('app_logout') }}" class="ultra-link text-danger">
                    🚪 Déconnexion
                </a>
            {% else %}
                <div class="mobile-submenu">
                    <a class="ultra-link">🔐 Connexion</a>

                    <a href="{{ path('app_login') }}" class="ultra-link sub">🔑 Se connecter</a>
                    <a href="{{ path('invitation_check') }}" class="ultra-link sub">🎟 Saisir un code</a>
                </div>
            {% endif %}
        </nav>

    </div>
</header>
