{% set merchCart = app.session ? app.session.get('cart_merch') : [] %}
{% set ticketCart = app.session ? app.session.get('cart_ticket') : [] %}
{% set merchCount = 0 %}
{% for row in merchCart %}
    {% set merchCount = merchCount + (row.quantity ?? 0) %}
{% endfor %}
{% set ticketCount = 0 %}
{% for row in ticketCart %}
    {% set ticketCount = ticketCount + (row.quantity ?? 0) %}
{% endfor %}
{% set cartCount = merchCount + ticketCount %}
{% set cartUrl = path('cart_index') %}
{% set navbarDisplayName = null %}
{% if app.user %}
    {% set navbarDisplayName = app.user.prenom ?: (app.user.email ? app.user.email|split('@')|first : 'Compte') %}
{% endif %}

<header class="ultra-header">

    <div class="ultra-topband">
        <div class="container d-flex align-items-center justify-content-between">

            <a href="{{ path('home') }}" class="ultra-brand d-flex align-items-center">
                <img src="{{ asset('img/logo/Logo Texte.png') }}" class="ultra-logo" alt="{{ 'components_footer.html.ultras_lions'|trans }}">
            </a>

            <button class="ultra-burger d-lg-none" id="ultraNavToggle">
                <span></span><span></span><span></span>
            </button>

            <nav class="ultra-nav d-none d-lg-flex align-items-center">

                <a href="{{ path('home') }}"
                   class="ultra-link {{ app.request.get('_route') == 'home' ? 'active' }}">{{ 'components_navbar.html.accueil'|trans }}</a>

                <a href="{{ path('post_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'post_' ? 'active' }}">{{ 'components_navbar.html.actualites'|trans }}</a>

                <div class="dropdown">
                    <a href="{{ path('media_index') }}"
                       class="ultra-link dropdown-toggle {{ (app.request.get('_route') starts with 'event_') or (app.request.get('_route') starts with 'gallery_') or (app.request.get('_route') starts with 'media_') ? 'active' }}"
                       id="eventDropdown"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">Media
                    </a>
                    <ul class="dropdown-menu ultra-dropdown" aria-labelledby="eventDropdown">
                        <li>
                            <a class="dropdown-item" href="{{ path('media_index') }}">
                                Tous les medias
                            </a>
                        </li>
                        <li class="dropdown-submenu">
                            <a class="dropdown-item dropdown-toggle" href="{{ path('gamephoto_index') }}">
                                {{ 'components_navbar.html.photos_de_match'|trans }}
                            </a>
                            <ul class="dropdown-menu ultra-dropdown">
                                {% for seasonValue in event_seasons %}
                                    {% set parts = seasonValue|split('-') %}
                                    {% set yearStart = parts|first %}
                                    {% set yearEnd = parts|last %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('gamephoto_index', { season: seasonValue }) }}">
                                            {{ 'components_navbar.html.saison'|trans({'%year_start%': yearStart, '%year_end%': yearEnd}) }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        {% for mediaCategory in event_media_categories %}
                            <li>
                                <a class="dropdown-item" href="{{ path('media_category', { slug: mediaCategory.slug }) }}">
                                    {{ mediaCategory.name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <a href="{{ path('chant_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'chant_' ? 'active' }}">{{ 'components_navbar.html.chants'|trans }}</a>

                <a href="{{ path('merch_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'merch_' ? 'active' }}">{{ 'components_navbar.html.table_de_vente'|trans }}</a>

                <a href="{{ path('ticket_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'ticket_' ? 'active' }}">{{ 'components_navbar.html.billetterie'|trans }}</a>

                <a href="{{ path('group_index') }}"
                   class="ultra-link {{ app.request.get('_route') starts with 'group_' ? 'active' }}" aria-expanded="false">{{ 'components_navbar.html.le_groupe'|trans }}</a>

                {% if app.user %}
                    <div class="dropdown user-nav">
                        <a class="ultra-link dropdown-toggle d-flex align-items-center user-nav-trigger"
                           href="#" id="userDropdown"
                           data-bs-toggle="dropdown" aria-expanded="false">

                            {% if app.user.photoProfil %}
                                <img src="/uploads/profils/{{ app.user.photoProfil }}"
                                     class="user-avatar-menu me-2">
                            {% else %}
                                <img src="{{ asset('img/logo/Logo CIrculaire - Final - Football Furies.png') }}"
                                     class="user-avatar-menu me-2">
                            {% endif %}

                            <span class="user-nav-label">{{ navbarDisplayName }}</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end ultra-dropdown" aria-labelledby="userDropdown">
                            <li>
                                <a class="dropdown-item" href="{{ path('profile_show', { id: app.user.id }) }}">👤 {{ 'components_navbar.html.mon_profil'|trans }}</a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('profile_edit', { id: app.user.id }) }}">✏{{ 'components_navbar.html.modifier_mon_compte'|trans }}</a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">🚪 {{ 'components_navbar.html.deconnexion'|trans }}</a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <div class="ultra-user-menu dropdown">
                        <a class="ultra-link dropdown-toggle" href="#" id="loginDropdown"
                        role="button" data-bs-toggle="dropdown">🔐 {{ 'components_navbar.html.connexion'|trans }}</a>

                        <ul class="dropdown-menu dropdown-menu-end ultra-dropdown">

                            <li>
                                <a class="dropdown-item" href="{{ path('app_login') }}">🔑 {{ 'components_navbar.html.se_connecter'|trans }}</a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="{{ path('invitation_check') }}">🎟 {{ 'components_navbar.html.sinscrire'|trans }}</a>
                            </li>
                        </ul>
                    </div>
                {% endif %}

                {% if cartCount > 0 %}
                    <a href="{{ cartUrl }}" class="ultra-link" aria-label="Panier">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7 6H21L19.5 14H8L7 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                            <path d="M5 6H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M9 18.5C9.82843 18.5 10.5 17.8284 10.5 17C10.5 16.1716 9.82843 15.5 9 15.5C8.17157 15.5 7.5 16.1716 7.5 17C7.5 17.8284 8.17157 18.5 9 18.5Z" fill="currentColor"/>
                            <path d="M18 18.5C18.8284 18.5 19.5 17.8284 19.5 17C19.5 16.1716 18.8284 15.5 18 15.5C17.1716 15.5 16.5 16.1716 16.5 17C16.5 17.8284 17.1716 18.5 18 18.5Z" fill="currentColor"/>
                        </svg>
                    </a>
                {% endif %}

            </nav>
        </div>

        <nav class="ultra-nav-mobile d-lg-none" id="ultraNavMobile">

            {% if cartCount > 0 %}
            <a href="{{ cartUrl }}" class="ultra-link" aria-label="Panier">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 6H21L19.5 14H8L7 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M5 6H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M9 18.5C9.82843 18.5 10.5 17.8284 10.5 17C10.5 16.1716 9.82843 15.5 9 15.5C8.17157 15.5 7.5 16.1716 7.5 17C7.5 17.8284 8.17157 18.5 9 18.5Z" fill="currentColor"/>
                    <path d="M18 18.5C18.8284 18.5 19.5 17.8284 19.5 17C19.5 16.1716 18.8284 15.5 18 15.5C17.1716 15.5 16.5 16.1716 16.5 17C16.5 17.8284 17.1716 18.5 18 18.5Z" fill="currentColor"/>
                </svg>
            </a>
            {% endif %}
            <a href="{{ path('home') }}" class="ultra-link">{{ 'components_navbar.html.accueil'|trans }}</a>
            <div class="mobile-submenu">
                <button type="button" class="ultra-link submenu-toggle" aria-expanded="false">
                    {{ 'components_navbar.html.le_groupe'|trans }}
                </button>
                <a href="{{ path('group_index') ~ '#notre-histoire' }}" class="ultra-link sub">
                    {{ 'components_navbar.html.notre_histoire'|trans }}
                </a>
                <a href="{{ path('group_index') ~ '#notre-mentalite' }}" class="ultra-link sub">
                    {{ 'components_navbar.html.notre_mentalite'|trans }}
                </a>
                <a href="{{ path('group_index') ~ '#notre-fonctionnement' }}" class="ultra-link sub">
                    {{ 'components_navbar.html.notre_fonctionnement'|trans }}
                </a>
                <a href="{{ path('group_index') ~ '#pourquoi-nous-rejoindre' }}" class="ultra-link sub">
                    {{ 'components_navbar.html.pourquoi_nous_rejoindre'|trans }}
                </a>
            </div>
            <a href="{{ path('post_index') }}" class="ultra-link">{{ 'components_navbar.html.actualites'|trans }}</a>
            <a href="{{ path('chant_index') }}" class="ultra-link">{{ 'components_navbar.html.chants'|trans }}</a>
            <div class="mobile-submenu">
                <button type="button" class="ultra-link submenu-toggle" aria-expanded="false">
                    Media
                </button>
                <a href="{{ path('media_index') }}" class="ultra-link sub">Tous les medias</a>
                <a href="{{ path('gamephoto_index') }}" class="ultra-link sub">{{ 'components_navbar.html.photos_de_match'|trans }}</a>
                {% for mediaCategory in event_media_categories %}
                    <a href="{{ path('media_category', { slug: mediaCategory.slug }) }}" class="ultra-link sub">
                        {{ mediaCategory.name }}
                    </a>
                {% endfor %}
                {% for seasonValue in event_seasons %}
                    {% set parts = seasonValue|split('-') %}
                    {% set yearStart = parts|first %}
                    {% set yearEnd = parts|last %}
                    <a href="{{ path('gamephoto_index', { season: seasonValue }) }}" class="ultra-link sub">
                        {{ 'components_navbar.html.saison'|trans({'%year_start%': yearStart, '%year_end%': yearEnd}) }}
                    </a>
                {% endfor %}
            </div>
            <a href="{{ path('merch_index') }}" class="ultra-link">{{ 'components_navbar.html.table_de_vente'|trans }}</a>
            <a href="{{ path('ticket_index') }}" class="ultra-link">{{ 'components_navbar.html.billetterie'|trans }}</a>
                        <hr>

            {% if app.user %}
                <div class="mobile-user-block">
                    {% if app.user.photoProfil %}
                        <img src="/uploads/profils/{{ app.user.photoProfil }}" class="mobile-avatar">
                    {% endif %}
                    <p class="mobile-user-name">{{ navbarDisplayName }}</p>
                </div>

                <a href="{{ path('profile_show', { id: app.user.id }) }}" class="ultra-link">👤 {{ 'components_navbar.html.mon_profil'|trans }}</a>
                <a href="{{ path('profile_edit', { id: app.user.id }) }}" class="ultra-link">✏{{ 'components_navbar.html.modifier_mon_compte'|trans }}</a>
                <a href="{{ path('app_logout') }}" class="ultra-link text-danger">🚪 {{ 'components_navbar.html.deconnexion'|trans }}</a>
            {% else %}
                <div class="mobile-submenu">
                    <button type="button" class="ultra-link submenu-toggle" aria-expanded="false">
                        🔐 {{ 'components_navbar.html.connexion'|trans }}
                    </button>

                    <a href="{{ path('app_login') }}" class="ultra-link sub">🔑 {{ 'components_navbar.html.se_connecter'|trans }}</a>
                    <a href="{{ path('invitation_check') }}" class="ultra-link sub">🎟 {{ 'components_navbar.html.saisir_un_code'|trans }}</a>
                </div>
                <a></a>
            {% endif %}
        </nav>

    </div>
</header>
