{% extends 'base.html.twig' %}

{% block title %}{{ 'home_index.html.ultras_lions_i_fc_fleury_91'|trans }}{% endblock %}

{% block body %}

<section class="hero home-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <img src="{{ asset('img/logo/Logo Final - Ultras Lions - Autre Présentation.png') }}" class="hero-ultra-logo" alt="{{ 'components_footer.html.ultras_lions'|trans }}">
        <h1 class="hero-title">{{ site_config.heroTitle|default(null) ?: ('home_index.html.ultras_lions'|trans) }}</h1>
        <p class="hero-subtitle">{{ site_config.heroSubtitle|default(null) ?: ('home_index.html.le_site_web_du_groupe_ultras_du_fc_fleury_91'|trans) }}</p>
    </div>
</section>

{# ------------------------------
   DERNIERES ACTUALITES (POSTS + EVENEMENTS)
   ------------------------------ #}
<section class="section latest-news">
    <div class="container">
        <h2 class="section-title">{{ 'home_index.html.dernieres_actualites'|trans }}</h2>

        <div class="row g-4">
            {% for entry in latest_items %}
                {% set item = entry.item %}
                <div class="col-md-4">
                    {% if entry.type == 'post' %}
                        <a href="{{ path('post_show', { slug: item.slug }) }}" class="card h-100">

                            {% if item.image %}
                                {% include 'components/media.html.twig' with { media: item.image, class: 'card-img-top', alt: item.title } %}
                            {% endif %}

                            <div class="card-body">
                                <span class="badge bg-danger text-uppercase mb-2">Article</span>
                                <h3 class="card-title">{{ item.title }}</h3>
                                <p class="card-text">{{ item.content|striptags|slice(0,120) ~ '...' }}</p>
                            </div>

                        </a>
                    {% else %}
                        <a href="{{ path('event_show', { id: item.id }) }}" class="card h-100">

                            {% set cover = item.image ?: (item.media|first) %}
                            {% if cover %}
                                {% include 'components/media.html.twig' with { media: cover, class: 'card-img-top', alt: item.title } %}
                            {% endif %}

                            <div class="card-body">
                                <span class="badge bg-dark text-uppercase mb-2">
                                    {{ item.category ? item.category.name : 'Evenement' }}
                                </span>
                                <h3 class="card-title">{{ item.title }}</h3>
                                {% if item.date %}
                                    <p class="card-text">{{ item.date|date('d/m/Y') }}</p>
                                {% endif %}
                            </div>

                        </a>
                    {% endif %}
                </div>
            {% else %}
                <p>{{ 'home_index.html.aucune_actualite_disponible'|trans }}</p>
            {% endfor %}
        </div>
    </div>
</section>

{# ------------------------------
   BILLETTERIE (3 PROCHAINS MATCHS)
   ------------------------------ #}
<section class="section next-event">
    <div class="container">
        <h2 class="section-title">{{ 'components_navbar.html.billetterie'|trans }}</h2>

        <div class="row g-4">
            {% for ticket in tickets %}
                            {% set isAway = ticket.matchLocation|default('')|lower|trim == 'exterieur'
                                or (ticket.matchLocation is empty and ticket.category and ticket.category.slug == 'ext') %}
                            {% set matchLabel = isAway
                                ? ticket.opponent ~ ' vs FC Fleury'
                                : 'FC Fleury vs ' ~ ticket.opponent %}
                <div class="col-md-4">
                    <a href="{{ path('ticket_show', { id: ticket.id }) }}" class="card h-100">
                        {% if ticket.image %}
                            {% include 'components/media.html.twig' with { media: ticket.image, class: 'card-img-top', alt: ticket.title } %}
                        {% endif %}

                        <div class="card-body">
                            <h3 class="card-title">{{ matchLabel }}</h3>
                            {% if ticket.matchLocation %}
                                <span class="badge bg-secondary text-uppercase mb-2">
                                    {{ ticket.matchLocation == 'domicile' ? 'Domicile' : 'Extérieur' }}
                                </span>
                            {% endif %}
                            <p class="card-text">
                                {{ ticket.matchDate|date('d/m/Y H:i') }}
                                {% if ticket.venue %} - {{ ticket.venue }}{% endif %}
                            </p>
                            {% if ticket.usesBilletweb %}
                                <p class="card-text fw-bold">Billetterie Billetweb</p>
                            {% else %}
                                <p class="card-text fw-bold">{{ ticket.price|number_format(2, ',', ' ') }} €</p>
                            {% endif %}
                        </div>
                    </a>
                </div>
            {% else %}
                <p>{{ 'home_index.html.aucun_evenement_prevu'|trans }}</p>
            {% endfor %}
        </div>

        <div class="mt-3">
            <a href="{{ path('ticket_index') }}" class="btn-ul">{{ 'ticket_list.html.billetterie_ultras_lions'|trans }}</a>
        </div>
    </div>
</section>

{# ------------------------------
   GALERIES
   ------------------------------ #}
<section class="section galleries">
    <div class="container">
    <h2 class="section-title">{{ 'home_index.html.galeries_photos'|trans }}</h2>
        <div class="cards">
            {% for gal in galleries %}
                <a href="{{ path('gallery_show', { id: gal.id }) }}" class="card">

                    {% set cover = gal.media|first %}
                    {% if cover %}
                        {% include 'components/media.html.twig' with { media: cover, alt: gal.title } %}
                    {% endif %}

                    <div class="card-content">
                        <h3>{{ gal.title }}</h3>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

{% if gadgets is defined and gadgets|length > 0 %}
<section class="section gadgets-section">
    <div class="container">
        <div class="section-heading-row">
            <h2 class="section-title">Gadgets du groupe</h2>
            <a href="{{ path('gadget_index') }}" class="section-link">Tout voir</a>
        </div>

        <div class="gadgets-grid">
            {% for gadget in gadgets %}
                <a href="{{ path('gadget_index') }}" class="gadget-card">
                    <div class="gadget-card-media">
                        {% if gadget.image %}
                            {% include 'components/media.html.twig' with { media: gadget.image, alt: gadget.title } %}
                        {% else %}
                            <span>UL</span>
                        {% endif %}
                    </div>
                    <div class="gadget-card-body">
                        {% if gadget.productionLabel %}
                            <span class="gadget-card-kicker">{{ gadget.productionLabel }}</span>
                        {% endif %}
                        <h3>{{ gadget.title }}</h3>
                        {% if gadget.description %}
                            <p>{{ gadget.description|striptags|slice(0, 95) ~ '...' }}</p>
                        {% endif %}
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ------------------------------
   LE GROUPE
   ------------------------------ #}
<section class="section about-group">
    <div class="container">
        <h2 class="section-title">{{ 'components_navbar.html.se_carter'|trans }}</h2>

        {% if group %}
            <div class="group-section" id="se-carter">
                {% set seCarterText = (group and group.seCarterText) ? group.seCarterText : 'Passe � la table de vente les jours de match, r�cup�re ton code, puis inscris-toi pour acc�der � l�espace membres.' %}
                <div class="rich-content">
                {% if group and group.seCarterText %}
                    {{ seCarterText|raw }}
                {% else %}
                    {{ seCarterText|nl2br }}
                {% endif %}
            </div>
            {% else %}
                <p>{{ 'home_index.html.aucune_information_de_groupe_na_encore_ete_ajoutee'|trans }}</p>
            {% endif %}
        </div>
</section>

{% endblock %}
