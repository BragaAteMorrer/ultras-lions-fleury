{% extends 'base.html.twig' %}

{% block title %}{{ 'home_index.html.ultras_lions_i_fc_fleury_91'|trans }}{% endblock %}

{% block body %}

{% set hero_images = [
    asset('img/fond/fond1a.jpg'),
    asset('img/fond/fond1b.jpg'),
    asset('img/fond/fond2.jpg')
] %}
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <img src="{{ asset('img/logo/Logo Final - Ultras Lions - Autre Présentation.png') }}" class="hero-ultra-logo" alt="{{ 'components_footer.html.ultras_lions'|trans }}">
        <h1 class="hero-title">{{ 'home_index.html.ultras_lions'|trans }}</h1>
        <p class="hero-subtitle">{{ 'home_index.html.le_site_web_du_groupe_ultras_du_fc_fleury_91'|trans }}</p>
    </div>

{# ------------------------------
   DERNIÃˆRES ACTUALITÃ‰S (POSTS)
   ------------------------------ #}
<section class="section latest-news">
    <div class="container">
        <h2 class="section-title">{{ 'home_index.html.dernieres_actualites'|trans }}</h2>

        <div class="row g-4">
            {% for post in last_posts %}
                <div class="col-md-4">
                    <a href="{{ path('post_show', { slug: post.slug }) }}" class="card h-100">

                        {% if post.image %}
                            <img src="{{ asset('uploads/media/' ~ post.image.path) }}" class="card-img-top" alt="{{ post.title }}">
                        {% endif %}

                        <div class="card-body">
                            <h3 class="card-title">{{ post.title }}</h3>
                            <p class="card-text">{{ post.content|striptags|slice(0,120) ~ '...' }}</p>
                        </div>

                    </a>
                </div>
            {% else %}
                <p>{{ 'home_index.html.aucune_actualite_disponible'|trans }}</p>
            {% endfor %}
        </div>
    </div>
</section>

{# ------------------------------
   PROCHAIN EVENT
   ------------------------------ #}
<section class="section next-event">
    <div class="container">
        <h2 class="section-title">{{ 'home_index.html.prochain_deplacement'|trans }}</h2>

        {% if event %}
            <div class="event-box">
                {% set eventCover = event.image ?: (event.media|first) %}
                {% if eventCover %}
                    <img src="{{ asset('uploads/media/' ~ eventCover.path) }}" class="img-fluid rounded shadow mb-3" alt="{{ event.title }}">
                {% endif %}
                <h3>{{ event.title }}</h3>
                <p class="event-date">ðŸ“… {{ event.date|date("d/m/Y") }}</p>

                <a href="{{ path('gamephoto_index') }}" class="btn-ul">{{ 'home_index.html.voir_les_evenements'|trans }}</a>
            </div>
        {% else %}
            <p>{{ 'home_index.html.aucun_evenement_prevu'|trans }}</p>
        {% endif %}
    </div>
</section>

{# ------------------------------
   GALERIES
   ------------------------------ #}
<section class="section galleries">
    <div class="container">
    <h2 class="section-title">{{ 'home_index.html.galeries_photos'|trans }}</h2>
        <div class="cards">
            {% for gal in galleries %}
                <a href="{{ path('gallery_show', { id: gal.id }) }}" class="card">

                    {% set cover = gal.media|first %}
                    {% if cover %}
                        <img src="{{ asset('uploads/media/' ~ cover.path) }}" alt="{{ gal.title }}">
                    {% endif %}

                    <div class="card-content">
                        <h3>{{ gal.title }}</h3>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

{# ------------------------------
   LE GROUPE
   ------------------------------ #}
<section class="section about-group">
    <div class="container">
        <h2 class="section-title">{{ 'components_navbar.html.le_groupe'|trans }}</h2>

        {% if group %}
            <div class="group-content">
                {{ group.description|raw }}
            </div>

            {% if group.banner %}
                <img class="group-banner" 
                    src="{{ asset('uploads/media/' ~ group.banner.path) }}" 
                    alt="{{ 'home_index.html.banniere_du_groupe'|trans }}">
            {% endif %}
        {% else %}
            <p>{{ 'home_index.html.aucune_information_de_groupe_na_encore_ete_ajoutee'|trans }}</p>
        {% endif %}
    </div>
</section>

{% endblock %}




