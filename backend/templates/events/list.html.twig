{% extends 'base.html.twig' %}

{% block title %}{{ 'events_list.html.deplacements_evenements_ultras_lions'|trans }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ 'events_list.html.deplacements_evenements'|trans }}</h1>
        <p class="hero-subtitle">{{ 'events_list.html.prochains_matchs_rassemblements_actions'|trans }}</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <form method="get" class="mb-4" style="max-width: 22rem;">
            <label class="form-label text-light" for="season">{{ 'events_list.html.saison'|trans }}</label>
            <div class="d-flex gap-2">
                <select id="season" name="season" class="form-select">
                    <option value="" {% if selectedSeason is empty %}selected{% endif %}>{{ 'components_navbar.html.toutes_les_saisons'|trans }}</option>
                    {% for season in seasons %}
                        <option value="{{ season }}" {% if selectedSeason == season %}selected{% endif %}>
                            {{ season|replace({'-': '/'}) }}
                        </option>
                    {% endfor %}
                </select>
                <button class="btn btn-outline-light" type="submit">{{ 'events_list.html.filtrer'|trans }}</button>
            </div>
        </form>

        <h2 class="section-title">{{ 'components_navbar.html.photos_de_match'|trans }}</h2>

        <div class="event-list">
            {% for event in deplacements %}
                <article class="event-item">
                    {% set cover = event.image ?: (event.media|first) %}
                    {% if cover %}
                        <a href="{{ path('event_show', { id: event.id }) }}" class="card mb-3">
                            <img src="{{ asset('uploads/media/' ~ cover.path) }}" class="event-card-img-top" alt="{{ event.title }}">
                        </a>
                    {% endif %}

                    <div class="event-date-block">
                        {% if event.date %}
                            <div class="event-date-day">{{ event.date|date('d') }}</div>
                            <div class="event-date-month">{{ event.date|date('M')|upper }}</div>
                        {% else %}
                            <div class="event-date-day">?</div>
                            <div class="event-date-month">---</div>
                        {% endif %}
                    </div>

                    <div class="event-content">
                        <h3>
                            <a href="{{ path('event_show', { id: event.id }) }}">
                                {{ event.title }}
                            </a>
                        </h3>

                        <div class="event-meta">
                            {# Ces champs n'existent pas, je les enlève ou tu me diras si on les rajoute #}
                        </div>
                    </div>

                </article>
            {% else %}
                <p>{{ 'events_list.html.aucune_photo_de_match_pour_le_moment'|trans }}</p>
            {% endfor %}
        </div>

        <h2 class="section-title mt-5">{{ 'admin_dashboard.html.evenements'|trans }}</h2>

        <div class="event-list">
            {% for event in events %}
                <article class="event-item">
                    {% set cover = event.image ?: (event.media|first) %}
                    {% if cover %}
                        <a href="{{ path('event_show', { id: event.id }) }}" class="card mb-3">
                            <img src="{{ asset('uploads/media/' ~ cover.path) }}" class="event-card-img-top" alt="{{ event.title }}">
                        </a>
                    {% endif %}

                    <div class="event-date-block">
                        {% if event.date %}
                            <div class="event-date-day">{{ event.date|date('d') }}</div>
                            <div class="event-date-month">{{ event.date|date('M')|upper }}</div>
                        {% else %}
                            <div class="event-date-day">?</div>
                            <div class="event-date-month">---</div>
                        {% endif %}
                    </div>

                    <div class="event-content">
                        <h3>
                            <a href="{{ path('event_show', { id: event.id }) }}">
                                {{ event.title }}
                            </a>
                        </h3>
                    </div>
                </article>
            {% else %}
                <p>{{ 'events_list.html.aucun_evenement_pour_le_moment'|trans }}</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
