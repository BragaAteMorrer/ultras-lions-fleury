{% extends 'base.html.twig' %}

{% block title %}Déplacements & événements – Ultras Lions{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Déplacements & événements</h1>
        <p class="hero-subtitle">Prochains matchs, rassemblements, actions</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <form method="get" class="mb-4" style="max-width: 22rem;">
            <label class="form-label text-light" for="season">Saison</label>
            <div class="d-flex gap-2">
                <select id="season" name="season" class="form-select">
                    <option value="" {% if selectedSeason is empty %}selected{% endif %}>Toutes les saisons</option>
                    {% for season in seasons %}
                        <option value="{{ season }}" {% if selectedSeason == season %}selected{% endif %}>
                            {{ season|replace({'-': '/'}) }}
                        </option>
                    {% endfor %}
                </select>
                <button class="btn btn-outline-light" type="submit">Filtrer</button>
            </div>
        </form>

        <h2 class="section-title">Photos de match</h2>

        <div class="event-list">
            {% for event in deplacements %}
                <article class="event-item">
                    {% set cover = event.image ?: (event.media|first) %}
                    {% if cover %}
                        <a href="{{ path('event_show', { id: event.id }) }}" class="card mb-3">
                            <img src="{{ asset('uploads/media/' ~ cover.path) }}" class="event-card-img-top" alt="{{ event.title }}">
                        </a>
                    {% endif %}

                    <div class="event-date-block">
                        {% if event.date %}
                            <div class="event-date-day">{{ event.date|date('d') }}</div>
                            <div class="event-date-month">{{ event.date|date('M')|upper }}</div>
                        {% else %}
                            <div class="event-date-day">?</div>
                            <div class="event-date-month">---</div>
                        {% endif %}
                    </div>

                    <div class="event-content">
                        <h3>
                            <a href="{{ path('event_show', { id: event.id }) }}">
                                {{ event.title }}
                            </a>
                        </h3>

                        <div class="event-meta">
                            {# Ces champs n'existent pas, je les enlève ou tu me diras si on les rajoute #}
                        </div>
                    </div>

                </article>
            {% else %}
                <p>Aucune photo de match pour le moment.</p>
            {% endfor %}
        </div>

        <h2 class="section-title mt-5">Événements</h2>

        <div class="event-list">
            {% for event in events %}
                <article class="event-item">
                    {% set cover = event.image ?: (event.media|first) %}
                    {% if cover %}
                        <a href="{{ path('event_show', { id: event.id }) }}" class="card mb-3">
                            <img src="{{ asset('uploads/media/' ~ cover.path) }}" class="event-card-img-top" alt="{{ event.title }}">
                        </a>
                    {% endif %}

                    <div class="event-date-block">
                        {% if event.date %}
                            <div class="event-date-day">{{ event.date|date('d') }}</div>
                            <div class="event-date-month">{{ event.date|date('M')|upper }}</div>
                        {% else %}
                            <div class="event-date-day">?</div>
                            <div class="event-date-month">---</div>
                        {% endif %}
                    </div>

                    <div class="event-content">
                        <h3>
                            <a href="{{ path('event_show', { id: event.id }) }}">
                                {{ event.title }}
                            </a>
                        </h3>
                    </div>
                </article>
            {% else %}
                <p>Aucun événement pour le moment.</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
