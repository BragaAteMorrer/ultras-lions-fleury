{% extends 'base.html.twig' %}

{% block title %}{{ 'events_show.html.title'|trans({'%title%': event.title}) }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ event.title }}</h1>
        {% if event.date %}
            <p class="hero-subtitle">📅 {{ event.date|date('d/m/Y') }}</p>
        {% endif %}
    </div>
</section>

<div class="section">
    <div class="container">

        <article class="event-show">
            {% set cover = event.image ?: (event.media|first) %}
            {% if cover or event.media|length > 0 %}
                <div class="cards gallery-grid mb-4">
                    {% if cover and cover.path %}
                        {% if cover.video %}
                            <div class="card">
                                {% include 'components/media.html.twig' with { media: cover, alt: event.title, controls: true } %}
                            </div>
                        {% else %}
                            <a href="{{ asset('uploads/media/' ~ cover.path) }}" class="card" data-lightbox="event-gallery">
                                {% include 'components/media.html.twig' with { media: cover, alt: event.title } %}
                            </a>
                        {% endif %}
                    {% endif %}

                    {% for media in event.media %}
                        {% if media.path and (not cover or media.id != cover.id) %}
                            {% if media.video %}
                                <div class="card">
                                    {% include 'components/media.html.twig' with { media: media, alt: event.title, controls: true } %}
                                </div>
                            {% else %}
                                <a href="{{ asset('uploads/media/' ~ media.path) }}" class="card" data-lightbox="event-gallery">
                                    {% include 'components/media.html.twig' with { media: media, alt: event.title } %}
                                </a>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            {% if event.description %}
                <div class="event-show-body rich-content">
                    {{ event.description|raw }}
                </div>
            {% endif %}

        </article>

    </div>
</div>
{% endblock %}
