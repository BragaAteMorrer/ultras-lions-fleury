{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ category.name }}</h1>
        <p class="hero-subtitle">{{ 'galleries_list.html.tribunes_deplacements_tifos_vie_du_groupe'|trans }}</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <div class="row g-4">
            {% for event in events %}
                <div class="col-md-4">
                    <a href="{{ path('event_show', { id: event.id }) }}" class="card h-100">
                        {% set cover = event.image ?: (event.media|first) %}
                        {% if cover %}
                            {% include 'components/media.html.twig' with { media: cover, class: 'event-card-img-top', alt: event.title } %}
                        {% else %}
                            <img src="/placeholder.jpg" class="event-card-img-top" alt="{{ event.title }}">
                        {% endif %}

                        <div class="card-body">
                            <h3 class="card-title">{{ event.title }}</h3>
                            {% if event.category %}
                                <p class="text-muted mb-1">{{ event.category.name }}</p>
                            {% endif %}
                            {% if event.date %}
                                <p class="mb-1">{{ event.date|date('d/m/Y') }}</p>
                            {% endif %}
                            {% if event.description %}
                                <p class="mb-0">{{ event.description|striptags|slice(0, 90) ~ '...' }}</p>
                            {% endif %}
                        </div>
                    </a>
                </div>
            {% else %}
                <p>{{ 'events_list.html.aucun_evenement_pour_le_moment'|trans }}</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
