{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
{% set locale = app.request.locale|default('fr') %}

<section class="hero events-hero">
    <div class="hero-content events-hero-content">
        <div class="events-hero-copy">
            <span class="events-hero-kicker">{{ 'galleries_list.html.tribunes_deplacements_tifos_vie_du_groupe'|trans }}</span>
            <h1 class="hero-title">{{ category.name }}</h1>
            <p class="hero-subtitle">{{ 'galleries_list.html.tribunes_deplacements_tifos_vie_du_groupe'|trans }}</p>
        </div>
    </div>
</section>

<div class="section events-section">
    <div class="container">
        <div class="events-grid">
            {% for event in events %}
                {% set cover = event.image ?: (event.media|first) %}
                {% set monthLabel = event.date ? event.date|format_date(locale=locale, pattern='MMM')|upper : null %}
                <article class="event-card-v2">
                    <a href="{{ path('event_show', { id: event.id }) }}" class="event-card-link">
                        <div class="event-card-media">
                            {% if cover %}
                                <img src="{{ asset('uploads/media/' ~ cover.path) }}" class="event-card-image-v2" alt="{{ event.title }}">
                            {% else %}
                                <div class="event-card-placeholder">
                                    <span>{{ category.name }}</span>
                                </div>
                            {% endif %}

                            <div class="event-card-overlay">
                                <span class="event-card-badge">{{ category.name }}</span>
                                {% if event.date %}
                                    <span class="event-card-date-badge">
                                        <strong>{{ event.date|format_date(locale=locale, pattern='d') }}</strong>
                                        <em>{{ monthLabel ?: '---' }}</em>
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="event-card-body-v2">
                            <div class="event-card-meta">
                                {% if event.date %}
                                    <span class="event-card-meta-item">
                                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                                        {{ event.date|format_date(locale=locale, pattern='d MMMM yyyy') }}
                                    </span>
                                {% endif %}
                            </div>

                            <h3 class="event-card-title-v2">{{ event.title }}</h3>
                        </div>
                    </a>
                </article>
            {% else %}
                <p>{{ 'events_list.html.aucun_evenement_pour_le_moment'|trans }}</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
