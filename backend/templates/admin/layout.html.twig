<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin Ultras Lions{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="custom-admin">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" href="{{ path('app_admin_dashboard_index') }}">
                <span class="admin-brand-mark">UL</span>
                <span>
                    <strong>Ultras Lions</strong>
                    <small>Administration</small>
                </span>
            </a>

            <nav class="admin-nav" aria-label="Navigation administration">
                {% for group in adminNavigation|default([]) %}
                    <section class="admin-nav-group">
                        <h2>{{ group.label }}</h2>
                        {% for item in group.items %}
                            <a class="admin-nav-link {{ app.request.uri == item.url ? 'active' : '' }}" href="{{ item.url }}">
                                <i class="{{ item.icon }}" aria-hidden="true"></i>
                                <span>{{ item.label }}</span>
                            </a>
                        {% endfor %}
                    </section>
                {% endfor %}
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <p class="admin-kicker">{% block admin_kicker %}Espace admin{% endblock %}</p>
                    <h1>{% block admin_title %}Tableau de bord{% endblock %}</h1>
                </div>
                <div class="admin-topbar-actions">
                    <button type="button" class="btn btn-outline-light btn-sm admin-sidebar-toggle" data-admin-sidebar-toggle>
                        <i class="bi bi-list" aria-hidden="true"></i>
                        Menu
                    </button>
                    {% block admin_actions %}
                        <a class="btn btn-outline-light btn-sm" href="{{ path('home') }}">Voir le site</a>
                    {% endblock %}
                </div>
            </header>

            {% for label, messages in app.flashes %}
                {% set alertClass = label in ['success','warning','danger','info'] ? label : 'secondary' %}
                {% for message in messages %}
                    <div class="alert alert-{{ alertClass }} admin-alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <main class="admin-content">
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

    <div class="admin-sidebar-backdrop" data-admin-sidebar-close hidden></div>
    <div class="modal fade admin-confirm-modal" id="adminConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <div>
                        <p class="admin-kicker mb-1">Confirmation requise</p>
                        <h2 class="modal-title fs-5" id="adminConfirmModalTitle" data-admin-confirm-title>Confirmer l'action ?</h2>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body pt-0">
                    <p class="admin-confirm-modal__message mb-2" data-admin-confirm-message>
                        Cette action sera appliquée immédiatement.
                    </p>
                    <p class="text-white-50 mb-0 small">
                        Vérifie le contexte avant de poursuivre. Les actions administratives sont enregistrées côté serveur.
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-danger" data-admin-confirm-action>
                        Confirmer
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/admin.js') }}" defer></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
