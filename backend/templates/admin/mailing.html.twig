{% extends 'admin/layout.html.twig' %}

{% block title %}{{ 'admin.mailing.html.title'|trans }}{% endblock %}
{% block admin_title %}{{ 'admin.mailing.html.heading'|trans }}{% endblock %}

{% block admin_actions %}
    <button class="btn btn-danger btn-sm" type="submit" form="adminMailingForm">
        <i class="bi bi-envelope" aria-hidden="true"></i>
        {{ 'admin.mailing.html.send'|trans }}
    </button>
{% endblock %}

{% block body %}
    <form method="post" class="admin-mailing" id="adminMailingForm">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_mailing') }}">

        <section class="admin-mailing-panel">
            <div class="admin-mailing-head">
                <div>
                    <p class="admin-kicker">{{ 'admin.mailing.html.communication'|trans }}</p>
                    <h1>{{ 'admin.mailing.html.heading'|trans }}</h1>
                </div>
                <div class="admin-mailing-actions">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        {{ 'admin.mailing.html.send'|trans }}
                    </button>
                </div>
            </div>

            <div class="admin-mailing-grid">
                <div class="admin-mailing-editor">
                    <label class="form-label" for="mailSubject">{{ 'admin.mailing.html.subject'|trans }}</label>
                    <input id="mailSubject" class="form-control" type="text" name="subject" required value="{{ subject }}">

                    <label class="form-label" for="mailBody">{{ 'admin.mailing.html.body'|trans }}</label>
                    <textarea id="mailBody" class="form-control admin-mailing-textarea" name="body" rows="14" required>{{ body }}</textarea>
                    <p class="form-text">{{ 'admin.mailing.html.message_hint'|trans }}</p>
                </div>

                <aside class="admin-mailing-recipients">
                    <div class="admin-mailing-recipients-head">
                        <div>
                            <h2>{{ 'admin.mailing.html.recipients'|trans }}</h2>
                            <p>{{ users|length }} {{ 'admin.mailing.html.users_count_suffix'|trans }}</p>
                        </div>
                        <button class="btn btn-secondary btn-sm" type="button" data-mailing-toggle-users data-label-select-all="{{ 'admin.mailing.html.select_all'|trans }}" data-label-deselect-all="{{ 'admin.mailing.html.deselect_all'|trans }}">
                            {{ 'admin.mailing.html.select_all'|trans }}
                        </button>
                    </div>

                    <div class="admin-mailing-user-list">
                        {% for user in users %}
                            {% set userName = ((user.prenom ?? '') ~ ' ' ~ (user.nom ?? ''))|trim %}
                            <label class="admin-mailing-user">
                                <input
                                    type="checkbox"
                                    name="users[]"
                                    value="{{ user.id }}"
                                    {% if user.id in selectedIds %}checked{% endif %}
                                >
                                <span>
                                    <strong>{{ userName ?: user.email }}</strong>
                                    <small>{{ user.email }}</small>
                                </span>
                            </label>
                        {% else %}
                            <p class="admin-empty-state">{{ 'admin.mailing.html.no_user'|trans }}</p>
                        {% endfor %}
                    </div>
                </aside>
            </div>
        </section>
    </form>

    <script>
        document.querySelector('[data-mailing-toggle-users]')?.addEventListener('click', (event) => {
            const checkboxes = Array.from(document.querySelectorAll('.admin-mailing-user input[type="checkbox"]'));
            const shouldCheck = checkboxes.some((checkbox) => !checkbox.checked);
            checkboxes.forEach((checkbox) => {
                checkbox.checked = shouldCheck;
            });
            const button = event.currentTarget;
            button.textContent = shouldCheck ? button.dataset.labelDeselectAll : button.dataset.labelSelectAll;
        });
    </script>
{% endblock %}
