{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}{{ 'admin_dashboard.html.ultras_lions_fc_fleury_91_page_admin'|trans }}{% endblock %}

{% block content %}

<h1 class="admin-title">🔥 {{ 'admin_dashboard.html.ultras_lions_dashboard'|trans }}</h1>

<div class="stats-grid">
    <div class="stat-card">
        <h3>{{ 'admin_dashboard.html.articles'|trans }}</h3>
        <p class="stat-number">{{ stats.posts }}</p>
    </div>

    <div class="stat-card">
        <h3>{{ 'admin_dashboard.html.evenements'|trans }}</h3>
        <p class="stat-number">{{ stats.events }}</p>
    </div>

    <div class="stat-card">
        <h3>{{ 'admin_dashboard.html.galeries'|trans }}</h3>
        <p class="stat-number">{{ stats.galleries }}</p>
    </div>

    <div class="stat-card">
        <h3>{{ 'admin_dashboard.html.medias'|trans }}</h3>
        <p class="stat-number">{{ stats.media }}</p>
    </div>

    <div class="stat-card">
        <h3>{{ 'admin_dashboard.html.visites'|trans }}</h3>
        <p class="stat-number">{{ stats.visits }}</p>
    </div>
</div>

<hr class="divider">

<h2 class="section-title">📈 {{ 'admin_dashboard.html.evolution_des_articles'|trans }}</h2>

<canvas id="postsChart"
        height="80"
        data-labels='{{ chartData|map(d => d.month)|json_encode }}'
        data-values='{{ chartData|map(d => d.total)|json_encode }}'>
</canvas>

<hr class="divider">

<h2 class="section-title">📰 {{ 'admin_dashboard.html.derniers_articles_publies'|trans }}</h2>

<div class="latest-posts">
    {% for post in lastPosts %}
        <div class="latest-post-card">
            <h4>{{ post.title }}</h4>
            <p class="small">{{ post.createdAt|date('d/m/Y') }}</p>
        </div>
    {% else %}
        <p>{{ 'admin_dashboard.html.aucun_article_pour_le_moment'|trans }}</p>
    {% endfor %}
</div>

{% endblock %}

{% block body_javascript %}
    {{ parent() }}

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{ asset('js/dashboard.js') }}" defer></script>
{% endblock %}
