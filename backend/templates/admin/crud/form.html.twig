{% extends 'admin/layout.html.twig' %}

{% block title %}Admin - {{ mode == 'new' ? 'Nouveau' : 'Modifier' }} {{ config.singular }}{% endblock %}
{% block admin_title %}{{ mode == 'new' ? 'Nouveau' : 'Modifier' }} {{ config.singular }}{% endblock %}

{% block admin_actions %}
    {% if resource in ['pages', 'articles', 'chants', 'groupe', 'evenements', 'linktree', 'medias'] %}
        <button class="btn btn-outline-light btn-sm" type="button" data-page-preview-trigger>
            Previsualiser
        </button>
    {% else %}
        <a class="btn btn-outline-light btn-sm" href="{{ path('custom_admin_crud_index', { resource: resource }) }}">
            Retour
        </a>
    {% endif %}
{% endblock %}

{% block body %}
    {% if resource in ['pages', 'articles'] %}
        {% set isPageResource = resource == 'pages' %}
        {% if isPageResource %}
            {% set pageUrlTemplate = url('page_show', { slug: '__slug__' }) %}
            {% set previewUrl = path('custom_admin_page_preview') %}
            {% set previewToken = csrf_token('page_preview') %}
            {% set resourcePlural = 'pages' %}
            {% set resourceSingular = 'page' %}
            {% set createLabel = 'Creer une page' %}
            {% set editLabel = 'Modifier la page' %}
            {% set contentTitle = 'Editeur visuel' %}
            {% set submitLabel = 'Enregistrer la page' %}
            {% set defaultSlug = 'reglement-interieur' %}
        {% else %}
            {% set pageUrlTemplate = url('post_show', { slug: '__slug__' }) %}
            {% set previewUrl = path('custom_admin_post_preview') %}
            {% set previewToken = csrf_token('post_preview') %}
            {% set resourcePlural = 'articles' %}
            {% set resourceSingular = 'article' %}
            {% set createLabel = 'Creer un article' %}
            {% set editLabel = 'Modifier un article' %}
            {% set contentTitle = 'Editeur visuel' %}
            {% set submitLabel = 'Enregistrer un article' %}
            {% set defaultSlug = 'actualite' %}
        {% endif %}
        {% set selectedMediaValue = form.image.vars.value|default('') %}
        {% set selectedMediaLabel = item.image ? (item.image.alt ?: item.image.path) : 'Aucune image principale' %}

        <section
            class="admin-page-editor"
            data-page-editor="1"
            data-page-url-template="{{ pageUrlTemplate|e('html_attr') }}"
            data-page-slug-default="{{ defaultSlug|e('html_attr') }}"
            data-page-title-default="{{ isPageResource ? 'Titre de la page' : 'Titre article' }}"
            data-preview-url="{{ previewUrl }}"
            data-preview-token="{{ previewToken }}"
        >
            <div class="admin-page-editor__banner">
                <div class="admin-page-editor__banner-copy">
                    <p class="admin-kicker">Gestion des {{ resourcePlural }}</p>
                    <h2>{{ mode == 'new' ? createLabel : editLabel }}</h2>
                    <div class="admin-page-editor__banner-meta">
                        <span class="admin-page-pill">Slug auto</span>
                        <span class="admin-page-pill">Mediatheque</span>
                        <span class="admin-page-pill">{{ 'admin.crud.preview_admin'|trans }}</span>
                    </div>
                </div>

                <div class="admin-page-editor__banner-actions">
                    <button class="btn btn-outline-light btn-sm" type="button" data-page-preview-trigger>
                        Previsualiser
                    </button>
                    <a class="btn btn-outline-light btn-sm" href="{{ path('custom_admin_crud_index', { resource: resource }) }}">
                        Retour a la liste
                    </a>
                </div>
            </div>

            {{ form_start(form, { attr: { class: 'admin-page-form', 'data-page-form': '1', novalidate: 'novalidate' } }) }}
                {{ form_errors(form) }}

                <div class="admin-page-editor__summary-grid{% if not isPageResource %} admin-page-summary-grid--article{% endif %}">
                    <article class="admin-page-summary">
                        <span>Adresse</span>
                        <strong data-page-url-preview>{{ isPageResource ? url('page_show', { slug: item.slug ?: defaultSlug }) : url('post_show', { slug: item.slug ?: defaultSlug }) }}</strong>
                        <small>La zone de saisie du slug pilote cette adresse.</small>
                    </article>

                    <article class="admin-page-summary">
                        <span>Contenu</span>
                        <strong data-page-content-stats>0 mot</strong>
                        <small data-page-content-chars>0 caractere</small>
                    </article>

                    {% if not isPageResource %}
                        <article class="admin-page-summary">
                            <span>Categorie</span>
                            <strong data-page-category-label>{{ item.category ? item.category.name : 'Aucune categorie' }}</strong>
                            <small>La categorie publique de l'article.</small>
                        </article>
                    {% endif %}

                    <article class="admin-page-summary">
                        <span>Mediatheque</span>
                        <strong data-page-media-label>{{ selectedMediaLabel }}</strong>
                        <small data-page-media-path>{{ item.image ? item.image.path : 'Aucun fichier associe' }}</small>
                    </article>
                </div>

                <div class="admin-page-editor__layout">
                    <div class="admin-page-editor__main">
                        <section class="admin-panel admin-page-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Informations generales</p>
                                    <h2>{{ isPageResource ? 'Titre et adresse' : 'Titre et lien' }}</h2>
                                </div>
                                <span class="admin-page-field-counter" data-page-title-counter>0 caracteres</span>
                            </div>

                            <div class="admin-page-stack">
                                <div class="admin-page-field">
                                    {{ form_label(form.title) }}
                                    <div class="admin-page-input-shell admin-page-input-shell--title">
                                        <span class="admin-page-input-shell__prefix">Titre principal</span>
                                        {{ form_widget(form.title) }}
                                    </div>

                                    <div class="admin-page-field-hero">
                                        <div class="admin-page-field-hero__copy">
                                            <span class="admin-page-field-hero__label">Apercu du titre</span>
                                            <strong data-page-title-preview>{{ item.title ?: (isPageResource ? 'Titre de la page' : 'Titre article') }}</strong>
                                            <small data-page-title-feedback>Titre pret</small>
                                        </div>
                                        <div class="admin-page-field-hero__meta">
                                            <span class="admin-page-field-counter" data-page-title-counter>0 caracteres</span>
                                            <span class="admin-page-field-chip">Visible publiquement</span>
                                        </div>
                                    </div>

                                    <div class="admin-page-field-hint">
                                        <span class="form-text">{{ form_help(form.title) }}</span>
                                    </div>
                                    {{ form_errors(form.title) }}
                                </div>

                                <div class="admin-page-slug-block">
                                    <div class="admin-page-slug-shell">
                                        <div class="admin-page-slug-shell__copy">
                                            <span class="admin-page-field-hero__label">Slug</span>
                                            <strong data-page-url-full data-page-url-preview>
                                                {{ isPageResource ? url('page_show', { slug: item.slug ?: defaultSlug }) : url('post_show', { slug: item.slug ?: defaultSlug }) }}
                                            </strong>
                                            <div class="admin-page-slug-path">
                                                <span class="admin-page-slug-path__label">Adresse</span>
                                                <code class="admin-page-slug-path__value">{{ item.slug ?: defaultSlug }}</code>
                                            </div>
                                            <small>Le slug correspond a l'adresse publique de la page.</small>
                                        </div>
                                        <div class="admin-page-slug-shell__meta">
                                            <span class="admin-page-field-counter" data-page-slug-state>Mode auto</span>
                                            <span class="admin-page-field-chip admin-page-field-chip--soft">URL propre</span>
                                        </div>
                                    </div>

                                    <div class="admin-page-field admin-page-field--slug">
                                        {{ form_label(form.slug) }}
                                        <div class="admin-page-input-shell admin-page-input-shell--slug">
                                            <span class="admin-page-input-shell__prefix">/</span>
                                            {{ form_widget(form.slug) }}
                                        </div>
                                        <div class="admin-page-field-hint">
                                            <span class="form-text">{{ form_help(form.slug) }}</span>
                                        </div>
                                        {{ form_errors(form.slug) }}
                                    </div>

                                    <div class="admin-page-slug-actions">
                                        <button class="btn btn-secondary btn-sm" type="button" data-page-slug-reset>
                                            Regenerer depuis le titre
                                        </button>
                                        <button class="btn btn-outline-light btn-sm" type="button" data-page-url-copy>
                                            Copier l'URL
                                        </button>
                                    </div>
                                </div>

                                {% if not isPageResource %}
                                    <div class="admin-page-field admin-page-field--category">
                                        {{ form_label(form.category) }}
                                        <div class="admin-page-input-shell admin-page-input-shell--category">
                                            <span class="admin-page-input-shell__prefix">Categorie</span>
                                            {{ form_widget(form.category) }}
                                        </div>
                                        <div class="admin-page-field-hint">
                                            <span class="form-text">{{ form_help(form.category) }}</span>
                                            <span class="admin-page-field-counter" data-page-category-label>
                                                {{ item.category ? item.category.name : 'Aucune categorie' }}
                                            </span>
                                        </div>
                                        {{ form_errors(form.category) }}
                                    </div>
                                {% endif %}
                            </div>
                        </section>

                        <section class="admin-panel admin-page-card admin-page-content-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Contenu</p>
                                    <h2>{{ contentTitle }}</h2>
                                </div>
                                <span class="admin-page-field-counter" data-page-content-reading>0 min</span>
                            </div>

                            <div class="admin-page-editor-toolbar">
                                <p class="form-text mb-0">
                                    La mise en page est prevue pour le rendu public de la page. Tu peux mixer titres, listes, citations, tableaux et liens.
                                </p>
                                <div class="admin-page-editor-toolbar__stats">
                                    <span data-page-content-stats>0 mot</span>
                                    <span data-page-content-chars>0 caractere</span>
                                </div>
                            </div>

                            <div class="admin-page-editor-wrapper">
                                {{ form_label(form.content) }}
                                <div class="admin-page-editor-frame">
                                    {{ form_widget(form.content) }}
                                </div>
                                {{ form_errors(form.content) }}
                                <div class="admin-page-field-hint">
                                    {{ form_help(form.content) }}
                                    <span class="admin-page-field-counter">HTML nettoye automatiquement</span>
                                </div>
                            </div>
                        </section>
                    </div>

                    <aside class="admin-page-editor__side">
                        <section class="admin-panel admin-page-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Publication</p>
                                    <h2>Image principale</h2>
                                </div>
                                <div class="admin-page-editor__banner-actions">
                                    <button class="btn btn-secondary btn-sm" type="button" data-page-import-trigger>
                                        Importer une image
                                    </button>
                                    <button class="btn btn-outline-light btn-sm" type="button" data-page-preview-trigger>
                                        Previsualiser
                                    </button>
                                </div>
                            </div>

                            <p class="form-text">
                                Les sections peuvent rester repliees. Le visuel selectionne sera affiche dans l'apercu et la page publique.
                            </p>

                            <input
                                type="file"
                                class="d-none"
                                accept="image/*"
                                data-page-import-input
                            >

                            <div class="admin-media-accordion-stack">
                                <details class="admin-media-accordion" data-media-picker>
                                    <summary>
                                        <span class="admin-media-accordion__title">Image principale</span>
                                        <span class="admin-media-accordion__summary" data-page-media-label>{{ selectedMediaLabel }}</span>
                                    </summary>

                                    <div class="admin-media-accordion__body">
                                        <label class="form-label" for="{{ form.image.vars.id }}">
                                            Selectionner une image
                                        </label>
                                        <input
                                            type="search"
                                            class="form-control admin-media-picker__search"
                                            placeholder="Rechercher dans la mediatheque"
                                            data-media-search
                                        >
                                        {{ form_widget(form.image, { attr: { 'data-media-select': '1', 'class': 'd-none' } }) }}
                                        {% if form.image_id is defined %}
                                            {{ form_widget(form.image_id, { attr: { 'data-page-image-id': '1' } }) }}
                                        {% endif %}

                                        <div class="admin-media-library" data-media-library>
                                            <button
                                                class="admin-media-card{% if selectedMediaValue == '' %} is-selected{% endif %}"
                                                type="button"
                                                data-media-card
                                                data-media-value=""
                                                data-media-label="Aucune image principale"
                                                data-media-path=""
                                                data-media-alt=""
                                                data-media-kind="image"
                                                aria-pressed="{{ selectedMediaValue == '' ? 'true' : 'false' }}"
                                            >
                                                <span class="admin-media-card__thumb admin-media-card__thumb--empty">
                                                    <span>Aucun visuel</span>
                                                </span>
                                                <strong class="admin-media-card__label">Aucune image principale</strong>
                                                <small class="admin-media-card__meta">Laisse vide pour une page sans visuel.</small>
                                            </button>

                                            {% for choice in form.image.vars.choices %}
                                                {% set choiceAttr = choice.attr|default({}) %}
                                                {% set choicePath = choiceAttr['data-media-path']|default('') %}
                                                {% set choiceAlt = choiceAttr['data-media-alt']|default('') %}
                                                {% set choiceKind = choiceAttr['data-media-kind']|default('image') %}
                                                {% set choiceSelected = selectedMediaValue == choice.value %}
                                                <button
                                                    class="admin-media-card{% if choiceSelected %} is-selected{% endif %}"
                                                    type="button"
                                                    data-media-card
                                                    data-media-value="{{ choice.value }}"
                                                    data-media-label="{{ choice.label }}"
                                                    data-media-path="{{ choicePath }}"
                                                    data-media-alt="{{ choiceAlt }}"
                                                    data-media-kind="{{ choiceKind }}"
                                                    aria-pressed="{{ choiceSelected ? 'true' : 'false' }}"
                                                >
                                                    <span class="admin-media-card__thumb">
                                                        {% if choicePath %}
                                                            {% if choiceKind == 'video' %}
                                                                <video muted playsinline preload="metadata">
                                                                    <source src="{{ asset('uploads/media/' ~ choicePath) }}">
                                                                </video>
                                                            {% else %}
                                                                <img src="{{ asset('uploads/media/' ~ choicePath) }}" alt="{{ choiceAlt ?: choice.label }}" loading="lazy">
                                                            {% endif %}
                                                        {% else %}
                                                            <span>Apercu indisponible</span>
                                                        {% endif %}
                                                    </span>
                                                    <strong class="admin-media-card__label">{{ choice.label }}</strong>
                                                    <small class="admin-media-card__meta">{{ choicePath ?: 'Aucun fichier' }}</small>
                                                </button>
                                            {% endfor %}
                                        </div>

                                        {{ form_errors(form.image) }}
                                        <p class="form-text">{{ form_help(form.image) }}</p>

                                        <div class="admin-media-preview" data-media-preview>
                                            {% if item.image %}
                                                <img src="{{ asset('uploads/media/' ~ item.image.path) }}" alt="{{ item.image.alt ?: item.title }}" loading="lazy">
                                                <div>
                                                    <strong>{{ item.image.alt ?: item.image.path }}</strong>
                                                    <small>{{ item.image.path }}</small>
                                                </div>
                                            {% else %}
                                                <div class="admin-media-preview__empty">
                                                    Aucune image principale selectionnee
                                                </div>
                                            {% endif %}
                                        </div>

                                        <div class="admin-media-picker__actions">
                                            <a
                                                class="btn btn-secondary btn-sm"
                                                href="{{ path('custom_admin_crud_index', { resource: 'medias' }) }}"
                                                target="_blank"
                                                rel="noreferrer"
                                            >
                                                Ouvrir la mediatheque
                                            </a>
                                            <button class="btn btn-outline-light btn-sm" type="button" data-media-clear>
                                                Retirer l'image
                                            </button>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        </section>

                        <section class="admin-panel admin-page-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Actions</p>
                                    <h2>Enregistrement</h2>
                                </div>
                                <span class="admin-page-field-counter">Sauvegarde manuelle</span>
                            </div>

                            <div class="admin-page-actions">
                                <button class="btn btn-danger btn-lg" type="submit">
                                    {{ mode == 'new' ? submitLabel : 'Enregistrer les modifications' }}
                                </button>
                                <button class="btn btn-outline-light" type="button" data-page-preview-trigger>
                                    Previsualiser
                                </button>
                                <a class="btn btn-secondary" href="{{ path('custom_admin_crud_index', { resource: resource }) }}">
                                    Annuler
                                </a>
                            </div>

                            <p class="form-text mt-3">
                                Une confirmation apparaitra si tu quittes la page avec des modifications non enregistrees.
                            </p>
                        </section>
                    </aside>
                </div>

                {{ form_rest(form) }}
            {{ form_end(form, { render_rest: false }) }}

            <form
                class="d-none"
                data-page-preview-form
                method="post"
                action="{{ previewUrl }}"
                target="_blank"
            >
                <input type="hidden" name="_token" value="{{ previewToken }}">
                <input type="hidden" name="title" data-preview-title>
                <input type="hidden" name="slug" data-preview-slug>
                <input type="hidden" name="content" data-preview-content>
                <input type="hidden" name="image_id" data-preview-image>
                {% if not isPageResource %}
                    <input type="hidden" name="category_id" data-preview-category>
                {% endif %}
            </form>
        </section>
    {% elseif resource == 'chants' %}
        {% set selectedAudioPath = item.audioPath|default('') %}
        {% set selectedAudioName = selectedAudioPath ? (selectedAudioPath|split('/'))|last : '' %}
        {% set selectedAudioLabel = selectedAudioName ?: 'Aucun fichier audio' %}
        {% set selectedLyricsValue = item.lyrics ?: '' %}

        <section
            class="admin-page-editor"
            data-chant-editor="1"
            data-chant-current-audio-path="{{ selectedAudioPath }}"
            data-preview-url="{{ path('custom_admin_chant_preview') }}"
            data-preview-token="{{ csrf_token('chant_preview') }}"
        >
            <div class="admin-page-editor__banner">
                <div class="admin-page-editor__banner-copy">
                    <p class="admin-kicker">Gestion des chants</p>
                    <h2>{{ mode == 'new' ? 'Creer un chant' : 'Modifier le chant' }}</h2>
                    <div class="admin-page-editor__banner-meta">
                        <span class="admin-page-pill">Paroles riches</span>
                        <span class="admin-page-pill">Audio</span>
                        <span class="admin-page-pill">{{ 'admin.crud.preview_admin'|trans }}</span>
                    </div>
                </div>

                <div class="admin-page-editor__banner-actions">
                    <button class="btn btn-outline-light btn-sm" type="button" data-page-preview-trigger>
                        Previsualiser
                    </button>
                    <a class="btn btn-outline-light btn-sm" href="{{ path('custom_admin_crud_index', { resource: resource }) }}">
                        Retour a la liste
                    </a>
                </div>
            </div>

            {{ form_start(form, { attr: { class: 'admin-page-form', 'data-chant-form': '1', novalidate: 'novalidate' } }) }}
                {{ form_errors(form) }}

                <div class="admin-page-editor__summary-grid">
                    <article class="admin-page-summary">
                        <span>Titre</span>
                        <strong data-chant-title-preview>{{ item.title ?: 'Chant' }}</strong>
                        <small>Nom affiche dans la liste publique.</small>
                    </article>

                    <article class="admin-page-summary">
                        <span>Audio</span>
                        <strong data-chant-audio-preview>{{ selectedAudioLabel }}</strong>
                        <small data-chant-audio-status>{{ selectedAudioPath ? 'Fichier actuellement publié' : 'Aucun fichier audio enregistre' }}</small>
                    </article>

                    <article class="admin-page-summary">
                        <span>Paroles</span>
                        <strong data-chant-lyrics-stats>0 mot</strong>
                        <small data-chant-lyrics-chars>0 caractere</small>
                    </article>
                </div>

                <div class="admin-page-editor__layout">
                    <div class="admin-page-editor__main">
                        <section class="admin-panel admin-page-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Informations generales</p>
                                    <h2>Titre du chant</h2>
                                </div>
                                <span class="admin-page-field-counter" data-chant-title-counter>0 caracteres</span>
                            </div>

                            <div class="admin-page-stack">
                                <div class="admin-page-field">
                                    {{ form_label(form.title) }}
                                    {{ form_widget(form.title) }}
                                    <div class="admin-page-field-hero">
                                        <div>
                                            <span class="admin-page-field-hero__label">Titre</span>
                                            <strong data-chant-title-preview>{{ item.title ?: 'Titre du chant' }}</strong>
                                            <small data-chant-title-feedback>Titre pret</small>
                                        </div>
                                        <span class="admin-page-field-counter" data-chant-title-counter>0 caracteres</span>
                                    </div>
                                    <div class="admin-page-field-hint">
                                        {{ form_help(form.title) }}
                                    </div>
                                    {{ form_errors(form.title) }}
                                </div>
                            </div>
                        </section>

                        <section class="admin-panel admin-page-card admin-page-content-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Paroles</p>
                                    <h2>Editeur visuel</h2>
                                </div>
                                <span class="admin-page-field-counter" data-chant-lyrics-reading>0 min</span>
                            </div>

                            <div class="admin-page-editor-toolbar">
                                <p class="form-text mb-0">
                                    Tu peux structurer les paroles avec titres, retours a la ligne et liens, puis les relire dans l'aperçu admin.
                                </p>
                                <div class="admin-page-editor-toolbar__stats">
                                    <span data-chant-lyrics-stats>0 mot</span>
                                    <span data-chant-lyrics-chars>0 caractere</span>
                                </div>
                            </div>

                            <div class="admin-page-editor-wrapper">
                                {{ form_label(form.lyrics) }}
                                <div class="admin-page-editor-frame">
                                    {{ form_widget(form.lyrics) }}
                                </div>
                                {{ form_errors(form.lyrics) }}
                                <div class="admin-page-field-hint">
                                    {{ form_help(form.lyrics) }}
                                    <span class="admin-page-field-counter">HTML nettoye automatiquement</span>
                                </div>
                            </div>
                        </section>
                    </div>

                    <aside class="admin-page-editor__side">
                        <section class="admin-panel admin-page-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Publication</p>
                                    <h2>Importer un audio</h2>
                                </div>
                                <span class="admin-page-field-counter">Fichier source</span>
                            </div>

                            <p class="form-text">
                                Importe un fichier audio pour le chant. Les formats MP3, WAV, OGG, M4A, AAC et FLAC sont acceptes.
                            </p>

                            <div class="admin-audio-upload">
                                <div class="admin-audio-upload__summary">
                                    <span class="admin-page-field-hero__label">Fichier selectionne</span>
                                    <strong data-chant-audio-preview>{{ selectedAudioLabel }}</strong>
                                    <small data-chant-audio-status>
                                        {{ selectedAudioPath ? 'Fichier actuellement enregistre' : 'Aucun fichier audio enregistre' }}
                                    </small>
                                </div>

                                <div class="admin-audio-upload__control">
                                    {{ form_label(form.audioFile) }}
                                    {{ form_widget(form.audioFile) }}
                                    <div class="admin-page-field-hint">
                                        {{ form_help(form.audioFile) }}
                                    </div>
                                    {{ form_errors(form.audioFile) }}
                                </div>

                                <div class="admin-audio-upload__current">
                                    {% if selectedAudioPath %}
                                        <span>Fichier actuel</span>
                                        <code>{{ selectedAudioPath }}</code>
                                    {% else %}
                                        <span>Aucun fichier enregistre</span>
                                        <small>Choisis un fichier audio avant de sauvegarder le chant.</small>
                                    {% endif %}
                                </div>
                            </div>
                        </section>

                        <section class="admin-panel admin-page-card">
