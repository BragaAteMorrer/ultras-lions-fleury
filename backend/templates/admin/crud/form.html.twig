                                    <p class="form-text">{{ form_help(form.openToGuests) }}</p>
                                </div>
                                <div class="admin-page-field">
                                    {{ form_label(form.price) }}
                                    {{ form_widget(form.price) }}
                                    <div class="admin-page-field-hint">
                                        {{ form_help(form.price) }}
                                        <span class="admin-page-field-counter" data-ticket-price-preview>{{ ticketPriceLabel }}</span>
                                    </div>
                                    {{ form_errors(form.price) }}
                                </div>
                                <div class="admin-page-field">
                                    {{ form_label(form.stock) }}
                                    {{ form_widget(form.stock) }}
                                    <div class="admin-page-field-hint">
                                        {{ form_help(form.stock) }}
                                        <span class="admin-page-field-counter" data-ticket-stock-preview>{{ ticketStockLabel }}</span>
                                    </div>
                                    {{ form_errors(form.stock) }}
                                </div>
                                <div class="admin-page-field">
                                    {{ form_label(form.billetwebUrl) }}
                                    {{ form_widget(form.billetwebUrl) }}
                                    {{ form_errors(form.billetwebUrl) }}
                                </div>
                            </div>
                        </section>

                        <section class="admin-panel admin-page-card admin-page-content-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Description</p>
                                    <h2>Texte public</h2>
                                </div>
                                <span class="admin-page-field-counter">Informations complementaires</span>
                            </div>

                            <div class="admin-page-editor-wrapper">
                                {{ form_label(form.description) }}
                                <div class="admin-page-editor-frame">
                                    {{ form_widget(form.description) }}
                                </div>
                                {{ form_errors(form.description) }}
                                <div class="admin-page-field-hint">
                                    {{ form_help(form.description) }}
                                    <span class="admin-page-field-counter">Texte court pour la fiche de vente</span>
                                </div>
                            </div>
                        </section>
                    </div>

                    <aside class="admin-page-editor__side">
                        <section class="admin-panel admin-page-card">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Visuel</p>
                                    <h2>Image du billet</h2>
                                </div>
                                <div class="admin-page-editor__banner-actions">
                                    <label class="btn btn-secondary btn-sm mb-0" for="ticket-import-input-{{ item.id ?: 'new' }}" data-ticket-import-trigger>
                                        Importer une image
                                    </label>
                                    <a class="btn btn-outline-light btn-sm" href="{{ path('custom_admin_crud_index', { resource: 'medias' }) }}" target="_blank" rel="noreferrer">
                                        Ouvrir la mediatheque
                                    </a>
                                </div>
                            </div>

                            <p class="form-text">
                                L'import ajoute un nouveau media puis le selectionne automatiquement dans la liste.
                            </p>

                            <input
                                id="ticket-import-input-{{ item.id ?: 'new' }}"
                                type="file"
                                class="visually-hidden"
                                accept="image/*"
                                data-ticket-import-input
                            >

                            <div class="admin-media-picker" data-media-picker>
                                <label class="form-label" for="{{ form.image.vars.id }}">Image principale</label>
                                <input type="search" class="form-control admin-media-picker__search" placeholder="Rechercher dans la mediatheque" data-media-search>
                                {{ form_widget(form.image, { attr: { 'data-media-select': '1', 'class': 'd-none' } }) }}
                                {% if form.image_id is defined %}
                                    {{ form_widget(form.image_id, { attr: { 'data-ticket-image-id': '1' } }) }}
                                {% endif %}

                                <div class="admin-media-library admin-media-library--scrollable" data-media-library>
                                    <button class="admin-media-card{% if selectedTicketImageValue == '' %} is-selected{% endif %}" type="button" data-media-card data-media-value="" data-media-label="Aucune image principale" data-media-path="" data-media-alt="" data-media-kind="image" aria-pressed="{{ selectedTicketImageValue == '' ? 'true' : 'false' }}">
                                        <span class="admin-media-card__thumb admin-media-card__thumb--empty"><span>Aucun visuel</span></span>
                                        <strong class="admin-media-card__label">Aucune image principale</strong>
                                        <small class="admin-media-card__meta">Laisse vide si le billet n'a pas de visuel.</small>
                                    </button>

                                    {% for choice in form.image.vars.choices %}
                                        {% set choiceAttr = choice.attr|default({}) %}
                                        {% set choicePath = choiceAttr['data-media-path']|default('') %}
                                        {% set choiceAlt = choiceAttr['data-media-alt']|default('') %}
                                        {% set choiceKind = choiceAttr['data-media-kind']|default('image') %}
                                        {% set choiceSelected = selectedTicketImageValue == choice.value %}
                                        <button class="admin-media-card{% if choiceSelected %} is-selected{% endif %}" type="button" data-media-card data-media-value="{{ choice.value }}" data-media-label="{{ choice.label }}" data-media-path="{{ choicePath }}" data-media-alt="{{ choiceAlt }}" data-media-kind="{{ choiceKind }}" aria-pressed="{{ choiceSelected ? 'true' : 'false' }}">
                                            <span class="admin-media-card__thumb">
                                                {% if choicePath %}
                                                    {% if choiceKind == 'video' %}
                                                        <video muted playsinline preload="metadata"><source src="{{ asset('uploads/media/' ~ choicePath) }}"></video>
                                                    {% else %}
                                                        <img src="{{ asset('uploads/media/' ~ choicePath) }}" alt="{{ choiceAlt ?: choice.label }}" loading="lazy">
                                                    {% endif %}
                                                {% else %}
                                                    <span>Apercu indisponible</span>
                                                {% endif %}
                                            </span>
                                            <strong class="admin-media-card__label">{{ choice.label }}</strong>
                                            <small class="admin-media-card__meta">{{ choicePath ?: 'Aucun fichier' }}</small>
                                        </button>
                                    {% endfor %}
                                </div>

                                {{ form_errors(form.image) }}
                                <p class="form-text">{{ form_help(form.image) }}</p>

                                <div class="admin-media-preview" data-ticket-media-preview>
                                    {% if item.image %}
                                        {% if item.image.isVideo %}
                                            <video controls preload="metadata">
                                                <source src="{{ asset('uploads/media/' ~ item.image.path) }}">
                                            </video>
                                        {% else %}
                                            <img src="{{ asset('uploads/media/' ~ item.image.path) }}" alt="{{ item.image.alt ?: item.title }}" loading="lazy">
                                        {% endif %}
                                        <div>
                                            <strong>{{ item.image.alt ?: item.image.path }}</strong>
                                            <small>{{ item.image.path }}</small>
                                        </div>
                                    {% else %}
                                        <div class="admin-media-preview__empty">
                                            Aucune image principale selectionnee
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="admin-media-picker__actions">
                                    <button class="btn btn-outline-light btn-sm" type="button" data-ticket-media-clear>
                                        Retirer l'image
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="admin-panel admin-page-card admin-page-card--sticky">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Actions</p>
                                    <h2>Enregistrement</h2>
                                </div>
                                <span class="admin-page-field-counter">Sauvegarde manuelle</span>
                            </div>

                            <div class="admin-page-actions">
                                <button class="btn btn-danger btn-lg" type="submit">
                                    {{ mode == 'new' ? 'Enregistrer le billet' : 'Enregistrer les modifications' }}
                                </button>
                                <a class="btn btn-secondary" href="{{ path('custom_admin_crud_index', { resource: resource }) }}">
                                    Annuler
                                </a>
                            </div>

                            <p class="form-text mt-3">
                                Verifie l'image, le prix et la disponibilite avant de valider.
                            </p>
                        </section>
                    </aside>
                </div>

                {{ form_rest(form) }}
            {{ form_end(form, { render_rest: false }) }}
    {% else %}
        <section class="admin-form-shell">
            <div class="admin-form-banner">
                <div class="admin-form-banner-copy">
                    <p class="admin-kicker">Gestion {{ resource }}</p>
                    <h2>{{ mode == 'new' ? 'Creer' : 'Modifier' }} {{ config.singular }}</h2>
                    <div class="admin-form-banner-meta">
                        <span class="admin-form-pill">{{ form|length }} champs</span>
                        <span class="admin-form-pill">{{ mode == 'new' ? 'Creation' : 'Edition' }}</span>
                        <span class="admin-form-pill">Sauvegarde manuelle</span>
                    </div>
                </div>

                <div class="admin-form-banner-actions">
                    <a class="btn btn-outline-light btn-sm" href="{{ path('custom_admin_crud_index', { resource: resource }) }}">
                        Retour a la liste
                    </a>
                </div>
            </div>

            {{ form_start(form, { attr: { class: 'admin-form admin-form--workspace', novalidate: 'novalidate' } }) }}
                {{ form_errors(form) }}

                <div class="admin-form-summary-grid">
                    <article class="admin-page-summary">
                        <span>Ressource</span>
                        <strong>{{ config.label }}</strong>
                        <small>{{ config.singular }}</small>
                    </article>

                    <article class="admin-page-summary">
                        <span>Champs</span>
                        <strong>{{ form|length }}</strong>
                        <small>Inclus les champs visibles du formulaire.</small>
                    </article>

                    <article class="admin-page-summary">
                        <span>Etat</span>
                        <strong>{{ mode == 'new' ? 'Nouveau' : 'Modification' }}</strong>
                        <small>Les changements seront appliques a l'enregistrement.</small>
                    </article>
                </div>

                <div class="admin-form-layout">
                    <section class="admin-panel admin-form-card">
                        <div class="admin-panel-head">
                            <div>
                                <p class="admin-kicker">Champs</p>
                                <h2>{{ config.singular }}</h2>
                            </div>
                            <span class="admin-page-field-counter">{{ form|length }} elements</span>
                        </div>

                        <div class="admin-form-grid">
                            {% for child in form %}
                                {{ form_row(child) }}
                            {% endfor %}
                        </div>
                    </section>

                    <aside class="admin-form-side">
                        <section class="admin-panel admin-form-card admin-form-card--sticky">
                            <div class="admin-panel-head">
                                <div>
                                    <p class="admin-kicker">Actions</p>
                                    <h2>Enregistrement</h2>
                                </div>
                                <span class="admin-page-field-counter">Action principale</span>
                            </div>

                            <div class="admin-form-actions">
                                <button class="btn btn-danger btn-lg" type="submit">
                                    {{ mode == 'new' ? 'Creer' : 'Enregistrer' }}
                                </button>
                                <button class="btn btn-outline-light btn-lg" type="submit" name="save_and_continue" value="1">
                                    Enregistrer et continuer
                                </button>
                                <a class="btn btn-outline-light" href="{{ path('custom_admin_crud_index', { resource: resource }) }}">
                                    Annuler
                                </a>
                            </div>

                            <p class="form-text mt-3">
                                Pense a verifier les champs obligatoires avant de valider le formulaire.
                            </p>
                        </section>
                    </aside>
                </div>

                {{ form_rest(form) }}
            {{ form_end(form, { render_rest: false }) }}
        </section>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% if resource in ['pages', 'articles', 'chants', 'groupe', 'evenements'] %}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.5/tinymce.min.js" referrerpolicy="no-referrer"></script>
    {% endif %}

    {% if resource in ['pages', 'articles'] %}
        <script src="{{ asset('js/page-editor.js') }}" defer></script>
    {% elseif resource == 'chants' %}
        <script src="{{ asset('js/chant-editor.js') }}" defer></script>
    {% elseif resource == 'groupe' %}
        <script src="{{ asset('js/group-editor.js') }}" defer></script>
    {% elseif resource == 'evenements' %}
        <script src="{{ asset('js/event-editor.js') }}" defer></script>
    {% elseif resource == 'linktree' %}
        <script src="{{ asset('js/linktree-editor.js') }}" defer></script>
    {% elseif resource == 'billets' %}
        <script src="{{ asset('js/ticket-editor.js') }}" defer></script>
    {% elseif resource == 'medias' %}
        <script src="{{ asset('js/media-editor.js') }}" defer></script>
        <script>
            (() => {
                if (window.__mediaEditorInitialized) {
                    return;
                }

                window.__mediaEditorInitialized = true;

                const editorRoot = document.querySelector('[data-media-editor="1"]');
                if (!editorRoot) {
                    return;
                }

                const form = editorRoot.querySelector('[data-media-form="1"]');
                const pathInput = form?.querySelector('[name$="[path]"]');
                const altInput = form?.querySelector('[name$="[alt]"]');
                const previewVisualNode = editorRoot.querySelector('[data-media-preview-visual]');
                const previewTitleNode = editorRoot.querySelector('[data-media-preview-title]');
                const previewPathNode = editorRoot.querySelector('[data-media-preview-path]');
                const importTrigger = editorRoot.querySelector('[data-media-import-trigger]');
                const importInput = editorRoot.querySelector('[data-media-import-input]');

                if (!form || !pathInput || !altInput || !previewVisualNode) {
                    return;
                }

                let previewObjectUrl = null;

                function setText(node, value) {
                    if (node) {
                        node.textContent = value;
                    }
                }

                function escapeHtml(value) {
                    return String(value)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');
                }

                function getSelectedFile() {
                    return importInput?.files?.[0] || null;
                }

                function resolveKind(path, file) {
                    if (file?.type?.startsWith('video/')) {
                        return 'video';
                    }

                    const lower = String(path || '').toLowerCase();
                    return /\.(mp4|webm|mov|m4v|avi)$/i.test(lower) ? 'video' : 'image';
                }

                function clearPreviewObjectUrl() {
                    if (previewObjectUrl) {
                        URL.revokeObjectURL(previewObjectUrl);
                        previewObjectUrl = null;
                    }
                }

                function updatePreviewCard() {
                    const file = getSelectedFile();
                    const path = file ? file.name : pathInput.value.trim();
                    const alt = altInput.value.trim() || (file ? file.name : 'Media sans titre');
                    const kind = resolveKind(path, file);

                    setText(previewTitleNode, alt);
                    setText(previewPathNode, path || 'Aucun chemin defini');

                    if (!path) {
                        clearPreviewObjectUrl();
                        previewVisualNode.innerHTML = '<div class="media-preview-card__empty">Aucun fichier renseigne</div>';
                        return;
                    }

                    clearPreviewObjectUrl();

                    const fileUrl = file ? (previewObjectUrl = URL.createObjectURL(file)) : new URL(`/uploads/media/${path}`, window.location.origin).toString();
                    if (kind === 'video') {
                        previewVisualNode.innerHTML = `
                            <video controls preload="metadata">
                                <source src="${escapeHtml(fileUrl)}">
                            </video>
                        `;
                    } else {
                        previewVisualNode.innerHTML = `<img src="${escapeHtml(fileUrl)}" alt="${escapeHtml(alt)}">`;
                    }
                }

                importTrigger?.addEventListener('click', (event) => {
                    event.preventDefault();
                    importInput?.click();
                });

                importInput?.addEventListener('change', updatePreviewCard);
                importInput?.addEventListener('input', updatePreviewCard);

                [pathInput, altInput].forEach((field) => {
                    field?.addEventListener('input', updatePreviewCard);
                    field?.addEventListener('change', updatePreviewCard);
                });

                window.addEventListener('pagehide', clearPreviewObjectUrl);

                updatePreviewCard();
            })();
        </script>
    {% elseif resource == 'merch' %}
        <script src="{{ asset('js/merch-editor.js') }}" defer></script>
    {% endif %}
{% endblock %}
