{% extends 'base.html.twig' %}

{% block title %}{{ 'group_show.html.le_groupe_ultras_lions'|trans }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ 'group_show.html.le_groupe'|trans }}</h1>
        <p class="hero-subtitle">{{ 'group_show.html.identite_valeurs_histoire_tribune'|trans }}</p>

        {% if groupPreview|default(false) %}
            <div class="alert alert-warning mt-4">
                Apercu interne. Cette version n'est visible que pour les administrateurs.
            </div>
        {% endif %}
    </div>
</section>

<div class="section">
    <div class="container">
        {% if group %}
            <div class="group-content">
                {{ group.description|sanitize_page_html|raw }}
            </div>

            {% if group.banner %}
                <div style="margin-top:2rem;">
                    <img class="group-banner"
                         src="{{ asset('uploads/media/' ~ group.banner.path) }}"
                         alt="">
                </div>
            {% endif %}
        {% endif %}

    </div>
</div>
{% endblock %}
