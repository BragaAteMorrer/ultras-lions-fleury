{% extends 'base.html.twig' %}

{% block title %}{{ 'group_show.html.le_groupe_ultras_lions'|trans }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{ 'group_show.html.le_groupe'|trans }}</h1>
        <p class="hero-subtitle">{{ 'group_show.html.identite_valeurs_histoire_tribune'|trans }}</p>
    </div>
</section>

<div class="section">
    <div class="container">
        <div class="group-layout">
            <aside class="group-sidenav">
                <div class="group-sidenav-title">Le Groupe</div>
                <a href="#notre-histoire" class="group-sidenav-link">Notre histoire</a>
                <a href="#notre-mentalite" class="group-sidenav-link">Notre mentalite</a>
                <a href="#notre-fonctionnement" class="group-sidenav-link">Notre fonctionnement</a>
                <a href="#pourquoi-nous-rejoindre" class="group-sidenav-link">Pourquoi nous rejoindre ?</a>
                <a href="#se-carter" class="group-sidenav-link">Se Carter</a>
            </aside>

            <div class="group-main">
                {% if group and group.banner %}
                    <div style="margin-top:2rem;">
                        <img class="group-banner"
                             src="{{ asset('uploads/media/' ~ group.banner.path) }}"
                             alt="">
                    </div>
                {% endif %}

                <div class="group-section" id="notre-histoire">
                    <h2>{{ 'group_show.html.section_histoire_title'|trans }}</h2>
                    {% set histoireText = (group and group.histoireText) ? group.histoireText : 'Nés en tribune à Fleury, on a bâti notre identité match après match. Rouge et noir, fidèles, présents partout.' %}
                    <div class="rich-content">
                        {% if group and group.histoireText %}
                            {{ histoireText|raw }}
                        {% else %}
                            {{ histoireText|nl2br }}
                        {% endif %}
                    </div>
                </div>

                <div class="group-section" id="notre-mentalite">
                    <h2>{{ 'group_show.html.section_mentalite_title'|trans }}</h2>
                    {% set mentaliteText = (group and group.mentaliteText) ? group.mentaliteText : 'Fidélité, respect, solidarité. On chante, on pousse, on ne lâche rien, à domicile comme en déplacement.' %}
                    <div class="rich-content">
                        {% if group and group.mentaliteText %}
                            {{ mentaliteText|raw }}
                        {% else %}
                            {{ mentaliteText|nl2br }}
                        {% endif %}
                    </div>
                </div>

                <div class="group-section" id="notre-fonctionnement">
                    <h2>{{ 'group_show.html.section_fonctionnement_title'|trans }}</h2>
                    {% set fonctionnementText = (group and group.fonctionnementText) ? group.fonctionnementText : 'Le groupe tourne grâce aux bénévoles, aux réunions et aux décisions collectives. Chacun a sa place, chacun met la main.' %}
                    <div class="rich-content">
                        {% if group and group.fonctionnementText %}
                            {{ fonctionnementText|raw }}
                        {% else %}
                            {{ fonctionnementText|nl2br }}
                        {% endif %}
                    </div>
                </div>

                <div class="group-section" id="pourquoi-nous-rejoindre">
                    <h2>{{ 'group_show.html.section_rejoindre_title'|trans }}</h2>
                    {% set rejoindreText = (group and group.rejoindreText) ? group.rejoindreText : 'Pour vivre le match autrement, participer aux tifos et déplacements, et faire partie d’une famille rouge et noire.' %}
                    <div class="rich-content">
                        {% if group and group.rejoindreText %}
                            {{ rejoindreText|raw }}
                        {% else %}
                            {{ rejoindreText|nl2br }}
                        {% endif %}
                    </div>
                </div>

                <div class="group-section" id="se-carter">
                    <h2>{{ 'group_show.html.section_se_carter_title'|trans }}</h2>
                    {% set seCarterText = (group and group.seCarterText) ? group.seCarterText : 'Passe à la table de vente les jours de match, récupère ton code, puis inscris-toi pour accéder à l’espace membres.' %}
                    <div class="rich-content">
                        {% if group and group.seCarterText %}
                            {{ seCarterText|raw }}
                        {% else %}
                            {{ seCarterText|nl2br }}
                        {% endif %}
                    </div>
                </div>

                {% if group %}
                    <div class="group-content rich-content">
                        {{ group.description|raw }}
                    </div>
                {% else %}
                    <div class="group-content rich-content">
                        {{ 'home_index.html.aucune_information_de_groupe_na_encore_ete_ajoutee'|trans }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
