{% extends 'base.html.twig' %}

{% block title %}{{ 'ticket_buy.html.title'|trans({'%title%': item.title}) }}{% endblock %}

{% block body %}
    {% set ticketHeroImage = item.image and not item.image.video ? asset('uploads/media/' ~ item.image.path) : '/placeholder.jpg' %}
    <section class="ticket-show-hero" style="background-image: linear-gradient(90deg, rgba(0,0,0,0.9), rgba(0,0,0,0.58), rgba(0,0,0,0.86)), url('{{ ticketHeroImage }}');">
        <div class="ticket-show-hero-inner">
            <p class="ticket-show-kicker">{{ 'components_navbar.html.billetterie'|trans }}</p>
            <h1 class="ticket-show-title">{{ 'ticket_buy.html.reservation'|trans }}</h1>
            <div class="ticket-show-hero-meta">
                <span>{{ item.title }}</span>
                <span>{{ item.matchDate|date('d/m/Y H:i') }}</span>
                <span>{{ item.price|number_format(2, ',', ' ') }} €</span>
            </div>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 46rem;">
            <div class="card ticket-buy-card">
                <div class="ticket-buy-header">
                    <p class="ticket-buy-kicker">{{ 'components_navbar.html.billetterie'|trans }}</p>
                    <h2 class="ticket-buy-title">{{ 'ticket_buy.html.vs_opponent'|trans({'%opponent%': item.opponent}) }}</h2>
                </div>

                <div class="ticket-buy-meta">
                    <div>
                        <span class="ticket-buy-label">{{ 'email_merch_order_recap.html.date'|trans }}</span>
                        <div class="ticket-buy-value">{{ item.matchDate|date('d/m/Y H:i') }}</div>
                        {% if item.venue %}
                            <div class="ticket-buy-subvalue">{{ item.venue }}</div>
                        {% endif %}
                    </div>
                    <div>
                        <span class="ticket-buy-label">{{ 'merch_buy.html.prix_unitaire'|trans }}</span>
                        <div class="ticket-buy-value">{{ item.price|number_format(2, ',', ' ') }} &euro;</div>
                    </div>
                    <div>
                        <span class="ticket-buy-label">{{ 'ticket_buy.html.stock'|trans }}</span>
                        <div class="ticket-buy-value">{{ item.stock }}</div>
                    </div>
                </div>

                {{ form_start(form, { attr: { class: 'ticket-buy-form' } }) }}
                    {% if form.email is defined %}
                        {{ form_row(form.email) }}
                    {% endif %}
                    {{ form_row(form.quantity) }}
                    {{ form_row(form.note) }}

                    <button class="btn btn-danger w-100 mt-2" type="submit">{{ item.price <= 0 ? 'Reserver' : ('merch_buy.html.valider_et_recevoir_mon_recapitulatif'|trans) }}</button>
                {{ form_end(form) }}

                {% if item.price > 0 %}
                    <p class="ticket-buy-footnote">{{ 'ticket_buy.html.paiement_et_remise_selon_les_consignes_du_groupe'|trans }}</p>
                {% endif %}
            </div>

            <a href="{{ path('ticket_show', { id: item.id }) }}" class="btn btn-outline-light mt-4">{{ 'merch_buy.html.retour'|trans }}</a>
        </div>
    </div>
{% endblock %}
