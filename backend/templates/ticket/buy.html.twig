{% extends 'base.html.twig' %}

{% block title %}{{ 'ticket_buy.html.title'|trans({'%title%': item.title}) }}{% endblock %}

{% block body %}
    {% set isAway = item.matchLocation|default('')|lower|trim == 'exterieur'
        or (item.matchLocation is empty and item.category and item.category.slug == 'ext') %}
    {% set matchLabel = isAway
        ? item.opponent ~ ' vs FC Fleury'
        : 'FC Fleury vs ' ~ item.opponent %}
    {% set heroBackground = item.image ? asset('uploads/media/' ~ item.image.path) : asset('img/fond/fond1a.jpg') %}

    <section class="hero ticket-buy-hero" style="--ticket-buy-bg: url('{{ heroBackground }}')">
        <div class="hero-content ticket-buy-hero-content">
            <span class="merch-show-kicker">{{ 'components_navbar.html.billetterie'|trans }}</span>
            <h1 class="hero-title">{{ 'ticket_buy.html.reservation'|trans }}</h1>
            <p class="hero-subtitle">{{ matchLabel }}</p>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 64rem;">
            <div class="ticket-buy-card ticket-buy-page-shell">
                <div class="ticket-buy-header">
                    <p class="ticket-buy-kicker">{{ 'components_navbar.html.billetterie'|trans }}</p>
                    <h2 class="ticket-buy-title">{{ 'ticket_buy.html.vs_opponent'|trans({'%opponent%': item.opponent}) }}</h2>
                </div>

                <div class="ticket-buy-meta">
                    <div>
                        <span class="ticket-buy-label">{{ 'email_merch_order_recap.html.date'|trans }}</span>
                        <div class="ticket-buy-value">{{ item.matchDate|date('d/m/Y H:i') }}</div>
                        {% if item.venue %}
                            <div class="ticket-buy-subvalue">{{ item.venue }}</div>
                        {% endif %}
                    </div>
                    <div>
                        <span class="ticket-buy-label">{{ 'merch_buy.html.prix_unitaire'|trans }}</span>
                        <div class="ticket-buy-value">{{ item.price|number_format(2, ',', ' ') }} &euro;</div>
                    </div>
                    <div>
                        <span class="ticket-buy-label">{{ 'ticket_buy.html.stock'|trans }}</span>
                        <div class="ticket-buy-value">{{ item.stock }}</div>
                    </div>
                </div>

                {{ form_start(form, { attr: { class: 'ticket-buy-form ticket-buy-form--premium' } }) }}
                    {% if form.email is defined %}
                        {{ form_row(form.email) }}
                    {% endif %}
                    {{ form_row(form.quantity) }}
                    {{ form_row(form.note) }}

                    <button class="btn btn-danger w-100 mt-2" type="submit">{{ 'merch_buy.html.valider_et_recevoir_mon_recapitulatif'|trans }}</button>
                {{ form_end(form) }}

                <p class="ticket-buy-footnote">{{ 'ticket_buy.html.paiement_et_remise_selon_les_consignes_du_groupe'|trans }}</p>
            </div>

            <a href="{{ path('ticket_show', { id: item.id }) }}" class="btn btn-outline-light mt-4">{{ 'merch_buy.html.retour'|trans }}</a>
        </div>
    </div>
{% endblock %}
