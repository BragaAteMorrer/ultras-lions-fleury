{% extends 'base.html.twig' %}

{% block title %}Réservation - {{ item.title }}{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">Réservation</h1>
            <p class="hero-subtitle">{{ item.title }}</p>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 42rem;">
            <div class="card p-4 bg-dark text-light border-0 shadow">
                <p class="mb-1">
                    Match : <strong>vs {{ item.opponent }}</strong>
                </p>
                <p class="mb-1">
                    Date : <strong>{{ item.matchDate|date('d/m/Y H:i') }}</strong>{% if item.venue %} ({{ item.venue }}){% endif %}
                </p>
                <p class="mb-3">
                    Prix unitaire : <strong>{{ item.price|number_format(2, ',', ' ') }} €</strong> - Stock : <strong>{{ item.stock }}</strong>
                </p>

                {{ form_start(form) }}
                    {% if form.email is defined %}
                        {{ form_row(form.email) }}
                    {% endif %}
                    {{ form_row(form.quantity) }}
                    {{ form_row(form.note) }}

                    <button class="btn btn-danger w-100 mt-3" type="submit">Valider et recevoir mon récapitulatif</button>
                {{ form_end(form) }}

                <p class="mt-3 text-muted" style="font-size: 0.9rem;">
                    Paiement et remise selon les consignes du groupe.
                </p>
            </div>

            <a href="{{ path('ticket_show', { id: item.id }) }}" class="btn btn-outline-light mt-4">← Retour</a>
        </div>
    </div>
{% endblock %}

