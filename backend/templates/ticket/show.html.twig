{% extends 'base.html.twig' %}

{% block title %}{{ 'ticket_show.html.title'|trans({'%title%': item.title}) }}{% endblock %}

{% block body %}
    {% set isAway = item.matchLocation|default('')|lower|trim == 'exterieur'
        or (item.matchLocation is empty and item.category and item.category.slug == 'ext') %}
    {% set matchLabel = isAway
        ? item.opponent ~ ' vs FC Fleury'
        : 'FC Fleury vs ' ~ item.opponent %}
    {% set heroBackground = item.image ? asset('uploads/media/' ~ item.image.path) : asset('img/fond/fond1a.jpg') %}

    <section class="hero ticket-show-hero" style="--ticket-show-bg: url('{{ heroBackground }}')">
        <div class="ticket-show-hero-inner">
            <p class="ticket-show-kicker">{{ 'components_navbar.html.billetterie'|trans }}</p>
            <h1 class="ticket-show-title">{{ matchLabel }}</h1>
            <div class="ticket-show-hero-meta">
                <span>{{ item.matchDate|date('d/m/Y H:i') }}</span>
                {% if item.venue %}
                    <span>{{ item.venue }}</span>
                {% endif %}
                <span>{{ item.price|number_format(2, ',', ' ') }} €</span>
                {% if not item.usesBilletweb %}
                    <span>{{ 'ticket_show.html.stock'|trans({'%stock%': item.stock}) }}</span>
                {% endif %}
            </div>
        </div>
    </section>

    <div class="section ticket-show-section">
        <div class="container">
            <div class="ticket-show-summary">
                <div class="ticket-show-poster">
                    {% if item.image %}
                        <img src="{{ asset('uploads/media/' ~ item.image.path) }}" alt="{{ item.title }}">
                    {% else %}
                        <img src="/placeholder.jpg" alt="{{ item.title }}">
                    {% endif %}
                </div>

                <div class="ticket-show-panel">
                    {% if item.category %}
                        <p class="ticket-show-eyebrow">{{ item.category.name }}</p>
                    {% endif %}

                    <h2>{{ matchLabel }}</h2>

                    <div class="ticket-show-facts">
                        <div>
                            <span>{{ 'email_merch_order_recap.html.date'|trans }}</span>
                            <strong>{{ item.matchDate|date('d/m/Y H:i') }}</strong>
                        </div>
                        <div>
                            <span>{{ 'ticket_show.html.adversaire'|trans }}</span>
                            <strong>{{ item.opponent }}</strong>
                        </div>
                        <div>
                            <span>{{ 'ticket_show.html.prix'|trans }}</span>
                            <strong>{{ item.price|number_format(2, ',', ' ') }} €</strong>
                        </div>
                    </div>

                    {% if item.description %}
                        <div class="ticket-show-description">
                            {{ item.description|raw }}
                        </div>
                    {% endif %}

                    {% if item.usesBilletweb %}
                        <div class="ticket-billetweb-band">
                            <div class="ticket-billetweb-heading">
                                <p>{{ 'ticket_show.html.billetterie_billetweb_integree'|trans }}</p>
                                <h2>{{ 'ticket_show.html.billetterie_billetweb_title'|trans({'%match%': matchLabel}) }}</h2>
                            </div>
                            <div class="ticket-billetweb-shell">
                                <iframe
                                    src="{{ item.billetwebUrl }}"
                                    title="{{ 'ticket_show.html.billetterie_billetweb_title'|trans({'%match%': matchLabel}) }}"
                                    loading="lazy"
                                    referrerpolicy="strict-origin-when-cross-origin"
                                    allowfullscreen
                                ></iframe>
                            </div>
                            <a href="{{ item.billetwebUrl }}" class="btn btn-danger w-100" target="_blank" rel="noopener noreferrer">
                                {{ 'ticket_show.html.ouvrir_la_billetterie_billetweb'|trans }}
                            </a>
                        </div>
                    {% else %}
                        {% if item.stock > 0 %}
                            <form action="{{ path('ticket_cart_add', { id: item.id }) }}" method="post" class="ticket-show-inline-form">
                                <div>
                                    <label class="form-label" for="quantity">{{ 'ticket_show.html.quantite'|trans }}</label>
                                    <input id="quantity" name="quantity" type="number" min="1" value="1" class="form-control">
                                </div>
                                <button class="btn btn-danger w-100" type="submit">{{ 'merch_show.html.ajouter_au_panier'|trans }}</button>
                            </form>
                            <a href="{{ path('ticket_cart') }}" class="btn btn-outline-light w-100 mt-3">{{ 'merch_show.html.voir_mon_panier'|trans }}</a>
                        {% else %}
                            <button class="btn btn-secondary w-100" disabled>{{ 'ticket_show.html.complet'|trans }}</button>
                        {% endif %}
                    {% endif %}

                    <div class="ticket-show-actions">
                        <a href="{{ path('ticket_index') }}" class="btn btn-outline-light">{{ 'merch_buy.html.retour'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
