{% extends 'base.html.twig' %}

{% block title %}{{ item.title }} - Billetterie{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">Billetterie</h1>
            <p class="hero-subtitle">{{ item.title }}</p>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 62rem;">
            <div class="row g-4 align-items-start">
                <div class="col-md-5">
                    <div class="card bg-dark text-light border-0 shadow">
                        {% if item.image %}
                            <img src="{{ asset('uploads/media/' ~ item.image.path) }}" class="event-card-img-top" alt="{{ item.title }}">
                        {% else %}
                            <img src="/placeholder.jpg" class="event-card-img-top" alt="{{ item.title }}">
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="card p-4 bg-dark text-light border-0 shadow">
                        {% if item.category %}
                            <p class="text-muted mb-2">{{ item.category.name }}</p>
                        {% endif %}
                        <h2 class="mb-2">{{ item.title }}</h2>
                        <p class="mb-1"><strong>Date :</strong> {{ item.matchDate|date('d/m/Y H:i') }}</p>
                        <p class="mb-1"><strong>Adversaire :</strong> {{ item.opponent }}</p>
                        {% if item.venue %}
                            <p class="mb-1"><strong>Lieu :</strong> {{ item.venue }}</p>
                        {% endif %}
                        <p class="mb-2"><strong>Prix :</strong> {{ item.price|number_format(2, ',', ' ') }} €</p>
                        <p class="text-muted mb-3">Stock : {{ item.stock }}</p>

                        {% if item.description %}
                            <div class="mb-3">{{ item.description|raw }}</div>
                        {% endif %}

                        {% if item.stock > 0 %}
                            <a class="btn btn-danger w-100" href="{{ path('ticket_buy', { id: item.id }) }}">Réserver</a>
                        {% else %}
                            <button class="btn btn-secondary w-100" disabled>Complet</button>
                        {% endif %}
                    </div>

                    <a href="{{ path('ticket_index') }}" class="btn btn-outline-light mt-4">← Retour</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

