{% extends 'base.html.twig' %}

{% block title %}Panier - Billetterie{% endblock %}

{% block body %}
    <section class="ticket-show-hero" style="background-image: linear-gradient(90deg, rgba(0,0,0,0.9), rgba(0,0,0,0.58), rgba(0,0,0,0.86)), url('{{ asset('img/fond/fond1a.jpg') }}');">
        <div class="ticket-show-hero-inner">
            <p class="ticket-show-kicker">{{ 'components_navbar.html.billetterie'|trans }}</p>
            <h1 class="ticket-show-title">Panier</h1>
            <div class="ticket-show-hero-meta">
                <span>{{ items|length }} article{% if items|length > 1 %}s{% endif %}</span>
                <span>{{ total|number_format(2, ',', ' ') }} EUR</span>
            </div>
        </div>
    </section>

    <div class="section ticket-show-section">
        <div class="container" style="max-width: 62rem;">
            <div class="ticket-show-panel">
                {% if items is empty %}
                    <p class="text-muted">Ton panier est vide.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Match</th>
                                    <th>Date</th>
                                    <th>Quantite</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in items %}
                                    <tr>
                                        <td>{{ row.ticket.opponent }}</td>
                                        <td>{{ row.ticket.matchDate|date('d/m/Y H:i') }}</td>
                                        <td>{{ row.quantity }}</td>
                                        <td>{{ row.lineTotal|number_format(2, ',', ' ') }} EUR</td>
                                        <td>
                                            <form action="{{ path('ticket_cart_remove', { key: row.key }) }}" method="post">
                                                <button class="btn btn-outline-light btn-sm" type="submit">Supprimer</button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <strong>Total</strong>
                        <strong>{{ total|number_format(2, ',', ' ') }} EUR</strong>
                    </div>

                    <form action="{{ path('ticket_cart_checkout') }}" method="post" class="mt-4">
                        {% if app.user is null %}
                            <label class="form-label text-light" for="email">Email</label>
                            <input id="email" name="email" type="email" required value="{{ email }}" class="form-control mb-3">
                        {% endif %}
                        <button class="btn btn-danger w-100" type="submit">Payer avec SumUp</button>
                    </form>

                    <form action="{{ path('ticket_cart_clear') }}" method="post" class="mt-3">
                        <button class="btn btn-outline-light w-100" type="submit">Vider le panier</button>
                    </form>
                {% endif %}
            </div>

            <a href="{{ path('ticket_index') }}" class="btn btn-outline-light mt-4">Retour billetterie</a>
        </div>
    </div>
{% endblock %}

{% block javascripts %}{% endblock %}
