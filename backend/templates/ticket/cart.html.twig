{% extends 'base.html.twig' %}

{% block title %}{{ 'cart_index.html.panier'|trans }} - {{ 'components_navbar.html.billetterie'|trans }}{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">{{ 'cart_index.html.panier'|trans }}</h1>
            <p class="hero-subtitle">{{ 'components_navbar.html.billetterie'|trans }}</p>
        </div>
    </section>

    <div class="section">
        <div class="container" style="max-width: 62rem;">
            <div class="card p-4 bg-dark text-light border-0 shadow">
                {% if items is empty %}
                    <p class="text-muted">{{ 'cart_index.html.panier_vide'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>{{ 'cart_index.html.match'|trans }}</th>
                                    <th>{{ 'cart_index.html.date'|trans }}</th>
                                    <th>{{ 'cart_index.html.quantite'|trans }}</th>
                                    <th>{{ 'cart_index.html.total'|trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in items %}
                                    <tr>
                                        <td>{{ row.ticket.opponent }}</td>
                                        <td>{{ row.ticket.matchDate|date('d/m/Y H:i') }}</td>
                                        <td>{{ row.quantity }}</td>
                                        <td>{{ row.lineTotal|number_format(2, ',', ' ') }} EUR</td>
                                        <td>
                                            <form action="{{ path('ticket_cart_remove', { key: row.key }) }}" method="post">
                                                <button class="btn btn-outline-light btn-sm" type="submit">{{ 'cart_index.html.supprimer'|trans }}</button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <strong>{{ 'cart_index.html.total'|trans }}</strong>
                        <strong>{{ total|number_format(2, ',', ' ') }} EUR</strong>
                    </div>

                    <form action="{{ path('ticket_cart_checkout') }}" method="post" class="mt-4">
                        {% if app.user is null %}
                            <label class="form-label text-light" for="email">{{ 'security_login.html.email'|trans }}</label>
                            <input id="email" name="email" type="email" required value="{{ email }}" class="form-control mb-3">
                        {% endif %}
                        <button class="btn btn-danger w-100" type="submit">{{ 'cart_index.html.payer_avec_sumup'|trans }}</button>
                    </form>

                    <form action="{{ path('ticket_cart_clear') }}" method="post" class="mt-3">
                        <button class="btn btn-outline-light w-100" type="submit">{{ 'cart_index.html.vider_le_panier'|trans }}</button>
                    </form>
                {% endif %}
            </div>

            <a href="{{ path('ticket_index') }}" class="btn btn-outline-light mt-4">{{ 'cart_index.html.retour_billetterie'|trans }}</a>
        </div>
    </div>
{% endblock %}

{% block javascripts %}{% endblock %}
