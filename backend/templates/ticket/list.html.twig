{% extends 'base.html.twig' %}

{% block title %}{{ 'ticket_list.html.billetterie_ultras_lions'|trans }}{% endblock %}

{% block body %}
    <section class="ticket-show-hero" style="background-image: linear-gradient(90deg, rgba(0,0,0,0.9), rgba(0,0,0,0.58), rgba(0,0,0,0.86)), url('{{ asset('img/fond/fond1a.jpg') }}');">
        <div class="ticket-show-hero-inner">
            <p class="ticket-show-kicker">{{ 'ticket_list.html.matchs_a_domicile_et_a_lexterieur'|trans }}</p>
            <h1 class="ticket-show-title">{{ 'components_navbar.html.billetterie'|trans }}</h1>
            <div class="ticket-show-hero-meta">
                <span>{{ items|length }} match{% if items|length > 1 %}s{% endif %}</span>
            </div>
        </div>
    </section>

    <div class="section">
        <div class="container">
            <form method="get" class="mb-4" style="max-width: 24rem;">
                <label class="form-label text-light" for="category">{{ 'merch_list.html.categorie'|trans }}</label>
                <div class="d-flex gap-2">
                    <select id="category" name="category" class="form-select">
                        <option value="" {% if selectedCategory is null %}selected{% endif %}>{{ 'merch_list.html.toutes'|trans }}</option>
                        {% for cat in categories %}
                            <option value="{{ cat.slug }}" {% if selectedCategory and selectedCategory.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                    <button class="btn btn-outline-light" type="submit">{{ 'merch_list.html.trier'|trans }}</button>
                </div>
            </form>

            <h2 class="section-title">{{ 'ticket_list.html.matchs_disponibles'|trans }}</h2>

            <div class="row g-4">
                {% for ticket in items %}
                    {% set isAway = ticket.matchLocation|default('')|lower|trim == 'exterieur'
                        or (ticket.matchLocation is empty and ticket.category and ticket.category.slug == 'ext') %}
                    {% set matchLabel = isAway
                        ? ticket.opponent ~ ' vs FC Fleury'
                        : 'FC Fleury vs ' ~ ticket.opponent %}
                    <div class="col-md-4">
                        <a href="{{ path('ticket_show', { id: ticket.id }) }}" class="card h-100">

                            {% if ticket.image %}
                                {% include 'components/media.html.twig' with { media: ticket.image, class: 'event-card-img-top', alt: ticket.title } %}
                            {% else %}
                                <img src="/placeholder.jpg" class="event-card-img-top" alt="{{ ticket.title }}">
                            {% endif %}

                            <div class="card-body">
                                <h3 class="card-title">{{ matchLabel }}</h3>
                                {% if ticket.category %}
                                    <p class="text-muted mb-1">{{ ticket.category.name }}</p>
                                {% endif %}
                                <p class="mb-1">{{ ticket.matchDate|date('d/m/Y H:i') }}{% if ticket.venue %} - {{ ticket.venue }}{% endif %}</p>
                                <p class="card-price">{{ ticket.price|number_format(2, ',', ' ') }} €</p>
                                {% if ticket.usesBilletweb %}
                                    <p class="text-muted mb-0">Billetterie Billetweb integree</p>
                                {% else %}
                                    <p class="text-muted mb-0">{{ 'ticket_list.html.stock'|trans({'%stock%': ticket.stock}) }}</p>
                                {% endif %}
                            </div>

                        </a>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-secondary">{{ 'ticket_list.html.aucun_match_pour_le_moment'|trans }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
