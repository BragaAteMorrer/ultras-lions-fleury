{% extends 'base.html.twig' %}

{% block title %}Billetterie - Ultras Lions{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">Billetterie</h1>
            <p class="hero-subtitle">Matchs à domicile et à l'extérieur</p>
        </div>
    </section>

    <div class="section">
        <div class="container">
            <form method="get" class="mb-4" style="max-width: 24rem;">
                <label class="form-label text-light" for="category">Catégorie</label>
                <div class="d-flex gap-2">
                    <select id="category" name="category" class="form-select">
                        <option value="" {% if selectedCategory is null %}selected{% endif %}>Toutes</option>
                        {% for cat in categories %}
                            <option value="{{ cat.slug }}" {% if selectedCategory and selectedCategory.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                    <button class="btn btn-outline-light" type="submit">Trier</button>
                </div>
            </form>

            <h2 class="section-title">Matchs disponibles</h2>

            <div class="row g-4">
                {% for ticket in items %}
                    <div class="col-md-4">
                        <a href="{{ path('ticket_show', { id: ticket.id }) }}" class="card h-100">

                            {% if ticket.image %}
                                <img src="{{ asset('uploads/media/' ~ ticket.image.path) }}" class="event-card-img-top" alt="{{ ticket.title }}">
                            {% else %}
                                <img src="/placeholder.jpg" class="event-card-img-top" alt="{{ ticket.title }}">
                            {% endif %}

                            <div class="card-body">
                                <h3 class="card-title">{{ ticket.title }}</h3>
                                {% if ticket.category %}
                                    <p class="text-muted mb-1">{{ ticket.category.name }}</p>
                                {% endif %}
                                <p class="mb-1">{{ ticket.matchDate|date('d/m/Y H:i') }}{% if ticket.venue %} - {{ ticket.venue }}{% endif %}</p>
                                <p class="text-muted mb-1">vs {{ ticket.opponent }}</p>
                                <p class="card-price">{{ ticket.price|number_format(2, ',', ' ') }} €</p>
                                <p class="text-muted mb-0">Stock : {{ ticket.stock }}</p>
                            </div>

                        </a>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-secondary">Aucun match pour le moment.</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

